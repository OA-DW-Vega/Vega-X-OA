<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivScaleClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:contentDescription="@string/material"
            android:elevation="1dp"
            android:src="@drawable/ic_coffee_cicle_close"
            android:translationZ="2dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_medium">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_add_weight"
                    android:layout_width="80dp"
                    android:layout_height="0dp"
                    android:layout_marginEnd="2dp"
                    android:background="@color/grey_light"
                    android:fontFamily="@font/gilroy_semibold"
                    android:gravity="center"
                    android:paddingStart="@dimen/margin_small"
                    android:paddingEnd="@dimen/margin_small"
                    android:text="@string/add_weight"
                    android:textColor="@color/text_black"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvLotLbl"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:layout_marginTop="@dimen/margin_small"
                    android:layout_marginEnd="@dimen/margin_small"
                    android:fontFamily="@font/gilroy_regular"
                    android:text="@string/lot_no"
                    android:textColor="@color/text_black"
                    app:layout_constraintEnd_toStartOf="@id/tvWeight"
                    app:layout_constraintHorizontal_weight=".7"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvScaleLotValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:fontFamily="@font/gilroy_regular"
                    android:gravity="start"
                    android:textColor="@color/text_black"
                    android:textStyle="bold"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvLotLbl"
                    tools:text="18GBRD140" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvWeight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_mic_small"
                    android:layout_marginTop="@dimen/margin_small"
                    android:fontFamily="@font/gilroy_regular"
                    android:paddingStart="@dimen/margin_medium"
                    android:text="@string/weight"
                    android:textColor="@color/text_black"
                    app:layout_constraintEnd_toStartOf="@+id/tvStLocation"
                    app:layout_constraintHorizontal_weight=".5"
                    app:layout_constraintStart_toEndOf="@+id/tvScaleLotValue"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvScaleWeightValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gilroy_semibold"
                    android:paddingStart="@dimen/margin_medium"
                    android:textColor="@color/text_black"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@id/tvWeight"
                    app:layout_constraintEnd_toEndOf="@+id/tvWeight"
                    app:layout_constraintTop_toBottomOf="@id/tvWeight"
                    tools:text="2400 MT" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvStLocation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:layout_marginEnd="@dimen/margin_small"
                    android:fontFamily="@font/gilroy_regular"
                    android:text="@string/st_location"
                    android:textColor="@color/text_black"
                    app:layout_constraintEnd_toStartOf="@+id/tv_add_weight"
                    app:layout_constraintHorizontal_weight=".5"
                    app:layout_constraintTop_toTopOf="parent" />


                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvStLocationValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/margin_small"
                    android:layout_marginBottom="@dimen/margin_medium"
                    android:fontFamily="@font/gilroy_semibold"
                    android:textColor="@color/text_black"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/tv_add_weight"
                    app:layout_constraintStart_toStartOf="@id/tvStLocation"
                    app:layout_constraintTop_toBottomOf="@id/tvStLocation"
                    tools:text="Sample Location" />

                <LinearLayout
                    android:id="@+id/ll_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="20dp"
                    android:paddingBottom="10dp"
                    app:layout_constraintEnd_toStartOf="@id/tv_add_weight"
                    app:layout_constraintStart_toStartOf="@id/tvScaleLotValue"
                    app:layout_constraintTop_toBottomOf="@id/tvScaleWeightValue">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvGrade"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/material"
                            android:textColor="@color/text_black" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvScaleGradeValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/margin_small"
                            android:fontFamily="@font/gilroy_semibold"
                            android:textColor="@color/text_black"
                            android:textStyle="bold"
                            tools:text="MANBO/S_1 gfdgf hgcghcchgc" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvWeightDispatch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/margin_small"
                            android:text="@string/wt_to_dispatch"
                            android:textColor="@color/text_black" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvScaleDispatchValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/margin_small"
                            android:layout_marginBottom="@dimen/margin_small"
                            android:fontFamily="@font/gilroy_semibold"
                            android:textColor="@color/text_black"
                            android:textStyle="bold"
                            tools:text="1000 MT" />
                    </LinearLayout>

                </LinearLayout>


                <!--                <androidx.appcompat.widget.AppCompatTextView-->
                <!--                    android:id="@+id/tvWeightLoss"-->
                <!--                    android:layout_width="0dp"-->
                <!--                    android:layout_height="wrap_content"-->
                <!--                    android:layout_marginEnd="@dimen/margin_small"-->
                <!--                    android:fontFamily="@font/gilroy_semibold"-->
                <!--                    android:textColor="@color/text_black"-->
                <!--                    android:textStyle="bold"-->
                <!--                    android:visibility="visible"-->
                <!--                    app:layout_constraintBottom_toBottomOf="parent"-->
                <!--                    app:layout_constraintEnd_toStartOf="@id/tv_add_weight"-->
                <!--                    tools:text="1000 MT" />-->

                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/cbEndLot"
                    android:layout_width="20dp"
                    android:layout_height="17dp"
                    android:layout_marginTop="@dimen/margin_small"
                    android:layout_marginBottom="@dimen/margin_small"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@id/ll_card"
                    app:layout_constraintTop_toBottomOf="@id/ll_card" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvEndLot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_small"
                    android:text="@string/end_pile_lot"
                    app:layout_constraintBottom_toBottomOf="@id/cbEndLot"
                    app:layout_constraintStart_toEndOf="@id/cbEndLot"
                    app:layout_constraintTop_toTopOf="@id/cbEndLot" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
