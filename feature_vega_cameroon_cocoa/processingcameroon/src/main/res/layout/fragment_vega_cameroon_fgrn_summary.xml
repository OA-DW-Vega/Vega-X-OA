<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_white"
    android:clickable="true">

    <TextView
        android:id="@+id/tvHeadPoDetail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryHeadOfi"
        android:fontFamily="@font/gt_walsheim_pro_regular"
        android:gravity="center_vertical"
        android:padding="@dimen/margin_small"
        android:paddingStart="@dimen/margin_large"
        android:paddingEnd="@dimen/margin_large"
        android:text="@string/fgrn_summary"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvLotNoLbl"
        android:layout_width="0dp"
        android:layout_height="@dimen/action_bar_height"
        android:layout_gravity="center"
        android:background="@color/orange_light"
        android:gravity="center|start"
        android:paddingStart="@dimen/margin_medium"
        android:text="@string/pono"
        android:textColor="@color/warm_white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvHeadPoDetail" />

    <TextView
        android:id="@+id/tvLotNo"
        android:layout_width="0dp"
        android:layout_height="@dimen/action_bar_height"
        android:layout_gravity="center"
        android:background="@color/orange_light"
        android:gravity="center|start"
        android:paddingStart="@dimen/margin_medium"
        android:textColor="@color/warm_white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvLotNoLbl"
        app:layout_constraintTop_toBottomOf="@+id/tvHeadPoDetail"
        tools:text="lots12345" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvSummaryLbl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_large"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/gt_walsheim_pro_bold"
        android:text="@string/processing_summary"
        android:textColor="@color/dark_marun"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvLotNoLbl" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/tvConfirm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSummaryLbl">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/margin_xlarge">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFgrnSummary"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="visible"
                app:layout_constraintBottom_toTopOf="@+id/tvShift"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:listitem="@layout/item_vega_cameroon_fgrn_summary" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvShift"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_xlarge"
                android:layout_marginBottom="@dimen/margin_xlarge"
                android:background="@color/light_grey"
                android:paddingStart="@dimen/margin_xlarge"
                android:paddingTop="@dimen/margin_medium"
                android:paddingEnd="@dimen/margin_xlarge"
                android:paddingBottom="@dimen/margin_medium"
                android:textColor="@color/black"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rvFgrnSummary"
                tools:text="Shift A" />

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_gravity="end"
                android:layout_marginEnd="@dimen/margin_large"
                android:background="@drawable/ic_edit"
                android:backgroundTint="@color/grey_button"
                android:contentDescription="@string/sync"
                android:elevation="5dp"
                android:gravity="end"
                android:padding="@dimen/margin_medium"
                android:paddingEnd="@dimen/margin_medium"
                app:layout_constraintBottom_toBottomOf="@+id/tvShift"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvShift" />

            <TextView
                android:id="@+id/tvOperator"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginTop="@dimen/margin_large"
                android:gravity="start"
                android:text="@string/remarks"
                android:textColor="@color/grey_border"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@+id/tvShift"
                app:layout_constraintTop_toBottomOf="@+id/tvShift" />

            <TextView
                android:id="@+id/tvOperatorName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_large"
                android:layout_marginEnd="@dimen/margin_medium"
                android:gravity="end"
                android:textColor="@color/black"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/tvShift"
                app:layout_constraintTop_toBottomOf="@+id/tvShift"
                tools:text="@string/operator_name" />

            <TextView
                android:id="@+id/tvBagConsumption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_xlarge"
                android:gravity="start"
                android:text="@string/bag_consumption"
                android:textColor="@color/black"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@+id/tvOperator"
                app:layout_constraintTop_toBottomOf="@+id/tvOperator" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBagConsumption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                app:layout_constraintStart_toStartOf="@+id/tvBagConsumption"
                app:layout_constraintTop_toBottomOf="@+id/tvBagConsumption"
                tools:listitem="@layout/item_vega_cameroon_bag_consump_summary" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvConfirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryOfi"
        android:gravity="center"
        android:padding="@dimen/margin_medium"
        android:text="@string/confirm"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>