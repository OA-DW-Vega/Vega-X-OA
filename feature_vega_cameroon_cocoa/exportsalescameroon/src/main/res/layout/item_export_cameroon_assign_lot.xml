<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/margin_very_small"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Container No"
            android:fontFamily="@font/roboto_bold"
            android:textColor="@color/text_black"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/roboto_bold"
            android:textColor="@color/text_black"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            android:text="Material"/>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >

        <TextView
            android:id="@+id/tvContainerValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Container No"
            android:textColor="@color/text_black" />
        <TextView
            android:id="@+id/tvMaterialValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_black"
            android:text="Material"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_bold"
            android:textColor="@color/red"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            android:paddingRight="@dimen/margin_mic_small"
            android:text="*"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etLotId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_large"
            android:background="@drawable/custom_edit_text"
            android:fontFamily="@font/gilroy_semibold"
            android:gravity="start|center"
            android:hint="Enter LOT number"
            android:inputType="textCapCharacters"
            android:textAllCaps="true"
            android:maxLength="10"
            android:padding="@dimen/margin_medium"
            android:paddingStart="20dp"
            android:paddingEnd="@dimen/margin_min"
            android:textColor="@color/text_black"
            android:textSize="16sp"/>

    </LinearLayout>

</LinearLayout>
