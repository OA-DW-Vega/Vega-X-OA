<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <FrameLayout
        android:id="@+id/flSalesLot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivScaleClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:contentDescription="@string/material"
            android:elevation="1dp"
            android:src="@drawable/ic_close_cameroon_circle"
            android:translationZ="2dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_medium">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_add_weight"
                    android:layout_width="80dp"
                    android:layout_height="0dp"
                    android:layout_marginEnd="2dp"
                    android:background="@color/grey_light"
                    android:fontFamily="@font/gt_walsheim_pro_bold"
                    android:gravity="center"
                    android:paddingStart="@dimen/margin_small"
                    android:paddingEnd="@dimen/margin_small"
                    android:text="@string/add_weight"
                    android:textColor="@color/black"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvLotLbl"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_very_small"
                    android:layout_marginTop="@dimen/margin_small"
                    android:layout_marginEnd="@dimen/margin_very_small"
                    android:fontFamily="@font/gt_walsheim_pro_regular"
                    android:text="@string/lot_no"
                    android:textColor="@color/grey_dark"
                    app:layout_constraintEnd_toStartOf="@id/tvWeight"
                    app:layout_constraintHorizontal_weight=".7"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvScaleLotValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_very_small"
                    android:fontFamily="@font/gt_walsheim_pro_regular"
                    android:gravity="start"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvLotLbl"
                    tools:text="18GBRD140" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvWeight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_mic_small"
                    android:layout_marginTop="@dimen/margin_small"
                    android:fontFamily="@font/gt_walsheim_pro_regular"
                    android:paddingStart="@dimen/margin_medium"
                    android:text="@string/weight"
                    android:textColor="@color/grey_dark"
                    app:layout_constraintEnd_toStartOf="@+id/tvStLocation"
                    app:layout_constraintHorizontal_weight=".5"
                    app:layout_constraintStart_toEndOf="@+id/tvScaleLotValue"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvScaleWeightValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gt_walsheim_pro_bold"
                    android:paddingStart="@dimen/margin_very_small"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@id/tvWeight"
                    app:layout_constraintTop_toBottomOf="@id/tvWeight"
                    tools:text="2400 MT" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvStLocation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:layout_marginEnd="@dimen/margin_very_small"
                    android:fontFamily="@font/gt_walsheim_pro_regular"
                    android:text="@string/st_location"
                    android:textColor="@color/grey_dark"
                    app:layout_constraintEnd_toStartOf="@+id/tv_add_weight"
                    app:layout_constraintHorizontal_weight=".5"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvStLocationValue"
                    android:layout_width="0dp"
                    android:layout_marginEnd="@dimen/margin_very_small"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_marginBottom="@dimen/margin_medium"
                    android:fontFamily="@font/gt_walsheim_pro_bold"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/tv_add_weight"
                    app:layout_constraintStart_toStartOf="@id/tvStLocation"
                    app:layout_constraintTop_toBottomOf="@id/tvStLocation"
                    tools:text="Sample Location" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvWeightDispatch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/margin_small"
                    android:text="@string/wt_to_weight"
                    android:textColor="@color/grey_dark"
                    app:layout_constraintEnd_toStartOf="@id/tv_add_weight"
                    app:layout_constraintHorizontal_weight="1.5"
                    app:layout_constraintTop_toBottomOf="@id/tvStLocationValue" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvMaterial"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/material"
                    android:textColor="@color/grey_dark"
                    app:layout_constraintBottom_toBottomOf="@id/tvWeightDispatch"
                    app:layout_constraintHorizontal_weight="2"
                    app:layout_constraintStart_toStartOf="@id/tvScaleLotValue"
                    app:layout_constraintTop_toTopOf="@id/tvWeightDispatch" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvScaleDispatchValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/margin_small"
                    android:layout_marginBottom="@dimen/margin_small"
                    android:fontFamily="@font/gt_walsheim_pro_bold"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/tv_add_weight"
                    app:layout_constraintStart_toStartOf="@id/tvWeightDispatch"
                    app:layout_constraintTop_toBottomOf="@id/tvWeightDispatch"
                    tools:text="1000 MT" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvScaleGradeValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/margin_small"
                    android:layout_marginBottom="@dimen/margin_small"
                    android:fontFamily="@font/gt_walsheim_pro_bold"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/tvScaleDispatchValue"
                    app:layout_constraintStart_toStartOf="@id/tvScaleLotValue"
                    app:layout_constraintTop_toBottomOf="@id/tvMaterial"
                    tools:text="MANBO/S_1 gfdgf hgcghcchgc" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clEndLot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_small"
                    android:paddingBottom="@dimen/margin_small"
                    app:layout_constraintTop_toBottomOf="@+id/tvScaleGradeValue">

                    <CheckBox
                        android:id="@+id/cbScaleStorageLoss"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:clickable="false"
                        app:layout_constraintEnd_toStartOf="@+id/tvScaleStorageLoss"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvScaleStorageLoss"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/roboto_bold"
                        android:text="@string/end_lot"
                        android:textColor="@color/black"
                        app:layout_constraintBottom_toBottomOf="@+id/cbScaleStorageLoss"
                        app:layout_constraintStart_toEndOf="@+id/cbScaleStorageLoss"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/flAnticipatedSales"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/flSalesLot">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="end"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="20dp"
            android:contentDescription="@string/material"
            android:elevation="1dp"
            android:src="@drawable/ic_close_cameroon_circle"
            android:translationZ="2dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/cbSelectStocks"
                android:orientation="vertical"
                android:padding="@dimen/margin_small">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.3"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lot_no"
                            android:textColor="@color/grey"
                            android:textSize="@dimen/text_size_small" />

                        <TextView
                            android:id="@+id/tvLotId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto_bold"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_size_xmedium"
                            android:textStyle="bold"
                            tools:text="19393024892" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.3"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/st_location"
                            android:textColor="@color/grey"
                            android:textSize="@dimen/text_size_small" />

                        <TextView
                            android:id="@+id/tvStLocationValue1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_size_small"
                            android:textStyle="bold"
                            tools:text="@string/st_location" />
                    </LinearLayout>

                    <!-- <androidx.appcompat.widget.AppCompatImageView
                         android:id="@+id/ivClose"
                         android:layout_width="32dp"
                         android:layout_height="32dp"
                         android:contentDescription="@string/material"
                         android:src="@drawable/ic_close_cocoa_circle" />-->
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_padding_size_small"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvAntiMaterial"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:fontFamily="@font/roboto_medium"
                        android:text="@string/material"
                        android:textColor="@color/grey"
                        android:textSize="@dimen/text_size_small" />


                    <TextView
                        android:id="@+id/tvEditWeight"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:fontFamily="@font/roboto_medium"
                        android:text="@string/weight"
                        android:textColor="@color/grey"
                        android:textSize="@dimen/text_size_small" />


                    <TextView
                        android:id="@+id/tvwtp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:fontFamily="@font/roboto_medium"
                        android:text="@string/wt_to_weight"
                        android:textColor="@color/grey"
                        android:textSize="@dimen/text_size_small" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="0.2"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="@color/black" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_mic_small"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvGradeValue"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.5"
                        android:fontFamily="@font/roboto_bold"
                        android:gravity="start|center"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="LBA fsd svsdv sdvfsdfsds svsfsd" />


                    <TextView
                        android:id="@+id/tvWeightValue"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.5"
                        android:fontFamily="@font/roboto_bold"
                        android:gravity="center|start"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="100 kg" />

                    <EditText
                        android:id="@+id/etWeight"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="0.5"
                        android:background="@drawable/custom_edit_text"
                        android:fontFamily="@font/roboto_bold"
                        android:inputType="numberDecimal"
                        android:paddingStart="@dimen/margin_small"
                        android:paddingEnd="@dimen/margin_small"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_size_small"
                        android:textStyle="bold"
                        tools:text="10/10/2020" />

                    <TextView
                        android:id="@+id/tvUnit"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="0.2"
                        android:gravity="center"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="@color/white" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:layout_marginBottom="@dimen/margin_mic_small"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/llSelectAll"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <CheckBox
                            android:id="@+id/cbSelectAll"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:clickable="false" />

                        <TextView
                            android:id="@+id/tvSelectAll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="@font/roboto_bold"
                            android:text="@string/select_entire_lot"
                            android:textColor="@color/black" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llEndLot"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <CheckBox
                            android:id="@+id/cbStorageLoss"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:clickable="false" />

                        <TextView
                            android:id="@+id/tvStorageLoss"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="@font/roboto_bold"
                            android:text="@string/end_lot"
                            android:textColor="@color/black" />
                    </LinearLayout>

                </LinearLayout>


            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
