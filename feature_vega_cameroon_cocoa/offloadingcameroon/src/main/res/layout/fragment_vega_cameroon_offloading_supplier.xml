    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryHeadOfi"
        android:fontFamily="@font/gilroy_regular"
        android:padding="@dimen/margin_small"
        android:text="@string/offloading_supplier"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/flSavedBatchId"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/border_light_grey"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title">

        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/spSavedBatchId"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:layout_margin="@dimen/margin_very_small"
            android:background="@drawable/border_light_grey"
            android:dropDownWidth="match_parent"
            android:dropDownHeight="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="60dp"
            android:overlapAnchor="false"
            android:padding="@dimen/margin_mic_small"
            android:popupBackground="@color/white"
            android:spinnerMode="dropdown" />

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="20dp"
            android:contentDescription="@null"
            android:padding="5dp"
            android:src="@drawable/ic_cameroon_down_arrow" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvTruckIDNo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/orange"
        android:fontFamily="@font/gilroy_regular"
        android:paddingStart="@dimen/margin_large"
        android:paddingTop="@dimen/margin_small"
