        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/vProceed" />

    <View
        android:id="@+id/vProceed"
        android:layout_width="2dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/btProceed"
        app:layout_constraintEnd_toStartOf="@+id/btProceed"
        app:layout_constraintStart_toEndOf="@+id/btSave"
        app:layout_constraintTop_toTopOf="@+id/btProceed" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btSave"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:background="@color/light_grey"
        android:enabled="false"
        android:fontFamily="@font/gilroy_semibold"
        android:gravity="center"
        android:text="@string/save"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_smedium"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/vProceed"
        app:layout_constraintStart_toStartOf="parent" />

