<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:elevation="@dimen/margin_small">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_small">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvDest"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:fontFamily="@font/gilroy_regular"
            android:gravity="start|center"
            android:paddingStart="@dimen/margin_small"
            android:paddingEnd="4dp"
            android:text="@string/destination_wh"
            android:textColor="@color/text_black"
            app:layout_constraintEnd_toStartOf="@+id/tvStoNumber"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvStoNumber"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:fontFamily="@font/gilroy_regular"
            android:gravity="start|center"
            android:paddingStart="@dimen/margin_small"
            android:paddingEnd="4dp"
            android:text="@string/sto_number"
            android:textColor="@color/text_black"
            app:layout_constraintBottom_toBottomOf="@id/tvDest"
            app:layout_constraintEnd_toStartOf="@+id/tvDate"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/tvDest"
            app:layout_constraintTop_toTopOf="@id/tvDest" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvDate"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:fontFamily="@font/gilroy_regular"
            android:gravity="start|center"
            android:paddingStart="@dimen/margin_small"
            android:paddingEnd="4dp"
            android:text="@string/date"
            android:textColor="@color/text_black"
            app:layout_constraintBottom_toBottomOf="@id/tvDest"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/tvStoNumber"
            app:layout_constraintTop_toTopOf="@id/tvDest" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvDestValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gilroy_semibold"
            android:gravity="start|center"
            android:paddingStart="@dimen/margin_small"
            android:paddingEnd="4dp"
            android:textColor="@color/text_black"
            app:layout_constraintEnd_toStartOf="@+id/tvStoNumberValue"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDest"
            tools:text="WH4171" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvStoNumberValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gilroy_semibold"
            android:gravity="start|center"
            android:paddingStart="@dimen/margin_small"
            android:paddingEnd="4dp"
            android:textColor="@color/text_black"
            app:layout_constraintBottom_toBottomOf="@id/tvDestValue"
            app:layout_constraintEnd_toStartOf="@+id/tvDateValue"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/tvDestValue"
            app:layout_constraintTop_toTopOf="@id/tvDestValue"
            tools:text="SO00121232" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvDateValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gilroy_semibold"
            android:gravity="start|center"
            android:paddingStart="@dimen/margin_small"
            android:paddingEnd="4dp"
            android:textColor="@color/text_black"
            app:layout_constraintBottom_toBottomOf="@id/tvDestValue"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/tvStoNumberValue"
            app:layout_constraintTop_toTopOf="@id/tvDestValue"
            tools:text="12/09/2002" />


        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvDriverName"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:fontFamily="@font/gilroy_regular"
            android:gravity="start|center"
            android:paddingStart="@dimen/margin_small"
            android:paddingEnd="4dp"
            android:text="@string/driver_name"
            android:textColor="@color/text_black"
            app:layout_constraintEnd_toStartOf="@+id/tvTruckNo"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDestValue" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTruckNo"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:fontFamily="@font/gilroy_regular"
            android:gravity="start|center"
            android:paddingStart="@dimen/margin_small"
            android:paddingEnd="4dp"
            android:text="@string/truck_id"
            android:textColor="@color/text_black"
            app:layout_constraintEnd_toStartOf="@+id/tvContact"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/tvDriverName"
            app:layout_constraintTop_toBottomOf="@id/tvDestValue" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvContact"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:fontFamily="@font/gilroy_regular"
            android:gravity="start|center"
            android:paddingStart="@dimen/margin_small"
            android:paddingEnd="4dp"
            android:text="@string/contact"
            android:textColor="@color/text_black"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/tvTruckNo"
            app:layout_constraintTop_toBottomOf="@id/tvDestValue" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvDriverNameValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gilroy_semibold"
            android:gravity="start|center"
            android:paddingStart="@dimen/margin_small"
            android:paddingEnd="4dp"
            android:textColor="@color/text_black"
            app:layout_constraintEnd_toStartOf="@+id/tvTruckNoValue"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDriverName"
            tools:text="SAmple Name" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTruckNoValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gilroy_semibold"
            android:gravity="start|center"
            android:paddingStart="@dimen/margin_small"
            android:paddingEnd="4dp"
            android:textColor="@color/text_black"
            app:layout_constraintEnd_toStartOf="@+id/tvContactValue"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/tvDriverNameValue"
            app:layout_constraintTop_toBottomOf="@id/tvDriverName"
            tools:text="TN32 B 65776" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvContactValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gilroy_semibold"
            android:gravity="start|center"
            android:paddingStart="@dimen/margin_small"
            android:paddingEnd="4dp"
            android:textColor="@color/text_black"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/tvTruckNoValue"
            app:layout_constraintTop_toBottomOf="@id/tvDriverName"
            tools:text="0003242323" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvSendingWH"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:fontFamily="@font/gilroy_regular"
            android:gravity="start|center"
            android:paddingStart="@dimen/margin_small"
            android:paddingEnd="4dp"
            android:text="Sending WH"
            android:textColor="@color/text_black"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDriverNameValue" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvSendingWHValue"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:fontFamily="@font/gilroy_semibold"
            android:gravity="start|center"
            android:paddingStart="@dimen/margin_small"
            android:paddingEnd="4dp"
            android:text="@string/driver_name"
            android:textColor="@color/text_black"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSendingWH" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMaterialList"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            app:layout_constraintEnd_toEndOf="@id/tvDate"
            app:layout_constraintStart_toStartOf="@id/tvDest"
            app:layout_constraintTop_toBottomOf="@id/tvSendingWHValue"
            tools:itemCount="3"
            tools:listitem="@layout/item_cameroon_material_layout" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>