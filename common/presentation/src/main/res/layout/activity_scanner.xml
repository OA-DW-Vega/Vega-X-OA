<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <SurfaceView
            android:id="@+id/cameraPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_gravity="center"
            android:background="@drawable/ic_fullscreen_black_24dp"
            android:gravity="center" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvUploadFromGallery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/layout_width_120"
            android:layout_gravity="bottom|center"
            android:gravity="center"
            android:background="@drawable/card_round_corner_grey"
            android:backgroundTint="@color/warm_white"
            android:textColor="@color/dark_grey_ofi"
            android:drawableStart="@drawable/ic_gallery"
            android:drawablePadding="@dimen/margin_mic_small"
            android:paddingStart="@dimen/margin_mic_small"
            android:paddingEnd="@dimen/margin_small"
            android:text="Upload from gallery"/>
    </FrameLayout>
</RelativeLayout>