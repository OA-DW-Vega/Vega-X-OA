<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/base_fliptab_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center_vertical"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tab_left"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/tab_left_unselected"
            android:gravity="center"
            android:paddingStart="@dimen/leftTabPaddingStart"
            android:paddingTop="@dimen/margin_mic_small"
            android:paddingEnd="@dimen/leftTabPaddingEnd"
            android:paddingBottom="@dimen/margin_mic_small"
            android:textColor="@color/grey_border"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="100sp"
            app:autoSizeMinTextSize="16sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"
            tools:text="Left tab" />

        <TextView
            android:id="@+id/tab_right"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/tab_right_unselected"
            android:gravity="center"
            android:paddingStart="@dimen/rightTabPaddingStart"
            android:paddingTop="@dimen/margin_mic_small"
            android:paddingEnd="@dimen/rightTabPaddingEnd"
            android:paddingBottom="@dimen/margin_mic_small"
            android:textColor="@color/grey_border"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="100sp"
            app:autoSizeMinTextSize="16sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"
            tools:text="Right tab" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tab_selected_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tab_selected"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/tab_left_selected"
            android:gravity="center"
            android:paddingStart="@dimen/leftTabPaddingStart"
            android:paddingTop="@dimen/margin_mic_small"
            android:paddingEnd="@dimen/leftTabPaddingEnd"
            android:paddingBottom="@dimen/margin_mic_small"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="100sp"
            app:autoSizeMinTextSize="16sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"
            tools:text="Left tab" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>