<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <include layout="@layout/toolbar" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryOfi"
        android:fontFamily="@font/gt_walsheim_pro_regular"
        android:padding="@dimen/margin_small"
        android:text="@string/print_document"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_medium"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gt_walsheim_pro_regular"
                android:text="@string/print_type"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_large" />

            <LinearLayout
                android:id="@+id/llBluetooth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/margin_min"
                android:layout_marginTop="@dimen/margin_xlarge"
                android:background="@drawable/custom_edit_text"
                android:orientation="horizontal"
                android:weightSum="10">

                <View
                    android:layout_width="@dimen/margin_padding_size_zero"
                    android:layout_height="match_parent"
                    android:layout_weight=".4"
                    android:background="@drawable/left_round_corner_ofi" />

                <TextView
                    android:layout_width="@dimen/margin_padding_size_zero"
                    android:layout_height="wrap_content"
                    android:layout_weight="7.6"
                    android:fontFamily="@font/gt_walsheim_pro_bold"
                    android:padding="@dimen/margin_padding_size_medium"
                    android:text="@string/bluetooth"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/margin_padding_size_zero"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_weight="2"
                    android:padding="@dimen/margin_small"
                    android:src="@drawable/ic_right_arrow" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/llWifi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/margin_min"
                android:layout_marginTop="@dimen/margin_xlarge"
                android:background="@drawable/custom_edit_text"
                android:orientation="horizontal"
                android:weightSum="10">

                <View
                    android:layout_width="@dimen/margin_padding_size_zero"
                    android:layout_height="match_parent"
                    android:layout_weight=".4"
                    android:background="@drawable/left_round_corner_ofi" />

                <TextView
                    android:layout_width="@dimen/margin_padding_size_zero"
                    android:layout_height="wrap_content"
                    android:layout_weight="7.6"
                    android:fontFamily="@font/gt_walsheim_pro_bold"
                    android:padding="@dimen/margin_padding_size_medium"
                    android:text="@string/wifi"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/margin_padding_size_zero"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_weight="2"
                    android:padding="@dimen/margin_small"
                    android:src="@drawable/ic_right_arrow" />

            </LinearLayout>


        </LinearLayout>

    </LinearLayout>


</LinearLayout>