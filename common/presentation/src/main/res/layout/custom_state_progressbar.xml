<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="@dimen/margin_medium"
    android:padding="@dimen/margin_mic_small"
    android:orientation="horizontal">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintHorizontal_weight="1"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ll2"
        android:orientation="horizontal">

        <View
            android:id="@+id/view_state1"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:background="@drawable/cv_green_circle" />
        <TextView
            android:id="@+id/text_view_state1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            android:textStyle="bold"
            android:textSize="@dimen/text_size_title"
            android:textColor="@color/white"
            app:layout_constraintTop_toTopOf="@+id/view_state1"
            app:layout_constraintBottom_toBottomOf="@+id/view_state1"
            app:layout_constraintEnd_toEndOf="@+id/view_state1"
            app:layout_constraintStart_toStartOf="@+id/view_state1" />
        <View
            android:id="@+id/view_progress1"
            android:layout_width="wrap_content"
            android:layout_height="4dp"
            app:layout_constraintStart_toEndOf="@+id/view_state1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@color/dark_grey_1" />

    </androidx.constraintlayout.widget.ConstraintLayout>



    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintHorizontal_weight="1"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ll3"
        app:layout_constraintStart_toEndOf="@+id/ll1"
        android:orientation="horizontal">

        <View
            android:id="@+id/view_state2"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:backgroundTint="@color/dark_grey_1"
            android:background="@drawable/cv_green_circle" />
        <TextView
            android:id="@+id/text_view_state2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2"
            android:textStyle="bold"
            android:textSize="@dimen/text_size_title"
            android:textColor="@color/dark_marun"
            app:layout_constraintTop_toTopOf="@+id/view_state2"
            app:layout_constraintBottom_toBottomOf="@+id/view_state2"
            app:layout_constraintEnd_toEndOf="@+id/view_state2"
            app:layout_constraintStart_toStartOf="@+id/view_state2" />
        <View
            android:id="@+id/view_progress2"
            android:layout_width="wrap_content"
            android:layout_height="4dp"
            app:layout_constraintStart_toEndOf="@+id/view_state2"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@color/dark_grey_1" />

    </androidx.constraintlayout.widget.ConstraintLayout>



    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintHorizontal_weight="1"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ll4"
        app:layout_constraintStart_toEndOf="@+id/ll2"
        android:orientation="horizontal">

        <View
            android:id="@+id/view_state3"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:backgroundTint="@color/dark_grey_1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:background="@drawable/cv_green_circle" />
        <TextView
            android:id="@+id/text_view_state3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3"
            android:textStyle="bold"
            android:textSize="@dimen/text_size_title"
            android:textColor="@color/dark_marun"
            app:layout_constraintTop_toTopOf="@+id/view_state3"
            app:layout_constraintBottom_toBottomOf="@+id/view_state3"
            app:layout_constraintEnd_toEndOf="@+id/view_state3"
            app:layout_constraintStart_toStartOf="@+id/view_state3" />
        <View
            android:id="@+id/view_progress3"
            android:layout_width="wrap_content"
            android:layout_height="4dp"
            app:layout_constraintStart_toEndOf="@+id/view_state3"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@color/dark_grey_1" />

    </androidx.constraintlayout.widget.ConstraintLayout>



    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ll3"
        app:layout_constraintHorizontal_weight="0.5">

        <View
            android:id="@+id/view_state4"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:backgroundTint="@color/dark_grey_1"
            android:background="@drawable/cv_green_circle" />
        <TextView
            android:id="@+id/text_view_state4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4"
            android:textStyle="bold"
            android:textSize="@dimen/text_size_title"
            android:textColor="@color/dark_marun"
            app:layout_constraintTop_toTopOf="@+id/view_state4"
            app:layout_constraintBottom_toBottomOf="@+id/view_state4"
            app:layout_constraintEnd_toEndOf="@+id/view_state4"
            app:layout_constraintStart_toStartOf="@+id/view_state4" />


    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>