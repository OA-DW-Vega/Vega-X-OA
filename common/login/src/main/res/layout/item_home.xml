<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginTop="@dimen/margin_large"
    android:gravity="center|top"
    android:orientation="vertical"
    android:padding="@dimen/margin_padding_size_small"
    tools:ignore="UseCompoundDrawables">

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivHomeMenuItem"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_quality_menu"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tvHomeMenuItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/margin_mic_small"
                android:fontFamily="@font/gilroy_semibold"
                android:textColor="@color/text_black"
                android:gravity="center"
                android:textStyle="bold"
                android:maxLines="2"
                android:text="Receiving"
                android:textSize="@dimen/text_size_smedium"
                android:singleLine="false" />
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/rlOfflineCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="60dp"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/do_circle_blue"
                android:tint="@color/green" />

            <TextView
                android:id="@+id/tvOfflineCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:textColor="@color/white"
                android:fontFamily="@font/gilroy_semibold"
                android:textStyle="bold"
                android:text="0"
                tools:text="00" />
        </RelativeLayout>
    </RelativeLayout>

</LinearLayout>