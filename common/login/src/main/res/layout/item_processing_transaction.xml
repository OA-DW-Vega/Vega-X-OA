<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/margin_mic_small"
    android:background="@null">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_very_small">

        <LinearLayout
            android:id="@+id/llItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/margin_small"
                android:paddingTop="@dimen/margin_mic_small"
                android:paddingEnd="@dimen/margin_small">

                <TextView
                    android:id="@+id/tvwbLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/roboto_medium"
                    android:text="Fgrn Id"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_small"
                    tools:ignore="RelativeOverlap,RtlSymmetry" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/roboto_medium"
                    android:text="Sync Status"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_small"
                    tools:ignore="RelativeOverlap,RtlSymmetry" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/margin_small"
                android:paddingEnd="@dimen/margin_small">

                <TextView
                    android:id="@+id/tvWeighBridgeId"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/roboto_bold"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    android:textStyle="bold"
                    tools:text="193916003245" />

                <TextView
                    android:id="@+id/tvSyncStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/roboto_bold"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    android:textStyle="bold"
                    tools:text="100006003245" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/margin_small"
                android:paddingTop="@dimen/margin_mic_small"
                android:paddingEnd="@dimen/margin_small">

                <TextView
                    android:id="@+id/tvwbTypeLabel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/roboto_medium"
                    android:text="Output Material"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_small"
                    android:visibility="visible"
                    tools:ignore="RelativeOverlap,RtlSymmetry" />

                <TextView
                    android:id="@+id/tvDateLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/roboto_medium"
                    android:text="Date"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_small"
                    tools:ignore="RelativeOverlap,RtlSymmetry" />

                <TextView
                    android:id="@+id/tvDirectionLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight=".8"
                    android:fontFamily="@font/roboto_medium"
                    android:text="Direction"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_small"
                    android:visibility="gone"
                    tools:ignore="RelativeOverlap,RtlSymmetry" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_mic_small"
                android:orientation="horizontal"
                android:paddingStart="@dimen/margin_small"
                android:paddingEnd="@dimen/margin_small">

                <TextView
                    android:id="@+id/tvType"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/roboto_bold"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    android:textStyle="bold"
                    android:visibility="visible"
                    tools:text="LBA_0001" />

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/roboto_bold"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    android:textStyle="bold"
                    tools:text="10/01/2020" />

                <TextView
                    android:id="@+id/tvDirection"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight=".8"
                    android:fontFamily="@font/roboto_bold"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="10/01/2020" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/litGrey"
                android:orientation="horizontal"
                android:visibility="visible">

                <TextView
                    android:id="@+id/tvErrorMsg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_mic_small"
                    android:layout_weight="4"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:padding="10dp"
                    android:textColor="@color/grey_button"
                    tools:text="Error" />

                <TextView
                    android:id="@+id/tvErrorMsg1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_mic_small"
                    android:layout_weight="4"
                    android:padding="10dp"
                    android:textColor="@color/grey_button"
                    android:visibility="gone"
                    tools:text="Error" />

                <TextView
                    android:id="@+id/tvViewWeighBridge"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:background="@color/grey_light"
                    android:gravity="center"
                    android:text="View Details"
                    android:textColor="@color/grey_button"
                    android:textStyle="bold" />

            </LinearLayout>

            <View
                android:id="@+id/vStatus"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:background="@color/blue_light" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbItemLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:progressTint="@color/green"
            android:visibility="gone" />
    </androidx.cardview.widget.CardView>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivDeleteData"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_alignParentEnd="true"
        android:layout_margin="2dp"
        android:background="@drawable/do_circle_blue"
        android:backgroundTint="@color/grey_button"
        android:contentDescription="@string/sync"
        android:elevation="5dp"
        android:gravity="center"
        android:padding="5dp"
        android:src="@drawable/ic_close_white_24dp"
        android:tint="@color/white" />

</RelativeLayout>