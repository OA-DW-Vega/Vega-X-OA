<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clParent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/margin_mic_small"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivPreview"
            android:layout_width="300dp"
            android:layout_height="330dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@mipmap/ic_launcher" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvLot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_large"
            android:gravity="start"
            android:paddingStart="@dimen/margin_small"
            android:paddingEnd="@dimen/margin_small"
            android:text="@string/batch_no"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tvLotValue"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivPreview" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvLotValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_small"
            android:gravity="start"
            android:paddingStart="@dimen/margin_medium"
            android:paddingEnd="@dimen/margin_medium"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="2"
            app:layout_constraintStart_toEndOf="@+id/tvLot"
            app:layout_constraintTop_toBottomOf="@+id/ivPreview"
            tools:text="123456" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_small"
            android:gravity="start"
            android:paddingStart="@dimen/margin_small"
            android:paddingTop="@dimen/margin_mic_small"
            android:paddingEnd="@dimen/margin_small"
            android:text="@string/text"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@+id/tvTextValue"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvTextValue" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTextValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_small"
            android:gravity="start"
            android:paddingStart="@dimen/margin_medium"
            android:paddingTop="@dimen/margin_mic_small"
            android:paddingEnd="@dimen/margin_medium"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="2"
            app:layout_constraintStart_toEndOf="@+id/tvText"
            app:layout_constraintTop_toBottomOf="@id/tvLotValue"
            tools:text="123456" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvMaterial"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_large"
            android:gravity="start"
            android:paddingStart="@dimen/margin_small"
            android:paddingTop="@dimen/margin_mic_small"
            android:paddingEnd="@dimen/margin_small"
            android:text="@string/material"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tvMaterialValue"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvMaterialValue" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvMaterialValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_small"
            android:gravity="start"
            android:paddingStart="@dimen/margin_medium"
            android:paddingTop="@dimen/margin_mic_small"
            android:paddingEnd="@dimen/margin_medium"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="2"
            app:layout_constraintStart_toEndOf="@+id/tvMaterial"
            app:layout_constraintTop_toBottomOf="@+id/tvLot"
            tools:text="123456" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvGrade"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_large"
            android:gravity="start"
            android:paddingStart="@dimen/margin_small"
            android:paddingTop="@dimen/margin_mic_small"
            android:paddingEnd="@dimen/margin_small"
            android:text="@string/grade"
            android:visibility="gone"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tvGradeValue"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvGradeValue" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvGradeValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_small"
            android:gravity="start"
            android:paddingStart="@dimen/margin_medium"
            android:paddingTop="@dimen/margin_mic_small"
            android:paddingEnd="@dimen/margin_medium"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="2"
            app:layout_constraintStart_toEndOf="@+id/tvGrade"
            app:layout_constraintTop_toBottomOf="@+id/tvMaterialValue"
            tools:text="123456" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvCertificate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_large"
            android:gravity="start"
            android:paddingStart="@dimen/margin_small"
            android:paddingTop="@dimen/margin_mic_small"
            android:text="@string/certificate"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@+id/tvCertificateValue"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvCertificateValue" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvCertificateValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_small"
            android:gravity="start"
            android:paddingStart="@dimen/margin_medium"
            android:paddingTop="@dimen/margin_mic_small"
            android:paddingEnd="@dimen/margin_medium"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="2"
            app:layout_constraintStart_toEndOf="@+id/tvCertificate"
            app:layout_constraintTop_toBottomOf="@+id/tvGradeValue"
            tools:text="123456" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvWeight"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_large"
            android:gravity="start"
            android:paddingStart="@dimen/margin_small"
            android:paddingTop="@dimen/margin_mic_small"
            android:paddingEnd="@dimen/margin_small"
            android:text="@string/weight"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tvWeightValue"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvWeightValue" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvWeightValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_small"
            android:gravity="start"
            android:paddingStart="@dimen/margin_medium"
            android:paddingTop="@dimen/margin_mic_small"
            android:paddingEnd="@dimen/margin_medium"
            android:paddingBottom="@dimen/margin_medium"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="2"
            app:layout_constraintStart_toEndOf="@+id/tvWeight"
            app:layout_constraintTop_toBottomOf="@id/tvCertificateValue"
            tools:text="123456" />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvComplianceLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_large"
            android:paddingStart="@dimen/margin_small"
            android:paddingTop="@dimen/margin_mic_small"
            android:paddingEnd="@dimen/margin_small"
            android:text="@string/eudr_status"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:visibility="gone"
            android:lineSpacingExtra="6sp"
            tools:visibility="visible"
            app:layout_constraintEnd_toStartOf="@+id/tvComplianceValue"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvWeight" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvComplianceValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_small"
            android:paddingStart="@dimen/margin_medium"
            android:paddingTop="@dimen/margin_mic_small"
            android:paddingEnd="@dimen/margin_medium"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:visibility="gone"
            android:textAlignment="viewStart"
            tools:visibility="visible"
            app:layout_constraintBottom_toBottomOf="@id/tvComplianceLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="2"
            app:layout_constraintStart_toEndOf="@+id/tvComplianceLabel"
            app:layout_constraintTop_toTopOf="@id/tvComplianceLabel"
            tools:text="123456" />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvSrcLotLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_large"
            android:paddingStart="@dimen/margin_small"
            android:paddingTop="@dimen/margin_mic_small"
            android:paddingEnd="@dimen/margin_small"
            android:text="@string/source_lot"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:visibility="gone"
            android:lineSpacingExtra="6sp"
            tools:visibility="visible"
            app:layout_constraintEnd_toStartOf="@+id/tvSrcLotValue"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvComplianceLabel" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvSrcLotValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_small"
            android:paddingStart="@dimen/margin_medium"
            android:paddingTop="@dimen/margin_mic_small"
            android:paddingEnd="@dimen/margin_medium"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:visibility="gone"
            android:textAlignment="viewStart"
            tools:visibility="visible"
            app:layout_constraintBottom_toBottomOf="@id/tvSrcLotLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="2"
            app:layout_constraintStart_toEndOf="@+id/tvSrcLotLabel"
            app:layout_constraintTop_toTopOf="@id/tvSrcLotLabel"
            tools:text="123456" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>