<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="@dimen/seek_bar_thickness"
    android:orientation="horizontal">
    <TableLayout
        android:id="@+id/table_info1"
        android:layout_width="1400dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/clHead1A"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title4">

        <TableRow>
            <TextView
                android:id="@+id/tvQualityNameApprove"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:fontFamily="@font/roboto_bold"
                android:gravity="start"
                android:padding="@dimen/margin_padding_size_small"
                android:text="Quality"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_large" />

            <TextView
                android:id="@+id/tvUnitApprove"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/roboto_bold"
                android:gravity="start"
                android:padding="@dimen/margin_padding_size_small"
                android:text="Value"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_large" />
        </TableRow>
    </TableLayout>

</LinearLayout>