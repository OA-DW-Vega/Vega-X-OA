<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clParent"
        android:layout_width="340dp"
        android:layout_height="440dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">




        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivPreview"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_margin="@dimen/margin_min"
            android:padding="@dimen/margin_small"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@mipmap/ic_launcher" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvLot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:text="@string/ticket"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            android:layout_marginStart="@dimen/margin_small"
            android:paddingStart="@dimen/margin_small"
            app:layout_constraintBottom_toBottomOf="@id/tvLotValue"
            app:layout_constraintEnd_toStartOf="@+id/tvLotValue"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivPreview" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvLotValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_mic_small"
            android:paddingStart="@dimen/margin_mic_small"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="2"
            app:layout_constraintStart_toEndOf="@+id/tvLot"
            app:layout_constraintTop_toTopOf="@+id/tvLot"
            tools:text="123456" />



        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvMaterial"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="@dimen/margin_small"
            android:paddingStart="@dimen/margin_small"
            android:paddingTop="@dimen/margin_mic_small"
            android:paddingEnd="@dimen/margin_small"
            android:text="@string/creation_date"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tvMaterialValue"
            app:layout_constraintEnd_toStartOf="@+id/tvMaterialValue"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvMaterialValue" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvMaterialValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_small"
            android:paddingStart="@dimen/margin_medium"
            android:paddingTop="@dimen/margin_mic_small"
            android:layout_marginTop="8dp"
            android:paddingEnd="@dimen/margin_medium"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="2"
            app:layout_constraintStart_toEndOf="@+id/tvMaterial"
            app:layout_constraintTop_toBottomOf="@+id/tvLot"
            tools:text="12/10/2021" />


        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvGrade"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_small"
            android:layout_marginTop="@dimen/margin_padding_size_small"
            android:paddingStart="@dimen/margin_small"
            android:paddingTop="@dimen/margin_mic_small"
            android:paddingEnd="@dimen/margin_small"
            android:text="@string/quality"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tvGradeValue"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvMaterialValue" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvGradeValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_small"
            android:paddingStart="@dimen/margin_medium"

            android:paddingTop="@dimen/margin_mic_small"
            android:paddingEnd="@dimen/margin_medium"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tvGrade"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="2"
            app:layout_constraintStart_toEndOf="@+id/tvGrade"
            app:layout_constraintTop_toTopOf="@id/tvGrade"
            tools:text="123456" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvCertificate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_small"
            android:paddingStart="@dimen/margin_small"
            android:layout_marginTop="@dimen/margin_padding_size_small"
            android:paddingTop="@dimen/margin_mic_small"
            android:paddingEnd="@dimen/margin_small"
            android:text="@string/certificate"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tvWeightValue"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvGradeValue" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvCertificateValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_small"
            android:paddingStart="@dimen/margin_medium"
            android:paddingTop="@dimen/margin_mic_small"
            android:paddingEnd="@dimen/margin_medium"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tvCertificate"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="2"
            app:layout_constraintStart_toEndOf="@+id/tvWeight"
            app:layout_constraintTop_toTopOf="@id/tvCertificate"
            tools:text="123456" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvSacks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_small"
            android:paddingStart="@dimen/margin_small"
            android:layout_marginTop="@dimen/margin_padding_size_small"
            android:paddingTop="@dimen/margin_mic_small"
            android:paddingEnd="@dimen/margin_small"
            android:text="@string/bags"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tvSacksValue"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvCertificate" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvSacksValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_small"
            android:paddingStart="@dimen/margin_medium"
            android:paddingTop="@dimen/margin_mic_small"
            android:paddingEnd="@dimen/margin_medium"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tvSacks"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="2"
            app:layout_constraintStart_toEndOf="@+id/tvSacks"
            app:layout_constraintTop_toTopOf="@id/tvSacks"
            tools:text="123456" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvWeight"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_small"
            android:paddingStart="@dimen/margin_small"
            android:paddingTop="@dimen/margin_mic_small"
            android:paddingEnd="@dimen/margin_small"
            android:text="@string/net_weight"
            android:layout_marginTop="@dimen/margin_padding_size_small"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tvWeightValue"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvSacks" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvWeightValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_small"
            android:paddingStart="@dimen/margin_medium"
            android:paddingTop="@dimen/margin_mic_small"
            android:paddingEnd="@dimen/margin_medium"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tvWeight"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="2"
            app:layout_constraintStart_toEndOf="@+id/tvWeight"
            app:layout_constraintTop_toTopOf="@id/tvWeight"
            tools:text="123456" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvClient"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_small"
            android:layout_marginTop="@dimen/margin_padding_size_small"
            android:paddingStart="@dimen/margin_small"
            android:paddingTop="@dimen/margin_mic_small"
            android:paddingEnd="@dimen/margin_small"
            android:text="@string/vendor_name"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tvClientValue"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvWeight" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvClientValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_small"
            android:paddingStart="@dimen/margin_medium"
            android:paddingTop="@dimen/margin_mic_small"
            android:paddingEnd="@dimen/margin_medium"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="2"
            app:layout_constraintStart_toEndOf="@+id/tvClient"
            app:layout_constraintTop_toTopOf="@id/tvClient"
            tools:text="123456" />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvWateredDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_small"
            android:layout_marginTop="@dimen/margin_padding_size_small"
            android:paddingStart="@dimen/margin_small"
            android:paddingTop="@dimen/margin_mic_small"
            android:paddingEnd="@dimen/margin_small"
            android:text="@string/watered_date"
            android:visibility="gone"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tvWateredDateValue"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvClient" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvWateredDateValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_small"
            android:paddingStart="@dimen/margin_medium"
            android:paddingTop="@dimen/margin_mic_small"
            android:paddingEnd="@dimen/margin_medium"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="2"
            app:layout_constraintStart_toEndOf="@+id/tvWateredDate"
            app:layout_constraintTop_toTopOf="@id/tvWateredDate"
            tools:text="" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvStLoc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_small"
            android:layout_marginTop="@dimen/margin_padding_size_small"
            android:paddingStart="@dimen/margin_small"
            android:paddingTop="@dimen/margin_mic_small"
            android:paddingEnd="@dimen/margin_small"
            android:text="@string/st_location"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@+id/tvStLocValue"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvWateredDate" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvStLocValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_small"
            android:paddingStart="@dimen/margin_medium"
            android:paddingTop="@dimen/margin_mic_small"
            android:paddingEnd="@dimen/margin_medium"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="2"
            app:layout_constraintStart_toEndOf="@+id/tvStLoc"
            app:layout_constraintTop_toTopOf="@id/tvStLoc"
            tools:text="123456" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>