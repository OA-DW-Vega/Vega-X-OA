<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryHeadOfi"
        android:fontFamily="@font/gilroy_regular"
        android:padding="@dimen/margin_small"
        android:paddingStart="@dimen/margin_large"
        android:paddingEnd="@dimen/margin_large"
        android:text="@string/mtnt_weighbridge"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/orange"
        android:elevation="@dimen/margin_small"
        app:cardElevation="@dimen/margin_small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/orange"
            android:paddingTop="@dimen/margin_very_small"
            android:paddingBottom="@dimen/margin_very_small">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTruckIDNo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/gilroy_regular"
                android:gravity="start|center"
                android:paddingStart="@dimen/margin_small"
                android:paddingEnd="@dimen/margin_min"
                android:text="@string/truck_id"
                android:textColor="@color/white"
                app:layout_constraintEnd_toStartOf="@+id/tvPoNoLbl"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintHorizontal_weight="1.2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
               />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPoNoLbl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_regular"
                android:gravity="start|center"
                android:paddingStart="@dimen/margin_small"
                android:paddingEnd="@dimen/margin_min"
                android:text="@string/po_no"
                android:textColor="@color/white"
                app:layout_constraintBottom_toBottomOf="@id/tvTruckIDNo"
                app:layout_constraintEnd_toStartOf="@+id/tvCustomerLbl"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintHorizontal_weight="1.3"
                app:layout_constraintStart_toEndOf="@+id/tvTruckIDNo"
                app:layout_constraintTop_toTopOf="@id/tvTruckIDNo"
              />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvCustomerLbl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_regular"
                android:gravity="start|center"
                android:paddingStart="@dimen/margin_small"
                android:paddingEnd="@dimen/margin_min"
                android:text="@string/customer"
                android:visibility="gone"
                android:textColor="@color/white"
                app:layout_constraintBottom_toBottomOf="@id/tvTruckIDNo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@+id/tvPoNoLbl"
                app:layout_constraintTop_toTopOf="@id/tvTruckIDNo"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTruckValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_semibold"
                android:gravity="start|center"
                android:paddingStart="@dimen/margin_small"
                android:paddingEnd="@dimen/margin_min"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@id/tvTruckIDNo"
                app:layout_constraintEnd_toStartOf="@+id/tvPoNoLbl"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintHorizontal_weight="1.2"
                app:layout_constraintStart_toStartOf="@id/tvTruckIDNo"
                app:layout_constraintTop_toBottomOf="@id/tvTruckIDNo"
                tools:text="1000 Kg" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPoNoValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_semibold"
                android:gravity="start|center"
                android:paddingStart="@dimen/margin_small"
                android:paddingEnd="@dimen/margin_min"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@id/tvPoNoLbl"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintHorizontal_weight="1.3"
                app:layout_constraintStart_toStartOf="@id/tvPoNoLbl"
                app:layout_constraintTop_toTopOf="@id/tvTruckValue"
                tools:text="Bush Cocoa" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvCustomerValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_semibold"
                android:gravity="start|center"
                android:paddingStart="@dimen/margin_small"
                android:paddingEnd="@dimen/margin_min"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="@id/tvCustomerLbl"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toStartOf="@id/tvCustomerLbl"
                app:layout_constraintTop_toTopOf="@id/tvTruckValue"
                tools:text="Store1000" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

