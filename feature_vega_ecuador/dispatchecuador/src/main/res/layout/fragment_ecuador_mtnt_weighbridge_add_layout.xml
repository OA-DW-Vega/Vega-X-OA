    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clStartLoad"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_margin="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card">

        <TextView
            android:id="@+id/btStartLoad"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:background="@drawable/shape_rect_corner_violet"
            android:backgroundTint="@color/dark_marun"
            android:fontFamily="@font/roboto_bold"
            android:gravity="center"
            android:paddingStart="@dimen/action_bar_height"
            android:text="@string/start_loading"
            android:textAllCaps="true"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivPlay"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="@dimen/margin_large"
            android:src="@drawable/ic_play_arrow_black_24dp_ecu"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_marginTop="@dimen/margin_medium"
        app:layout_constraintBottom_toTopOf="@id/btnProceed"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clStartLoad">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true">

            <TextView
                android:id="@+id/tvDest"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:background="@drawable/shape_rect_grey_border_ecu"
                android:fontFamily="@font/gilroy_semibold"
                android:gravity="center"
                android:text="@string/destination_wh_man1"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/tvWhValue"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvWhValue"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/shape_rect_white_bg_ecu"
                android:drawableEnd="@drawable/ic_add_icon_new"
                android:gravity="center"
                android:padding="@dimen/margin_padding_size_small"
                android:textColor="@color/text_black"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="@id/tvDest"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tvDest"
                app:layout_constraintTop_toTopOf="@id/tvDest"
                tools:text="Sample" />


            <TextView
                android:id="@+id/tvsto"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:background="@drawable/shape_rect_grey_border_ecu"
                android:fontFamily="@font/gilroy_semibold"
                android:gravity="center"
                android:text="@string/sto_number_man1"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/tvWhValue"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvDest" />

            <TextView
                android:id="@+id/tvstoValue"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/shape_rect_white_bg_ecu"
                android:gravity="center"
                android:padding="@dimen/margin_padding_size_medium"
                android:textColor="@color/text_black"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="@id/tvsto"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tvsto"
                app:layout_constraintTop_toTopOf="@id/tvsto" />

           <!-- <TextView
                android:id="@+id/tvMaterial"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:background="@drawable/shape_rect_grey_border"
                android:fontFamily="@font/gilroy_semibold"
                android:gravity="center"
                android:text="@string/material_man"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_medium"
