<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingConstraints"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryHeadOfi"
        android:fontFamily="@font/gilroy_regular"
        android:padding="@dimen/margin_small"
        android:text="@string/offloading_supplier_summary"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_lot_value"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@color/orange"
        android:fontFamily="@font/gilroy_semibold"
        android:gravity="center|start"
        android:padding="@dimen/margin_small"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        tools:text="109090" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/white"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/clNet"
        app:layout_constraintTop_toBottomOf="@+id/tv_lot_value">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white">

            <androidx.cardview.widget.CardView
                android:id="@+id/card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:elevation="@dimen/margin_small"
                app:cardElevation="@dimen/margin_small"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            </androidx.cardview.widget.CardView>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLotSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginTop="@dimen/margin_large"
                android:fontFamily="@font/gilroy_semibold"
                android:text="@string/offloading_summary"
                android:textColor="@color/text_black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvProcurementType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:fontFamily="@font/gilroy_regular"
                android:text="@string/procurement_type"
                android:textColor="@color/dark_marun"
                android:textSize="@dimen/text_size_medium"
                app:layout_constraintStart_toStartOf="@id/tvLotSummary"
                app:layout_constraintTop_toBottomOf="@id/tvLotSummary" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvProcurementTypeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_large"
                android:fontFamily="@font/gilroy_semibold"
                android:textColor="@color/dark_marun"
                android:textSize="@dimen/text_size_medium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvLotSummary"
                tools:text="Spot Purchase" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPONumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/gilroy_regular"
                android:text="@string/po_number"
                android:textColor="@color/dark_marun"
                android:textSize="@dimen/text_size_medium"
                app:layout_constraintStart_toStartOf="@id/tvLotSummary"
                app:layout_constraintTop_toBottomOf="@id/tvProcurementType" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPONumberValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_semibold"
                android:textColor="@color/dark_marun"
                android:textSize="@dimen/text_size_medium"
                app:layout_constraintBottom_toBottomOf="@id/tvPONumber"
                app:layout_constraintEnd_toEndOf="@id/tvProcurementTypeValue"
                app:layout_constraintTop_toTopOf="@id/tvPONumber"
                tools:text="100800799" />

            <View
                android:id="@+id/vi_procure"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/dash_line"
                app:layout_constraintEnd_toEndOf="@id/tvProcurementTypeValue"
                app:layout_constraintStart_toStartOf="@id/tvProcurementType"
                app:layout_constraintTop_toBottomOf="@id/tvPONumberValue" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvGross"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:fontFamily="@font/gilroy_regular"
                android:text="@string/gross_weight"
                android:textColor="@color/dark_marun"
                android:textSize="@dimen/text_size_medium"
                app:layout_constraintStart_toStartOf="@id/tvLotSummary"
                app:layout_constraintTop_toBottomOf="@id/vi_procure" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvGrossValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_large"
                android:fontFamily="@font/gilroy_semibold"
                android:textColor="@color/dark_marun"
                android:textSize="@dimen/text_size_medium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/vi_procure"
                tools:text="1200 MT" />

            <View
                android:id="@+id/vi_gross"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/dash_line"
                app:layout_constraintEnd_toEndOf="@id/tvGrossValue"
                app:layout_constraintStart_toStartOf="@id/tvGross"
                app:layout_constraintTop_toBottomOf="@id/tvGross" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_no_bags"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:fontFamily="@font/gilroy_regular"
                android:text="@string/no_of_bags"
                android:textColor="@color/dark_marun"
                android:textSize="@dimen/text_size_medium"
                app:layout_constraintStart_toStartOf="@id/tvLotSummary"
                app:layout_constraintTop_toBottomOf="@id/vi_gross" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvNoBagsValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_semibold"
                android:textColor="@color/dark_marun"
                android:textSize="@dimen/text_size_medium"
                app:layout_constraintBottom_toBottomOf="@id/tv_no_bags"
                app:layout_constraintEnd_toEndOf="@id/tvGrossValue"
                app:layout_constraintTop_toTopOf="@id/tv_no_bags"
                tools:text="100" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_bags_tare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/gilroy_regular"
                android:text="@string/tare_weight"
                android:textColor="@color/dark_marun"
                android:textSize="@dimen/text_size_medium"
                app:layout_constraintStart_toStartOf="@id/tvLotSummary"
                app:layout_constraintTop_toBottomOf="@id/tv_no_bags" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvBagsTareValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_semibold"
                android:textColor="@color/dark_marun"
                android:textSize="@dimen/text_size_medium"
                app:layout_constraintBottom_toBottomOf="@id/tv_bags_tare"
                app:layout_constraintEnd_toEndOf="@id/tvGrossValue"
                app:layout_constraintTop_toTopOf="@id/tv_no_bags"
                tools:text="10 MT" />

            <View
                android:id="@+id/vi_bags"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/dash_line"
                app:layout_constraintEnd_toEndOf="@id/tvGrossValue"
                app:layout_constraintStart_toStartOf="@id/tvGross"
                app:layout_constraintTop_toBottomOf="@id/tv_bags_tare" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_source_lot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:fontFamily="@font/gilroy_regular"
                android:text="Source Lot Id"
                android:textColor="@color/dark_marun"
                android:textSize="@dimen/text_size_medium"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/vi_bags"
                app:layout_constraintStart_toStartOf="@id/tvLotSummary"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvSourceLotValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_semibold"
                android:textColor="@color/dark_marun"
                android:textSize="@dimen/text_size_medium"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/vi_bags"
                app:layout_constraintEnd_toEndOf="@id/tvBagsTareValue"
                app:layout_constraintTop_toTopOf="@id/tv_source_lot"
                tools:text="100" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_eudr_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/gilroy_regular"
                android:text="Eudr Status"
                android:textColor="@color/dark_marun"
                android:textSize="@dimen/text_size_medium"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/tv_source_lot"
                app:layout_constraintStart_toStartOf="@id/tvLotSummary"
                />

            <!--<include layout="@layout/layout_eudr_status"
                android:id="@+id/eudrStatus"
                android:visibility="gone"
               />-->

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvEudrStatusValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_semibold"
                android:textColor="@color/dark_marun"
                android:textSize="@dimen/text_size_medium"
                tools:text="10 MT"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/tvSourceLotValue"
                app:layout_constraintEnd_toEndOf="@id/tvSourceLotValue"
                app:layout_constraintTop_toTopOf="@id/tv_eudr_status"/>

            <View
                android:id="@+id/vi_source_lot"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/dash_line"
                app:layout_constraintEnd_toEndOf="@id/tvGrossValue"
                app:layout_constraintStart_toStartOf="@id/tvGross"
                app:layout_constraintTop_toBottomOf="@id/tv_eudr_status" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_net_weight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:layout_marginBottom="@dimen/margin_medium"
                android:fontFamily="@font/gilroy_regular"
                android:text="@string/net_weight"
                android:textColor="@color/dark_marun"
                android:textSize="@dimen/text_size_medium"
                app:layout_constraintStart_toStartOf="@id/tvLotSummary"
                app:layout_constraintTop_toBottomOf="@id/vi_source_lot" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvNetWeightValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:layout_marginBottom="@dimen/margin_medium"
                android:fontFamily="@font/gilroy_semibold"
                android:textColor="@color/dark_marun"
                android:textSize="@dimen/text_size_medium"
                app:layout_constraintBottom_toBottomOf="@id/tv_net_weight"
                app:layout_constraintEnd_toEndOf="@id/tvGrossValue"
                app:layout_constraintTop_toTopOf="@id/tv_net_weight"
                tools:text="100 MT" />

            <View
                android:id="@+id/vi_net"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/dash_line"
                app:layout_constraintEnd_toEndOf="@id/tvGrossValue"
                app:layout_constraintStart_toStartOf="@id/tvGross"
                app:layout_constraintTop_toBottomOf="@id/tv_net_weight" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/clNet"
        layout="@layout/layout_bottom_ecuador_offloading_weight_summary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@id/btProceed"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btProceed"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryOfi"
        android:fontFamily="@font/roboto_bold"
        android:gravity="center"
        android:padding="@dimen/margin_large"
        android:text="@string/confirm"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_smedium"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>