<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@null">

    <ImageView
        android:id="@+id/ivCloseDelivery"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_alignParentEnd="true"
        android:layout_margin="2dp"
        android:background="@drawable/circle_shape"
        android:backgroundTint="@color/grey_button"
        android:elevation="5dp"
        android:gravity="center"
        android:padding="5dp"
        android:src="@drawable/ic_close_white_24dp" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/gilroy_regular"
                    android:text="Bales"
                    android:textColor="@color/grey_light" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/weight"
                    android:fontFamily="@font/gilroy_regular"
                    android:textColor="@color/grey_light" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="Grade"
                    android:fontFamily="@font/gilroy_regular"
                    android:textColor="@color/grey_light" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tvDeliveryBales"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="200"
                    android:fontFamily="@font/gilroy_regular"
                    android:textColor="@color/text_black" />

                <TextView
                    android:id="@+id/tvDeliveryWeight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="500 MT"
                    android:fontFamily="@font/gilroy_regular"
                    android:textColor="@color/text_black" />

                <TextView
                    android:id="@+id/tvDeliveryGrade"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:fontFamily="@font/gilroy_regular"
                    android:text="MANBO/S_1/32"
                    android:textColor="@color/text_black" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/litGrey"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/ivStatus"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:src="@drawable/icon_no_progresss" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llShowError"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Delivery Order No"
                        android:fontFamily="@font/gilroy_regular"
                        android:textColor="@color/grey_light" />

                    <TextView
                        android:id="@+id/tvDeliveryNo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="18GRDB00003"
                        android:fontFamily="@font/gilroy_regular"
                        android:textColor="@color/text_black" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvViewDelivery"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:background="@color/grey_light"
                    android:gravity="center"
                    android:fontFamily="@font/gilroy_regular"
                    android:text="View Details"
                    android:textColor="@color/grey_button"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/llError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/yellow"
                android:orientation="horizontal"
                android:padding="10dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivErrorClose"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight=".5"
                    android:fontFamily="@font/gilroy_regular"
                    android:src="@drawable/ic_close_white_24dp" />

                <TextView
                    android:id="@+id/tvErrorMsg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3.5"
                    android:fontFamily="@font/gilroy_regular"
                    android:maxLines="2"
                    android:text="Bale stuffing incorrect"
                    android:textColor="@color/text_black" />
            </LinearLayout>

            <View
                android:id="@+id/vStatus"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:background="@color/blue_lit" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>


</RelativeLayout>