<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/margin_mic_small"
    android:background="@null">

    <ImageView
        android:id="@+id/ivDeleteData"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_alignParentEnd="true"
        android:layout_margin="2dp"
        android:background="@drawable/circle_shape"
        android:backgroundTint="@color/grey_button"
        android:contentDescription="@string/sync"
        android:elevation="5dp"
        android:gravity="center"
        android:padding="5dp"
        android:src="@drawable/ic_close_white_24dp"
        app:tint="@color/white" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mtn_no"
                    android:fontFamily="@font/gilroy_regular"
                    android:textColor="@color/grey_light" />

                <!--<TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight=".8"
                    android:text="@string/weight"
                    android:textColor="@color/grey_light" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:text="@string/received_on"
                    android:textColor="@color/grey_light" />-->

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tvMtnItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gilroy_regular"
                    android:textColor="@color/text_black" />

                <!--<TextView
                    android:id="@+id/tvWeighWeight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight=".8"
                    android:textColor="@color/text_black"
                    tools:text="@string/oneweight" />

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:textColor="@color/text_black"
                    tools:text="@string/date" />-->

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/litGrey"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/ivStatus"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/tran_master_sync"
                        android:src="@drawable/icon_no_progresss" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llShowError"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2.2"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_min"
                        android:layout_marginBottom="@dimen/margin_min"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/truck_no"
                            android:fontFamily="@font/gilroy_regular"
                            android:textColor="@color/grey_button" />

                        <TextView
                            android:id="@+id/tvTruckNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="5dp"
                            android:paddingEnd="0dp"
                            android:fontFamily="@font/gilroy_regular"
                            android:textColor="@color/text_black"
                            android:textStyle="bold"
                            tools:text="18GRD00028" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/no_of_bales_colon"
                            android:fontFamily="@font/gilroy_regular"
                            android:textColor="@color/grey_button" />

                        <TextView
                            android:id="@+id/tvNoOfBales"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/margin_mic_small"
                            android:paddingEnd="@dimen/margin_mic_small"
                            android:fontFamily="@font/gilroy_regular"
                            android:textColor="@color/text_black"
                            android:textStyle="bold"
                            tools:text="100" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvViewMtnDetails"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.8"
                    android:background="@color/grey_light"
                    android:gravity="center"
                    android:text="@string/view_details"
                    android:fontFamily="@font/gilroy_regular"
                    android:textColor="@color/grey_button"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/llError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/pink_light"
                android:orientation="horizontal"
                android:padding="10dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivErrorClose"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight=".5"
                    android:contentDescription="@string/sync"
                    android:src="@drawable/ic_close_white_24dp"
                    app:tint="@color/light_marun" />

                <TextView
                    android:id="@+id/tvErrorMsg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3.5"
                    android:maxLines="2"
                    android:fontFamily="@font/gilroy_regular"
                    android:text="@string/mtn_incorrect"
                    android:textColor="@color/light_marun" />
            </LinearLayout>

            <View
                android:id="@+id/vStatus"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:background="@color/blue_light" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>


</RelativeLayout>