        tools:ignore="GoogleAppIndexingWarning,MissingApplicationIcon,LockedOrientationActivity">
        <activity
            android:name="com.olam.warehouse.ginning.ui.dispatch.GinningDispatchActivity"
            android:configChanges="orientation|keyboardHidden"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name="com.olam.warehouse.ginning.ui.dispatch.GinningDispatchEditBaleActivity"
            android:configChanges="orientation|keyboardHidden"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name="com.olam.warehouse.ginning.ui.incominglots.GinningSelectIncomingLotTypeActivity"
            android:configChanges="orientation|keyboardHidden"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan" />
        <activity
        android:name="com.olam.warehouse.ginning.ui.incominglots.seedcotton.GinningIncomingLotActivity"
        android:configChanges="orientation|keyboardHidden"
