<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:background="@color/white"
    android:focusableInTouchMode="true">

    <include
        android:id="@+id/tool_bar"
        layout="@layout/toolbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/btnShowSummary"
        android:layout_below="@+id/tool_bar"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/blue_port_background"
            android:backgroundTint="@color/colorPrimaryHeadOfi"
            android:fontFamily="@font/gilroy_semibold"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/margin_large"
            android:paddingTop="@dimen/margin_medium"
            android:paddingEnd="@dimen/margin_large"
            android:paddingBottom="@dimen/margin_medium"
            android:text="@string/add_container"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_smedium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_large"
            android:layout_marginEnd="@dimen/margin_large"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_large"
                android:fontFamily="@font/gilroy_semibold"
                android:paddingStart="5dp"
                android:text="@string/container_num"
                android:textColor="@color/text_black"
                android:textSize="@dimen/margin_medium"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/llScanContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:layout_marginBottom="@dimen/margin_small"
                android:background="@drawable/scanbale_port_corner"
                android:gravity="center"
                android:visibility="gone">

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/blue"
                    android:clickable="false"
                    android:drawableStart="@drawable/qr_code_port"
                    android:drawablePadding="@dimen/margin_small"
                    android:fontFamily="@font/gilroy_semibold"
                    android:text="@string/scan_container_id"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <View
                    android:layout_width="50dp"
                    android:layout_height="0.5dp"
                    android:layout_gravity="center"
                    android:background="@color/grey" />

                <TextView
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gilroy_semibold"
                    android:gravity="center"
                    android:text="@string/or"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_small" />

                <View
                    android:layout_width="50dp"
                    android:layout_height="0.5dp"
                    android:layout_gravity="center"
                    android:background="@color/grey" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:background="@drawable/container_grey_stroke_port">

                <EditText
                    android:id="@+id/etContainerNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_small"
                    android:background="@android:color/transparent"
                    android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
                    android:fontFamily="@font/gilroy_regular"
                    android:maxLength="11"
                    android:paddingLeft="@dimen/margin_small"
                    android:paddingTop="@dimen/margin_mic_small"
                    android:paddingRight="@dimen/margin_small"
                    android:paddingBottom="@dimen/margin_mic_small"
                    android:textColor="@color/dark_Grey"
                    android:textSize="@dimen/text_size_medium" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_large"
                android:fontFamily="@font/gilroy_semibold"
                android:paddingStart="5dp"
                android:text="@string/shipping_line"
                android:textColor="@color/text_black"
                android:textSize="@dimen/margin_medium"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/flShipLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:background="@drawable/container_grey_stroke_port">

                <TextView
                    android:id="@+id/tvShippingLine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:layout_marginEnd="@dimen/margin_medium"
                    android:fontFamily="@font/gilroy_regular"
                    android:paddingLeft="@dimen/margin_small"
                    android:paddingTop="@dimen/margin_medium"
                    android:paddingRight="@dimen/margin_small"
                    android:paddingBottom="@dimen/margin_medium"
                    android:textColor="@color/dark_Grey"
                    android:textSize="@dimen/text_size_medium" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="right|center"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:layout_marginEnd="@dimen/margin_medium"
                    android:src="@drawable/ic_down_arrow_black_port" />

            </FrameLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_large"
                android:fontFamily="@font/gilroy_semibold"
                android:paddingStart="5dp"
                android:text="@string/container_type"
                android:textColor="@color/text_black"
                android:textSize="@dimen/margin_medium"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:background="@drawable/container_grey_stroke_port"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/flContainerGood"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_min"
                    android:layout_marginTop="@dimen/margin_min"
                    android:layout_marginEnd="@dimen/margin_min"
                    android:background="@color/colorSecondaryGrey"
                    android:paddingTop="@dimen/margin_small"
                    android:paddingBottom="@dimen/margin_small">

                    <RadioButton
                        android:id="@+id/rbGood"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_medium"
                        android:checked="true"
                        android:clickable="false"
                        android:paddingStart="@dimen/margin_medium"
                        android:fontFamily="@font/gilroy_semibold"
                        android:text="@string/good"
                        android:textSize="@dimen/margin_medium"
                        android:textStyle="bold" />

                </FrameLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/grey" />

                <FrameLayout
                    android:id="@+id/flContainerBad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_min"
                    android:layout_marginEnd="@dimen/margin_min"
                    android:layout_marginBottom="@dimen/margin_min"
                    android:paddingTop="@dimen/margin_small"
                    android:paddingBottom="@dimen/margin_small">

                    <RadioButton
                        android:id="@+id/rbDamaged"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_medium"

                        android:clickable="false"
                        android:fontFamily="@font/gilroy_semibold"
                        android:paddingStart="@dimen/margin_medium"
                        android:text="@string/damaged"
                        android:textSize="@dimen/margin_medium"
                        android:textStyle="bold" />

                </FrameLayout>
            </LinearLayout>


        </LinearLayout>

    </LinearLayout>

    <Button
        android:id="@+id/btnShowSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/btnAddContainer"
        android:layout_marginBottom="@dimen/margin_medium"
        android:background="@color/colorPrimaryOfi"
        android:enabled="true"
        android:paddingTop="@dimen/margin_medium"
        android:paddingBottom="@dimen/margin_medium"
        android:text="Show Container Summary"
        android:fontFamily="@font/gilroy_semibold"
        android:textColor="@android:color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:visibility="visible" />

    <Button
        android:id="@+id/btnAddContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/colorSecondaryGrey"
        android:enabled="false"
        android:paddingTop="@dimen/margin_medium"
        android:paddingBottom="@dimen/margin_medium"
        android:text="@string/add_container"
        android:fontFamily="@font/gilroy_semibold"
        android:textColor="@android:color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:visibility="visible" />
</RelativeLayout>