<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rowItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/margin_min"
    android:background="@color/white"
    android:orientation="horizontal"
    android:paddingTop="@dimen/margin_padding_size_medium"
    android:paddingBottom="@dimen/margin_padding_size_medium">

    <TextView
        android:id="@+id/tvBaleId"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_weight="1.7"
        android:gravity="center"
        tools:text="1234567891"
        android:textColor="@color/black" />

    <TextView
        android:id="@+id/tvGrade"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_weight="2.5"
        android:gravity="center"
        tools:text="Grade 6"
        android:textColor="@color/black" />

    <TextView
        android:id="@+id/tvBaleWeight"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_weight="1.5"
        android:gravity="center"
        tools:text="250 kg"
        android:textColor="@color/black" />

    <LinearLayout
        android:id="@+id/lDelete"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_weight="1.3"
        android:gravity="center">

        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:background="@drawable/circle_shape_port"
            android:contentDescription="@string/closeaction"
            android:gravity="center"
            android:padding="3dp"
            android:src="@drawable/ic_close_white_24dp_port"
            android:textColor="@color/black" />
    </LinearLayout>


</LinearLayout>