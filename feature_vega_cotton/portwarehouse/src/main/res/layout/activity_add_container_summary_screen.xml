<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        android:id="@+id/tool_bar"
        layout="@layout/toolbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@+id/tool_bar"
        android:layout_above="@+id/btnProceed">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/blue_port_background"
            android:backgroundTint="@color/colorPrimaryHeadOfi"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/margin_large"
            android:paddingTop="@dimen/margin_medium"
            android:paddingEnd="@dimen/margin_large"
            android:paddingBottom="@dimen/margin_medium"
            android:fontFamily="@font/gilroy_semibold"
            android:text="@string/track_container_summary"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_smedium" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvContainers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
          >
        </androidx.recyclerview.widget.RecyclerView>
    </LinearLayout>


    <Button
        android:id="@+id/btnProceed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/colorPrimaryOfi"
        android:paddingTop="@dimen/margin_medium"
        android:paddingBottom="@dimen/margin_medium"
        android:text="@string/proceed"
        android:fontFamily="@font/gilroy_semibold"
        android:textColor="@android:color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:visibility="visible" />

</RelativeLayout>