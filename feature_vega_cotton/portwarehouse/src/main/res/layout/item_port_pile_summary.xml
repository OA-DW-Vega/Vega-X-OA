<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:layout_margin="12dp"
    android:background="@drawable/bale_detail_border_port"
    card_view:cardCornerRadius="4dp"
    card_view:cardElevation="@dimen/margin_mic_small">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:background="@color/white"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_padding_size_small"
                android:layout_marginTop="@dimen/margin_small"
                android:layout_marginBottom="@dimen/margin_small"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:padding="@dimen/margin_mic_small"
                android:weightSum="3">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.6"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:text="@string/bales"
                        android:fontFamily="@font/gilroy_regular"
                        android:textColor="@color/grey_border" />

                    <TextView
                        android:id="@+id/tvNoOfBales"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:fontFamily="@font/gilroy_regular"
                        android:textColor="@color/text_black"
                        android:textStyle="bold"
                        tools:text="200" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:text="@string/weight"
                        android:fontFamily="@font/gilroy_regular"
                        android:textColor="@color/grey_border" />

                    <TextView
                        android:id="@+id/tvWeight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:fontFamily="@font/gilroy_regular"
                        android:textColor="@color/text_black"
                        android:textStyle="bold"
                        tools:text="500 MT" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.4"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:text="@string/grade_name"
                        android:fontFamily="@font/gilroy_regular"
                        android:textColor="@color/grey_border" />

                    <TextView
                        android:id="@+id/tvDispatchGrade"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:maxLines="2"
                        android:fontFamily="@font/gilroy_regular"
                        android:textColor="@color/text_black"
                        android:textStyle="bold"
                        tools:text="MANBO/S_1*3/32" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llViewBale"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight=".5"
            android:gravity="center"
            android:background="@drawable/grey_bottom_top_right_corner_port"
            android:backgroundTint="@color/colorSecondaryGrey"
            android:visibility="visible">

            <TextView
                android:id="@+id/btnViewBale"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="View\n Bale IDs"
                android:fontFamily="@font/gilroy_regular"
                android:textAllCaps="false"
                android:textColor="@color/text_black"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
