<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <include
        android:id="@+id/tool_bar"
        layout="@layout/toolbar" />

    <LinearLayout
        android:id="@+id/llContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="90"
            android:background="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/colorPrimaryHeadOfi"
                    android:padding="@dimen/margin_small">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dispatch_sealed_container"
                        android:textColor="@color/white"
                        android:fontFamily="@font/gilroy_semibold"
                        android:textSize="@dimen/text_size_smedium"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/colorSecondaryGrey"
                    android:orientation="horizontal"
                    android:padding="@dimen/margin_small">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sealed_container"
                        android:textColor="@color/text_black"
                        android:fontFamily="@font/gilroy_regular"
                        android:textSize="@dimen/text_size_medium"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHBreakContainerNo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_black"
                        android:textSize="@dimen/text_size_medium"
                        android:textStyle="bold"
                        android:fontFamily="@font/gilroy_regular"
                        tools:text="18GRD00998" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:layout_marginBottom="@dimen/margin_medium"
                    android:orientation="vertical"
                    android:padding="@dimen/margin_padding_size_medium">

                    <Button
                        android:id="@+id/btnBreakSeal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/scanbale_port_corner"
                        android:backgroundTint="@color/dark_marun"
                        android:text="@string/break_seal_to_edit_bales"
                        android:fontFamily="@font/gilroy_semibold"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/rectangle_port_border"
                        android:padding="@dimen/margin_padding_size_medium">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:gravity="start"
                            android:text="@string/container_num"
                            android:fontFamily="@font/gilroy_regular"
                            android:textColor="@color/text_black"
                            android:textSize="@dimen/text_size_medium"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvBreakContainerNo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:layout_weight="1"
                        android:background="@drawable/rectangle_port_grey_border"
                        android:fontFamily="@font/gilroy_regular"
                        android:padding="@dimen/margin_padding_size_medium"
                        android:textColor="@color/text_black"
                        android:textSize="@dimen/text_size_medium"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/rectangle_port_border"
                        android:padding="@dimen/margin_padding_size_medium">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:gravity="start"
                            android:text="@string/seal_no"
                            android:fontFamily="@font/gilroy_regular"
                            android:textColor="@color/text_black"
                            android:textSize="@dimen/text_size_medium"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSealNo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:layout_weight="1"
                        android:background="@drawable/rectangle_port_grey_border"
                        android:padding="@dimen/margin_padding_size_medium"
                        android:fontFamily="@font/gilroy_regular"
                        android:textColor="@color/text_black"
                        android:textSize="@dimen/text_size_medium"
                        android:textStyle="bold" />
                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/warm_white"
                    android:orientation="vertical"
                    android:padding="@dimen/margin_small">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:background="@drawable/top_port_corner"
                        android:backgroundTint="@color/dark_marun"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btn_balestuffing"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/top_port_corner"
                            android:backgroundTint="@color/dark_marun"
                            android:drawableEnd="@drawable/ic_keyboard_arrow_up_white_port_24dp"
                            android:gravity="start|center"
                            android:padding="@dimen/margin_padding_size_medium"
                            android:fontFamily="@font/gilroy_semibold"
                            android:text="@string/bale_stuffing_summary"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.7"
                            android:background="@drawable/rectangle_port_border"
                            android:gravity="center"
                            android:maxLines="1"
                            android:fontFamily="@font/gilroy_regular"
                            android:paddingTop="@dimen/margin_small"
                            android:paddingBottom="@dimen/margin_small"
                            android:text="@string/bale_id"
                            android:textColor="@color/text_black" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2.5"
                            android:background="@drawable/rectangle_port_border"
                            android:gravity="center"
                            android:maxLines="1"
                            android:fontFamily="@font/gilroy_regular"
                            android:paddingTop="@dimen/margin_small"
                            android:paddingBottom="@dimen/margin_small"
                            android:text="@string/grade"
                            android:textColor="@color/text_black" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.5"
                            android:background="@drawable/rectangle_port_border"
                            android:gravity="center"
                            android:maxLines="1"
                            android:fontFamily="@font/gilroy_regular"
                            android:paddingTop="@dimen/margin_small"
                            android:paddingBottom="@dimen/margin_small"
                            android:text="@string/weight"
                            android:textColor="@color/text_black" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.5"
                            android:background="@drawable/rectangle_port_border"
                            android:gravity="center"
                            android:maxLines="1"
                            android:visibility="gone"
                            android:fontFamily="@font/gilroy_regular"
                            android:paddingTop="@dimen/margin_small"
                            android:paddingBottom="@dimen/margin_small"
                            android:text="@string/action"
                            android:textColor="@color/text_black" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/recycler_linearlayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvSealBaleSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:dividerHeight="1dp"
                            android:scrollbars="vertical"
                            android:visibility="visible"
                            tools:listitem="@layout/bale_summary_row" />

                        <TextView
                            android:id="@+id/tvSealNoBaleData"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:background="@color/white"
                            android:gravity="center"
                            android:padding="@dimen/margin_padding_size_medium"
                            android:fontFamily="@font/gilroy_regular"
                            android:text="@string/no_bale_summary_available"
                            android:textColor="@color/grey_border" />
                    </LinearLayout>


                </LinearLayout>


            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="10"
            android:background="@color/black">

            <Button
                android:id="@+id/btnSealcontainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/colorSecondaryGrey"
                android:clickable="false"
                android:textAllCaps="false"
                android:text="@string/seal_container"
                android:fontFamily="@font/gilroy_semibold"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    <!--<include layout ="@layout/empty_content"/>-->

</LinearLayout>