<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rowItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_border_black_port"
    android:gravity="center"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:paddingTop="@dimen/margin_large"
    android:paddingBottom="@dimen/margin_large">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:gravity="center">

        <CheckBox
            android:id="@+id/cbGrade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
             />

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="8"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:layout_marginEnd="@dimen/margin_mic_small"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/grade_name"
                android:fontFamily="@font/gilroy_regular"
                android:textColor="@color/grey_button" />

            <TextView
                android:id="@+id/tvGrade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="MANBO/S_1”3/32"
                android:fontFamily="@font/gilroy_regular"
                android:ellipsize="end"
                android:textStyle="bold"
                android:textColor="@color/text_black" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:layout_marginStart="@dimen/margin_mic_small"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bales"
                android:fontFamily="@font/gilroy_regular"
                android:textColor="@color/grey_button" />

            <TextView
                android:id="@+id/tvNoOfBales"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="200"
                android:textStyle="bold"
                android:fontFamily="@font/gilroy_regular"
                android:textColor="@color/text_black" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:layout_marginStart="@dimen/margin_mic_small"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/weight"
                android:fontFamily="@font/gilroy_regular"
                android:textColor="@color/grey_button" />

            <TextView
                android:id="@+id/tvBaleWeight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="500 MT"
                android:fontFamily="@font/gilroy_regular"
                android:textStyle="bold"
                android:textColor="@color/text_black" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:gravity="center">

        <ImageView
            android:id="@+id/ivSync"
            android:padding="@dimen/margin_small"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_sync_port"/>

    </LinearLayout>

</LinearLayout>