<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvTruck_no"
        android:layout_width="0dp"
        android:layout_height="@dimen/action_bar_height"
        android:background="@color/colorPrimaryHeadOfi"
        android:gravity="center|start"
        android:paddingStart="@dimen/margin_medium"
        android:text="@string/inventory_list"
        android:textColor="@color/warm_white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_sort"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@color/orange"
        android:fontFamily="@font/gilroy_semibold"
        android:gravity="center"
        android:text="@string/sort_by_weight"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@+id/tv_filter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTruck_no" />

    <TextView
        android:id="@+id/tv_filter"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="#D2CECC"
        android:fontFamily="@font/gilroy_semibold"
        android:gravity="center"
        android:text="@string/filter"
        android:textColor="#6C5D56"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@id/tv_sort"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_sort"
        app:layout_constraintTop_toTopOf="@id/tv_sort" />


    <ImageView
        android:id="@+id/ivSortDownUp"
        android:layout_width="@dimen/margin_medium"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/margin_medium"
        android:contentDescription="@string/inventory_list"
        android:src="@drawable/ic_sort_white"
        app:layout_constraintBottom_toBottomOf="@id/tv_sort"
        app:layout_constraintEnd_toEndOf="@id/tv_sort"
        app:layout_constraintTop_toTopOf="@id/tv_sort" />

    <ImageView
        android:id="@+id/ivFilter"
        android:layout_width="@dimen/margin_medium"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/margin_medium"
        android:contentDescription="@string/inventory_list"
        android:src="@drawable/ic_sort_white"
        app:layout_constraintBottom_toBottomOf="@id/tv_filter"
        app:layout_constraintEnd_toEndOf="@id/tv_filter"
        app:layout_constraintTop_toTopOf="@id/tv_filter" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_weigh_bridge_id"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/margin_small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_sort" />

    <TextView
        android:id="@+id/tvNoData"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/no_data_found"
        android:textColor="@color/text_black"
        android:textSize="@dimen/text_size_large"
        android:visibility="gone" />


</androidx.constraintlayout.widget.ConstraintLayout>