<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryHeadOfi"
        android:fontFamily="@font/gilroy_regular"
        android:gravity="start"
        android:paddingStart="@dimen/margin_large"
        android:paddingTop="@dimen/margin_small"
        android:paddingEnd="4dp"
        android:paddingBottom="@dimen/margin_small"
        android:text="@string/rmin_shift_selection"
        android:textColor="@color/warm_white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvSelectShift"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_large"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/gilroy_semibold"
        android:text="@string/select_shift"
        android:textColor="@color/dark_marun"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTypeProcess"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_large"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/gilroy_semibold"
        android:text="@string/remark"
        android:textColor="@color/dark_marun"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rgShift" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/spRemarks"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="@dimen/margin_small"
        android:layout_marginEnd="@dimen/margin_large"
        android:background="@drawable/border_light_grey"
        android:dropDownWidth="match_parent"
        android:dropDownHeight="150dp"
        android:gravity="center_vertical"
        android:minHeight="60dp"
        android:hint="@string/enter_remark"
        android:overlapAnchor="false"
        android:padding="@dimen/margin_padding_size_small"
        android:popupBackground="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tvTypeProcess"
        app:layout_constraintTop_toBottomOf="@id/tvTypeProcess" />

    <RadioGroup
        android:id="@+id/rgShift"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSelectShift">

        <RadioButton
            android:id="@+id/rbA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/warm_grey"
            android:button="@null"
            android:drawableStart="@android:drawable/btn_radio"
            android:drawablePadding="20dp"
            android:fontFamily="@font/gilroy_semibold"
            android:padding="@dimen/margin_medium"
            android:textColor="@color/text_black"
            tools:text="@string/shift_a" />

        <RadioButton
            android:id="@+id/rbB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@color/warm_grey"
            android:button="@null"
            android:drawableStart="@android:drawable/btn_radio"
            android:drawablePadding="20dp"
            android:fontFamily="@font/gilroy_semibold"
            android:padding="@dimen/margin_medium"
            android:textColor="@color/text_black"
            tools:text="@string/shift_b" />

        <RadioButton
            android:id="@+id/rbC"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@color/warm_grey"
            android:button="@null"
            android:drawableStart="@android:drawable/btn_radio"
            android:drawablePadding="20dp"
            android:fontFamily="@font/gilroy_semibold"
            android:padding="@dimen/margin_medium"
            android:textColor="@color/text_black"
            tools:text="@string/shift_c" />
    </RadioGroup>


    <Button
        android:id="@+id/btnProceed"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/light_grey"
        android:enabled="false"
        android:fontFamily="@font/gilroy_semibold"
        android:text="@string/proceed"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>