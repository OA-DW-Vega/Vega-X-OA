<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    android:background="@drawable/custom_edit_text">

    <TextView
        android:id="@+id/tvMaterialLbl"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_medium"
        android:layout_marginTop="@dimen/margin_medium"
        android:fontFamily="@font/gilroy_regular"
        android:text="@string/material"
        android:textColor="#80050505"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@+id/tvStage"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvStage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_padding_size_xxlarge"
        android:fontFamily="@font/gilroy_regular"
        android:text="@string/weight_to_process"
        android:textColor="#80050505"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@id/tvMaterialLbl"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/tvMaterialLbl"
        app:layout_constraintTop_toTopOf="@id/tvMaterialLbl" />


    <TextView
        android:id="@+id/tvMaterialValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        android:layout_marginBottom="@dimen/margin_small"
        android:fontFamily="@font/gilroy_semibold"
        android:textColor="@color/text_black"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/tvMaterialLbl"
        app:layout_constraintTop_toBottomOf="@id/tvMaterialLbl"
        tools:text="1032049i0923" />

    <TextView
        android:id="@+id/tvStageValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/gilroy_semibold"
        android:textColor="@color/text_black"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@id/tvMaterialValue"
        app:layout_constraintStart_toEndOf="@id/tvMaterialValue"
        app:layout_constraintStart_toStartOf="@id/tvStage"
        app:layout_constraintTop_toTopOf="@id/tvMaterialValue"
        tools:text="@string/stage" />
</androidx.constraintlayout.widget.ConstraintLayout>