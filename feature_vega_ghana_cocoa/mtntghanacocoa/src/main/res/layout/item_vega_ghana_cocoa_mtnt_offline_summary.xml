<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/margin_mic_small"
    android:background="@null">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:padding="@dimen/card_corner_radius">

                <TextView
                    style="@style/Title_Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sto_number_man"
                    android:textColor="@color/grey_light" />

                <TextView
                    android:id="@+id/tvStoNo"
                    style="@style/Value_Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_mic_small"
                    android:maxLines="1"
                    tools:text="8100023228" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/card_corner_radius"
                android:paddingBottom="@dimen/card_corner_radius"
                tools:ignore="DisableBaselineAlignment,RtlSymmetry">

                <TextView
                    style="@style/Title_Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/destination_wh_man"
                    android:textColor="@color/grey_light" />

                <TextView
                    android:id="@+id/tvDestinationWH"
                    style="@style/Value_Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_mic_small"
                    android:maxLines="2"
                    tools:text="1515-Olam Ecuador El Empalme" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/card_corner_radius"
                android:paddingBottom="@dimen/card_corner_radius"
                tools:ignore="DisableBaselineAlignment,RtlSymmetry">

                <TextView
                    style="@style/Title_Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sd_waybillno"
                    android:textColor="@color/grey_light" />

                <TextView
                    android:id="@+id/tvSDWaybillNo"
                    style="@style/Value_Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_mic_small"
                    android:maxLines="2"
                    tools:text="1234568" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/card_corner_radius"
                android:paddingBottom="@dimen/card_corner_radius"
                tools:ignore="DisableBaselineAlignment,RtlSymmetry">

                <TextView
                    style="@style/Title_Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dispatch_qty"
                    android:textColor="@color/grey_light" />

                <TextView
                    android:id="@+id/tvDispatchQty"
                    style="@style/Value_Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_mic_small"
                    android:maxLines="2"
                    tools:text="5" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/ivStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:src="@drawable/icon_no_progresss"
                        tools:ignore="ContentDescription" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llShowError"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/delivery_no"
                        android:textColor="@color/grey_light" />

                    <TextView
                        android:id="@+id/tvDeliveryId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        tools:text="TMP_1234567890" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvViewDetails"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:background="@color/warm_grey"
                    android:drawableEnd="@drawable/ic_right_arrow"
                    android:gravity="center"
                    android:text="View Details"
                    android:textColor="@color/grey_dark" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/orange_error"
                android:padding="@dimen/margin_small"
                android:visibility="gone"
                tools:text="sync failed" />

            <View
                android:id="@+id/viewStatus"
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_padding_size_small"
                android:background="@color/light_blue" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <ImageView
        android:id="@+id/ivDelete"
        android:layout_width="@dimen/margin_large"
        android:layout_height="@dimen/margin_large"
        android:layout_alignParentEnd="true"
        android:layout_margin="2dp"
        android:background="@drawable/do_circle_blue"
        android:backgroundTint="@color/grey_button"
        android:elevation="5dp"
        android:gravity="center"
        android:padding="5dp"
        android:src="@drawable/ic_close_white_24dp"
        android:tint="@color/white"
        tools:ignore="ContentDescription" />

</RelativeLayout>




