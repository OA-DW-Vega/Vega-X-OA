<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_white">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryHeadOfi"
        android:fontFamily="@font/gt_walsheim_pro_regular"
        android:paddingStart="@dimen/margin_large"
        android:paddingTop="@dimen/margin_small"
        android:paddingEnd="@dimen/margin_large"
        android:paddingBottom="@dimen/margin_small"
        android:text="@string/mtnr_weighscale"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/llOffline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/marun"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/tv_title">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            android:padding="@dimen/text_size_medium"
            android:text="@string/view_offline"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:contentDescription="@string/offloading"
            android:src="@drawable/ic_right_arrow"
            android:tint="@color/white" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/btProceed"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvTruckIDNo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:fontFamily="@font/gt_walsheim_pro_regular"
                android:paddingStart="@dimen/margin_small"
                android:paddingEnd="@dimen/margin_small"
                android:text="@string/truck_details_text"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_smedium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/cbSelectStocks"
                android:orientation="vertical"
                android:id="@+id/linearOne"
                android:layout_marginTop="@dimen/margin_medium"
                app:layout_constraintTop_toBottomOf="@id/tvTruckIDNo"
                android:background="@drawable/shape_ghana_offload_rect_grey_border"
                android:paddingTop="@dimen/margin_mic_small"
                android:paddingBottom="@dimen/margin_mic_small"
                android:paddingEnd="@dimen/margin_small"
                android:paddingStart="@dimen/margin_small">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/roboto_medium"
                        android:text="@string/truck_no"
                        android:textColor="@color/grey"
                        android:textSize="@dimen/text_size_xmedium"
                        tools:ignore="RelativeOverlap,RtlSymmetry" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/roboto_medium"
                        android:text="@string/material"
                        android:textColor="@color/grey"
                        android:textSize="@dimen/text_size_xmedium"
                        tools:ignore="RelativeOverlap,RtlSymmetry" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvWeighBridgeId"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_size_xmedium"
                        android:textStyle="bold"
                        tools:text="19393024892" />

                    <TextView
                        android:id="@+id/tvProcureType"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_size_xmedium"
                        android:textStyle="bold"
                        tools:text="19393024892" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_mic_small"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvdifference"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="@string/dispatch_wh"
                        android:fontFamily="@font/roboto_medium"
                        android:textColor="@color/grey"
                        android:textSize="@dimen/text_size_xmedium" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/roboto_medium"
                        android:text="@string/obd_no"
                        android:textColor="@color/grey"
                        android:textSize="@dimen/text_size_xmedium" />


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/roboto_medium"
                        android:text="Date"
                        android:visibility="gone"
                        android:textColor="@color/grey"
                        android:textSize="@dimen/text_size_xmedium" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_mic_small"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvSupplierName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_size_xmedium"
                        android:textStyle="bold"
                        tools:text="LBA" />

                    <TextView
                        android:id="@+id/tvWeight"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_size_xmedium"
                        android:textStyle="bold"
                        tools:text="1000" />

                    <TextView
                        android:id="@+id/tvDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_size_xmedium"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="10/10/2020" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_mic_small"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNoOfBags"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="@string/number_of_bags"
                        android:fontFamily="@font/roboto_medium"
                        android:textColor="@color/grey"
                        android:textSize="@dimen/text_size_xmedium" />

                    <TextView
                        android:id="@+id/tvBagCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_size_xmedium"
                        android:textStyle="bold"
                        tools:text="3" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/tvBagDetails"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:fontFamily="@font/gt_walsheim_pro_regular"
                android:paddingStart="@dimen/margin_small"
                android:paddingEnd="@dimen/margin_small"
                android:text="@string/bag_details_text"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_smedium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/linearOne"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clConsign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_medium"
                app:layout_constraintTop_toBottomOf="@id/tvBagDetails">

                <TextView
                    android:id="@+id/tvDest"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/shape_ghana_offload_rect_grey_border"
                    android:fontFamily="@font/gt_walsheim_pro_bold"
                    android:gravity="center"
                    android:minHeight="60dp"
                    android:text="@string/accepted_bags"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/tvWhValue"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="@id/tvWhValue"
                    app:layout_constraintTop_toTopOf="@+id/tvWhValue" />

                <EditText
                    android:id="@+id/tvWhValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_ghana_offload_rect_white_bg"
                    android:gravity="center"
                    android:inputType="numberDecimal"
                    android:padding="@dimen/margin_padding_size_medium"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/tvDest"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="123" />


                <TextView
                    android:id="@+id/tvsto"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:background="@drawable/shape_ghana_offload_rect_grey_border"
                    android:fontFamily="@font/gt_walsheim_pro_bold"
                    android:gravity="center"
                    android:text="@string/rejected_bags"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/tvWhValue"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvDest" />

                <EditText
                    android:id="@+id/tvstoValue"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/shape_ghana_offload_rect_white_bg"
                    android:gravity="center"
                    android:padding="@dimen/margin_padding_size_medium"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:inputType="numberDecimal"
                    app:layout_constraintBottom_toBottomOf="@id/tvsto"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/tvsto"
                    app:layout_constraintTop_toTopOf="@id/tvsto"
                    tools:text="123"/>


<!--                <TextView-->
<!--                    android:id="@+id/tvReceivingWH"-->
<!--                    android:layout_width="0dp"-->
<!--                    android:layout_height="0dp"-->
<!--                    android:background="@drawable/shape_ghana_offload_rect_grey_border"-->
<!--                    android:fontFamily="@font/gt_walsheim_pro_bold"-->
<!--                    android:gravity="center"-->
<!--                    android:minHeight="60dp"-->
<!--                    android:text="@string/receiving_locations"-->
<!--                    android:textColor="@android:color/black"-->
<!--                    android:textSize="@dimen/text_size_medium"-->
<!--                    android:textStyle="bold"-->
<!--                    app:layout_constraintEnd_toStartOf="@+id/tvWhValue"-->
<!--                    app:layout_constraintHorizontal_bias="0.5"-->
<!--                    app:layout_constraintStart_toStartOf="parent"-->
<!--                    app:layout_constraintBottom_toBottomOf="@+id/tvReceivingValue"-->
<!--                    app:layout_constraintTop_toTopOf="@+id/tvReceivingValue"-->
<!--                    android:visibility="gone"/>-->

<!--                <TextView-->
<!--                    android:id="@+id/tvReceivingValue"-->
<!--                    android:layout_width="0dp"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:background="@drawable/shape_ghana_offload_rect_white_bg"-->
<!--                    android:gravity="center"-->
<!--                    android:padding="@dimen/margin_padding_size_medium"-->
<!--                    android:textColor="@color/black"-->
<!--                    android:textSize="16sp"-->
<!--                    app:layout_constraintEnd_toEndOf="parent"-->
<!--                    app:layout_constraintHorizontal_bias="0.5"-->
<!--                    app:layout_constraintStart_toEndOf="@+id/tvReceivingWH"-->
<!--                    app:layout_constraintTop_toBottomOf="@+id/tvstoValue"-->
<!--                    android:visibility="gone"/>-->



            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tvRejectDetails"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:fontFamily="@font/gt_walsheim_pro_regular"
                android:paddingStart="@dimen/margin_small"
                android:paddingEnd="@dimen/margin_small"
                android:text="@string/rejection_details"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_smedium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/clConsign"/>

            <LinearLayout
                android:id="@+id/llReject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingEnd="@dimen/margin_small"
                android:paddingStart="@dimen/margin_small"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvRejectDetails">



            </LinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- <Button
         android:id="@+id/btProceed"
         android:layout_width="0dp"
         android:layout_height="60dp"
         android:background="@color/colorPrimaryOfi"
         android:fontFamily="@font/roboto_bold"
         android:text="@string/proceed"
         android:textColor="@android:color/white"
         android:textSize="@dimen/text_size_medium"
         android:textStyle="bold"
         app:layout_constraintBottom_toBottomOf="parent"
         app:layout_constraintEnd_toEndOf="parent"
         app:layout_constraintStart_toStartOf="parent" />-->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btSave"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginEnd="2dp"
        android:background="@color/grey"
        android:fontFamily="@font/roboto_bold"
        android:gravity="center"
        android:text="@string/save"
        android:textColor="@android:color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btProceed"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btProceed"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@color/colorPrimaryOfi"
        android:fontFamily="@font/roboto_bold"
        android:gravity="center"
        android:text="@string/next"
        android:textColor="@android:color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/btSave" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivProceed"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="@color/white"
        android:contentDescription="@string/material"
        android:rotation="180"
        android:src="@drawable/ic_arrow_back_black_24dp"
        android:tint="@color/white"
        app:layout_constraintBottom_toBottomOf="@id/btProceed"
        app:layout_constraintEnd_toEndOf="@id/btProceed"
        app:layout_constraintTop_toTopOf="@id/btProceed"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>