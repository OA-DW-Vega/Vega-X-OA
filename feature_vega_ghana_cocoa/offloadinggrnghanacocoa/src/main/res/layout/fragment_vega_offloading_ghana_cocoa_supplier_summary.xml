<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/warm_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryHeadOfi"
        android:fontFamily="@font/gilroy_regular"
        android:padding="@dimen/margin_small"
        android:text="@string/grn_summary"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_lot_value"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@color/orange"
        android:fontFamily="@font/gilroy_semibold"
        android:gravity="center|start"
        android:padding="@dimen/margin_small"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        tools:text="109090" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/white"
        android:fillViewport="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_lot_value">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white">

            <androidx.cardview.widget.CardView
                android:id="@+id/card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:elevation="@dimen/margin_small"
                app:cardElevation="@dimen/margin_small"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            </androidx.cardview.widget.CardView>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLotSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginTop="@dimen/margin_large"
                android:textSize="@dimen/text_size_smedium"
                android:visibility="gone"
                android:fontFamily="@font/gilroy_semibold"
                android:text="@string/offloading_summary"
                android:textColor="@color/text_black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvProcurementType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:fontFamily="@font/gilroy_regular"
                android:text="@string/procurement_type"
                android:textColor="@color/dark_marun"
                android:textSize="@dimen/text_size_medium"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@id/tvLotSummary"
                app:layout_constraintTop_toBottomOf="@id/tvLotSummary" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvProcurementTypeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_large"
                android:fontFamily="@font/gilroy_semibold"
                android:textColor="@color/dark_marun"
                android:textSize="@dimen/text_size_medium"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvLotSummary"
                tools:text="Spot Purchase" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPONumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/gilroy_regular"
                android:text="@string/po_number"
                android:textColor="@color/dark_marun"
                android:textSize="@dimen/text_size_medium"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@id/tvLotSummary"
                app:layout_constraintTop_toBottomOf="@id/tvProcurementType" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPONumberValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_semibold"
                android:textColor="@color/dark_marun"
                android:textSize="@dimen/text_size_medium"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/tvPONumber"
                app:layout_constraintEnd_toEndOf="@id/tvProcurementTypeValue"
                app:layout_constraintTop_toTopOf="@id/tvPONumber"
                tools:text="100800799" />

            <LinearLayout
                android:id="@+id/ll_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_medium"
                android:orientation="vertical"
                app:layout_constraintStart_toStartOf="@id/tvLotSummary"
                app:layout_constraintTop_toBottomOf="@id/tvLotSummary">

                <LinearLayout
                        tools:visibility="visible"
                        android:visibility="gone"
                        android:id="@+id/llLotIdLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        >

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvLotId"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/gilroy_semibold"
                            android:text="@string/lot_id"
                            android:textColor="@color/text_black"
                            android:textSize="@dimen/text_size_smedium" />

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvlotsValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/gilroy_regular"
                            android:gravity="end"
                            android:textColor="@color/dark_marun"
                            android:textSize="@dimen/text_size_smedium"
                            tools:text="100800799" />

                </LinearLayout>



                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    >

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvReceivingWH"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/gilroy_semibold"
                        android:text="@string/warehouse_id"
                        android:textColor="@color/text_black"
                        android:textSize="@dimen/text_size_smedium" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvReceivingWHValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/gilroy_regular"
                        android:gravity="end"
                        android:textColor="@color/dark_marun"
                        android:textSize="@dimen/text_size_smedium"
                        tools:text="100800799" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    >

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/gilroy_semibold"
                        android:text="Date"
                        android:textColor="@color/text_black"
                        android:textSize="@dimen/text_size_smedium" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvDateValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/gilroy_regular"
                        android:gravity="end"
                        android:textColor="@color/dark_marun"
                        android:textSize="@dimen/text_size_smedium"
                        tools:text="100800799" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    >

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvWHReceiptNo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/gilroy_semibold"
                        android:text="@string/warehouse_receipt_number"
                        android:textColor="@color/text_black"
                        android:textSize="@dimen/text_size_smedium" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvWHReceiptNoValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/gilroy_regular"
                        android:gravity="end"
                        android:textColor="@color/dark_marun"
                        android:textSize="@dimen/text_size_smedium"
                        tools:text="100800799" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    >

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvSupplier"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/gilroy_semibold"
                        android:text="Supplier"
                        android:textColor="@color/text_black"
                        android:textSize="@dimen/text_size_smedium" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvSupplierValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/gilroy_regular"
                        android:gravity="end"
                        android:textColor="@color/dark_marun"
                        android:textSize="@dimen/text_size_smedium"
                        tools:text="100800799" />

                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    >

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvProduct"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/gilroy_semibold"
                        android:text="@string/product"
                        android:textColor="@color/text_black"
                        android:textSize="@dimen/text_size_smedium" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvProductValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/gilroy_regular"
                        android:gravity="end"
                        android:textColor="@color/dark_marun"
                        android:textSize="@dimen/text_size_smedium"
                        tools:text="100800799" />

                </LinearLayout>



                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvWRNo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/gilroy_regular"
                        android:text="WR no"
                        android:textColor="@color/dark_marun"
                        android:textSize="@dimen/text_size_smedium" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvWRNoValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/gilroy_semibold"
                        android:gravity="end"
                        android:textColor="@color/dark_marun"
                        android:textSize="@dimen/text_size_smedium"
                        tools:text="100800799" />

                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    >

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvBagType"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/gilroy_semibold"
                        android:text="@string/bag_type"
                        android:textColor="@color/text_black"
                        android:textSize="@dimen/text_size_smedium" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvBagTypeValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/gilroy_regular"
                        android:gravity="end"
                        android:textColor="@color/dark_marun"
                        android:textSize="@dimen/text_size_smedium"
                        tools:text="100800799" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    >

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_no_bags"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/gilroy_semibold"
                        android:text="@string/no_of_bags"
                        android:textColor="@color/text_black"
                        android:textSize="@dimen/text_size_smedium" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvNoBagsValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/gilroy_regular"
                        android:gravity="end"
                        android:textColor="@color/dark_marun"
                        android:textSize="@dimen/text_size_smedium"
                        tools:text="100800799" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llSourceLot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    >

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvSourceLotLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/gilroy_semibold"
                        android:text="Source Lot Id"
                        android:textColor="@color/text_black"
                        android:textSize="@dimen/text_size_smedium" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvSourceLotValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/gilroy_regular"
                        android:gravity="end"
                        android:textColor="@color/dark_marun"
                        android:textSize="@dimen/text_size_smedium"
                        tools:text="100800799" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llEudrStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    >

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvEudrLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/gilroy_semibold"
                        android:text="Eudr Status"
                        android:textColor="@color/text_black"
                        android:textSize="@dimen/text_size_smedium" />

                    <include layout="@layout/layout_eudr_status"
                        android:id="@+id/eudrStatus"
                        />

                    <!--<androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvEudrValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/gilroy_regular"
                        android:gravity="end"
                        android:textColor="@color/dark_marun"
                        android:textSize="@dimen/text_size_smedium"
                        tools:text="100800799" />-->

                </LinearLayout>


            </LinearLayout>

            <View
                android:id="@+id/vi_procure"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/dash_line"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="@id/ll_summary"
                app:layout_constraintStart_toStartOf="@id/ll_summary"
                app:layout_constraintTop_toBottomOf="@id/ll_summary" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>



    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btProceed"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryOfi"
        android:fontFamily="@font/roboto_bold"
        android:gravity="center"
        android:padding="@dimen/margin_large"
        android:text="@string/confirm"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_smedium"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>