<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clickable="true">

    <TextView
        android:id="@+id/tvHeadPoDetail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:backgroundTint="@color/colorPrimaryHeadOfi"
        android:fontFamily="@font/gilroy_regular"
        android:gravity="center_vertical"
        android:padding="@dimen/margin_small"
        android:paddingStart="@dimen/margin_large"
        android:paddingEnd="@dimen/margin_large"
        android:text="@string/select_grades"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvLotNoLbl"
        android:layout_width="0dp"
        android:layout_height="@dimen/action_bar_height"
        android:layout_gravity="center"
        android:background="@color/orange_light"
        android:gravity="center|start"
        android:paddingStart="@dimen/margin_medium"
        android:text="@string/pono"
        android:textColor="@color/warm_white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvHeadPoDetail" />

    <TextView
        android:id="@+id/tvLotNo"
        android:layout_width="0dp"
        android:layout_height="@dimen/action_bar_height"
        android:layout_gravity="center"
        android:background="@color/orange_light"
        android:gravity="center|start"
        android:paddingStart="@dimen/margin_medium"
        android:textColor="@color/warm_white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvLotNoLbl"
        app:layout_constraintTop_toBottomOf="@+id/tvHeadPoDetail"
        tools:text="lots12345" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGrades"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/margin_medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/tvProceed"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvLotNoLbl"
        tools:listitem="@layout/item_vega_cocoa_fgrn_grades" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvProceed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/light_grey"
        android:enabled="false"
        android:gravity="center"
        android:padding="@dimen/margin_medium"
        android:text="@string/confirm"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>