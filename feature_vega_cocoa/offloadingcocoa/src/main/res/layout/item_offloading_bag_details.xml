<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="@dimen/margin_mic_small"
        android:background="@drawable/dash_line"
        app:layout_constraintTop_toBottomOf="@+id/tvBagType"/>

    <TextView
        android:id="@+id/tvBagType"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:fontFamily="@font/gilroy_semibold"
        android:padding="@dimen/margin_very_small"
        app:layout_constraintEnd_toStartOf="@+id/tvBagCount"
        app:layout_constraintHorizontal_weight="2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="@string/bag_type" />

    <TextView
        android:id="@+id/tvBagCount"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:fontFamily="@font/gilroy_semibold"
        android:padding="@dimen/margin_very_small"
        app:layout_constraintEnd_toStartOf="@+id/tvDelete"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/tvBagType"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="@string/bag_type" />

    <TextView
        android:id="@+id/tvDelete"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="@dimen/margin_very_small"
        android:gravity="center_vertical"
        android:fontFamily="@font/gilroy_semibold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/tvBagCount"
        app:layout_constraintTop_toTopOf="parent"
        android:drawableEnd="@drawable/ic_coffee_cicle_close" />
</androidx.constraintlayout.widget.ConstraintLayout>