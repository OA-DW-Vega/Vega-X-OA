<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <FrameLayout
        android:id="@+id/flSalesLot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivScaleClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:contentDescription="@string/material"
            android:elevation="1dp"
            android:src="@drawable/ic_coffee_cicle_close"
            android:translationZ="2dp"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/margin_padding_size_small"
            android:layout_marginEnd="@dimen/margin_padding_size_small"
            android:elevation="1dp"
            android:padding="@dimen/margin_medium"
            android:src="@drawable/ic_more_vert_black_24dp"
            android:tint="@color/grey"
            android:translationZ="2dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_medium">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/margin_padding_size_small">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvPOTempId"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:layout_marginTop="@dimen/margin_small"
                    android:layout_marginEnd="@dimen/margin_small"
                    android:fontFamily="@font/gilroy_regular"
                    android:text="@string/po_number"
                    android:textColor="@color/text_black"
                    app:layout_constraintEnd_toStartOf="@id/tvWeight"
                    app:layout_constraintHorizontal_weight=".4"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvPOTempIdValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:fontFamily="@font/gilroy_regular"
                    android:gravity="start"
                    android:textColor="@color/text_black"
                    android:textStyle="bold"
                    app:layout_constraintHorizontal_bias="0.3"
                    app:layout_constraintHorizontal_weight="0.4"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvPOTempId"
                    tools:text="18GBRD140" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvWeight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:layout_marginEnd="@dimen/margin_small"
                    android:fontFamily="@font/gilroy_regular"
                    android:text="@string/weight"
                    android:textColor="@color/text_black"
                    app:layout_constraintEnd_toStartOf="@+id/tvDate"
                    app:layout_constraintHorizontal_weight=".3"
                    app:layout_constraintStart_toEndOf="@+id/tvPOTempId"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvWeightValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/margin_small"
                    android:layout_marginBottom="@dimen/margin_medium"
                    android:fontFamily="@font/gilroy_regular"
                    android:textColor="@color/text_black"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/tvDateValue"
                    app:layout_constraintHorizontal_weight=".3"
                    app:layout_constraintStart_toStartOf="@id/tvWeight"
                    app:layout_constraintTop_toBottomOf="@id/tvWeight"
                    tools:text="Sample Location" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:layout_marginEnd="@dimen/margin_small"
                    android:fontFamily="@font/gilroy_regular"
                    android:text="@string/date"
                    android:textColor="@color/text_black"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_weight=".3"
                    app:layout_constraintStart_toEndOf="@+id/tvWeight"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvDateValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/margin_small"
                    android:layout_marginBottom="@dimen/margin_medium"
                    android:fontFamily="@font/gilroy_regular"
                    android:textColor="@color/text_black"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_weight=".3"
                    app:layout_constraintStart_toStartOf="@id/tvDate"
                    app:layout_constraintTop_toBottomOf="@id/tvDate"
                    tools:text="Sample Location" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvWeightDispatch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:layout_marginEnd="@dimen/margin_small"
                    android:drawableEnd="@drawable/ic_right_arrow"
                    android:visibility="invisible"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvDateValue" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvGrade"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gilroy_regular"
                    android:text="@string/grade"
                    android:textColor="@color/text_black"
                    app:layout_constraintBottom_toBottomOf="@id/tvWeightDispatch"
                    app:layout_constraintHorizontal_weight="2"
                    app:layout_constraintStart_toStartOf="@id/tvPOTempIdValue"
                    app:layout_constraintTop_toTopOf="@id/tvWeightDispatch" />


                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvGradeValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/margin_small"
                    android:layout_marginBottom="@dimen/margin_small"
                    android:fontFamily="@font/gilroy_regular"
                    android:textColor="@color/text_black"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@id/tvPOTempIdValue"
                    app:layout_constraintTop_toBottomOf="@id/tvGrade"
                    tools:text="28-09-2020" />

                <View
                    android:id="@+id/vSplit"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/margin_padding_size_small"
                    android:background="@color/light_grey"
                    app:layout_constraintStart_toStartOf="@+id/tvGradeValue"
                    app:layout_constraintTop_toBottomOf="@+id/tvGradeValue" />

                <TextView
                    android:id="@+id/tvVendor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:fontFamily="@font/gilroy_regular"
                    android:text="@string/vendor"
                    android:textColor="@color/text_black"
                    app:layout_constraintStart_toStartOf="@+id/tvGradeValue"
                    app:layout_constraintTop_toBottomOf="@+id/vSplit" />

                <TextView
                    android:id="@+id/tvVendorValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:fontFamily="@font/gilroy_regular"
                    android:textColor="@color/text_black"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/tvVendor"
                    app:layout_constraintStart_toEndOf="@+id/tvVendor"
                    app:layout_constraintTop_toTopOf="@+id/tvVendor"
                    tools:text="@string/vendor" />

                <TextView
                    android:id="@+id/tvMaterial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_mic_small"
                    android:fontFamily="@font/gilroy_regular"
                    android:text="@string/material"
                    android:textColor="@color/text_black"
                    app:layout_constraintStart_toStartOf="@+id/tvVendor"
                    app:layout_constraintTop_toBottomOf="@+id/tvVendor" />

                <TextView
                    android:id="@+id/tvMaterialValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:fontFamily="@font/gilroy_regular"
                    android:textColor="@color/text_black"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/tvMaterial"
                    app:layout_constraintStart_toEndOf="@+id/tvMaterial"
                    app:layout_constraintTop_toTopOf="@+id/tvMaterial"
                    tools:text="cocoa material" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clErrorStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_small"
                    app:layout_constraintTop_toBottomOf="@+id/tvMaterial">

                    <TextView
                        android:id="@+id/tvError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_mic_small"
                        android:fontFamily="@font/gilroy_regular"
                        android:text="@string/sap_error_message"
                        android:textColor="@color/text_black"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvErrorValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_medium"
                        android:fontFamily="@font/gilroy_regular"
                        android:maxLines="1"
                        android:textColor="@color/text_black"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@+id/tvError"
                        app:layout_constraintStart_toEndOf="@+id/tvError"
                        app:layout_constraintTop_toTopOf="@+id/tvError"
                        tools:text="Inconsistant sap value updated" />

                    <TextView
                        android:id="@+id/tvReadMore"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_mic_small"
                        android:fontFamily="@font/gilroy_regular"
                        android:gravity="center_horizontal"
                        android:text="@string/read_more"
                        android:textColor="@color/blue_mic_dark"
                        app:layout_constraintTop_toBottomOf="@+id/tvError" />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>