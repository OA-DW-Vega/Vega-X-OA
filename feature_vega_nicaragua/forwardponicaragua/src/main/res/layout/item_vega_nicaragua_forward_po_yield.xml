<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="@color/white"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tvQualityNameApprove"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/gilroy_semibold"
        android:paddingStart="@dimen/margin_medium"
        android:paddingTop="@dimen/margin_very_small"
        android:paddingBottom="@dimen/margin_very_small"
        android:textColor="@color/dark_marun"
        android:textSize="@dimen/text_size_xmedium"
        android:maxLines="1"
        android:background="@drawable/rectangle_warm_white_border"
        app:layout_constraintEnd_toStartOf="@+id/tvUnitApprove"
        app:layout_constraintHorizontal_weight="1.8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="quality" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/tvUnitApprove"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/gilroy_semibold"
        android:padding="@dimen/margin_very_small"
        android:background="@drawable/rectangle_black_line_border"
        android:textColor="@color/dark_marun"
        android:textSize="@dimen/text_size_xmedium"
        android:maxLines="1"
        android:gravity="left"
        android:inputType="numberDecimal"
        app:layout_constraintBottom_toBottomOf="@+id/tvQualityNameApprove"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1.2"
        app:layout_constraintStart_toEndOf="@+id/tvQualityNameApprove"
        app:layout_constraintTop_toTopOf="@+id/tvQualityNameApprove" />

</androidx.constraintlayout.widget.ConstraintLayout>