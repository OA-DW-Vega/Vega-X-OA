<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryHeadOfi"
        android:fontFamily="@font/gilroy_regular"
        android:paddingStart="@dimen/margin_large"
        android:paddingTop="@dimen/margin_small"
        android:paddingEnd="@dimen/margin_large"
        android:paddingBottom="@dimen/margin_small"
        android:text="@string/mtnt_dispatch"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/btnProceed"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:paddingBottom="@dimen/margin_large"
            app:layout_constraintBottom_toTopOf="@+id/btnProceed"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title">

            <TextView
                android:id="@+id/tvTruckIDNo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:fontFamily="@font/gilroy_semibold"
                android:paddingStart="@dimen/margin_large"
                android:paddingEnd="@dimen/margin_small"
                android:text="@string/consignment_details"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_medium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clConsign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_medium"
                app:layout_constraintTop_toBottomOf="@id/tvTruckIDNo">

                <TextView
                    android:id="@+id/tvDest"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/layout_border_top_left_corner"
                    android:fontFamily="@font/gilroy_regular"
                    android:gravity="center"
                    android:text="@string/sending_plant"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/tvWhValue"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="@+id/tvWhValue"
                    app:layout_constraintTop_toTopOf="@+id/tvWhValue" />

                <TextView
                    android:id="@+id/tvWhValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rectangle_grey_border_top_right_corner"
                    android:drawableEnd="@drawable/ic_add_icon_new"
                    android:gravity="center"
                    android:padding="@dimen/margin_padding_size_medium"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/tvDest"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Sample" />


                <TextView
                    android:id="@+id/tvsto"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/shape_rect_grey_border"
                    android:fontFamily="@font/gilroy_regular"
                    android:gravity="center"
                    android:text="@string/sto_number_man"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/tvWhValue"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="@+id/tvstoValue"
                    app:layout_constraintTop_toTopOf="@+id/tvstoValue" />

                <TextView
                    android:id="@+id/tvstoValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rectangle_grey_border"
                    android:drawableEnd="@drawable/ic_add_icon_new"
                    android:gravity="center"
                    android:padding="@dimen/margin_padding_size_medium"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/tvsto"
                    app:layout_constraintTop_toBottomOf="@id/tvDest" />

                <TextView
                    android:id="@+id/tvMaterial"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/shape_rect_grey_border"
                    android:fontFamily="@font/gilroy_regular"
                    android:gravity="center"
                    android:text="@string/material"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/tvstoValue"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="@+id/tvMaterialValue"
                    app:layout_constraintTop_toTopOf="@+id/tvMaterialValue" />

                <TextView
                    android:id="@+id/tvMaterialValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rectangle_grey_border"
                    android:drawableEnd="@drawable/ic_add_icon_new"
                    android:gravity="center"
                    android:padding="@dimen/margin_padding_size_medium"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/tvMaterial"
                    app:layout_constraintTop_toBottomOf="@id/tvsto" />

                <TextView
                    android:id="@+id/tvStoQuantity"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:background="@drawable/shape_rect_grey_border"
                    android:fontFamily="@font/gilroy_regular"
                    android:gravity="center"
                    android:text="@string/sto_quantity"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/tvMaterialValue"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvMaterialValue" />

                <TextView
                    android:id="@+id/tvStoQuantityValue"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/rectangle_grey_border"
                    android:gravity="center"
                    android:padding="@dimen/margin_padding_size_medium"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    app:layout_constraintBottom_toBottomOf="@id/tvStoQuantity"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/tvStoQuantity"
                    app:layout_constraintTop_toTopOf="@id/tvStoQuantity" />

                <TextView
                    android:id="@+id/tvVendorName"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/layout_border_bottom_left_corner"
                    android:fontFamily="@font/gilroy_regular"
                    android:gravity="center"
                    android:text="@string/vendor_name"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@+id/tvVendorNameValue"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tvStoQuantityValue"
                    app:layout_constraintTop_toTopOf="@+id/tvVendorNameValue" />

                <TextView
                    android:id="@+id/tvVendorNameValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rectangle_grey_border_bottom_right_corner"
                    android:drawableEnd="@drawable/ic_add_icon_new"
                    android:gravity="center"
                    android:padding="@dimen/margin_padding_size_medium"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/tvVendorName"
                    app:layout_constraintTop_toBottomOf="@id/tvStoQuantity" />

                <TextView
                    android:id="@+id/tvQualityGrade"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/shape_rect_grey_border"
                    android:fontFamily="@font/gilroy_regular"
                    android:gravity="center"
                    android:text="@string/quality_grade"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/tvQualityGradeValue"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tvMaterialValue"
                    app:layout_constraintTop_toTopOf="@+id/tvQualityGradeValue" />

                <TextView
                    android:id="@+id/tvQualityGradeValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rectangle_grey_border"
                    android:drawableEnd="@drawable/ic_add_icon_new"
                    android:gravity="center"
                    android:padding="@dimen/margin_padding_size_medium"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/tvQualityGrade"
                    app:layout_constraintTop_toBottomOf="@id/tvVendorName" />

                <TextView
                    android:id="@+id/tvCertification"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:background="@drawable/shape_rect_grey_border"
                    android:fontFamily="@font/gilroy_regular"
                    android:gravity="center"
                    android:text="@string/certification1"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/tvQualityGradeValue"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvQualityGrade" />

                <TextView
                    android:id="@+id/tvCertificationValue"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/rectangle_grey_border"
                    android:drawableEnd="@drawable/ic_add_icon_new"
                    android:gravity="center"
                    android:padding="@dimen/margin_padding_size_medium"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    app:layout_constraintBottom_toBottomOf="@id/tvCertification"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/tvCertification"
                    app:layout_constraintTop_toTopOf="@id/tvCertification" />


                <!--<androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvMaterialList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    app:layout_constraintTop_toBottomOf="@id/tvsto"
                    tools:layout_height="180dp"
                    tools:listitem="@layout/item_material_layout" />-->

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tvTruckDetails"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_large"
                android:fontFamily="@font/gilroy_semibold"
                android:paddingStart="@dimen/margin_large"
                android:paddingEnd="@dimen/margin_small"
                android:text="@string/truck_details"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_medium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/clConsign" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clTruck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_medium"
                app:layout_constraintTop_toBottomOf="@id/tvTruckDetails">

                <TextView
                    android:id="@+id/tvTruckNo"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:background="@drawable/layout_border_top_left_corner"
                    android:fontFamily="@font/gilroy_regular"
                    android:gravity="center"
                    android:text="@string/truck_number"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/tvTruckNoValue"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/tvTruckNoValue"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/rectangle_grey_border_top_right_corner"
                    android:gravity="center"
                    android:padding="@dimen/margin_padding_size_medium"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    app:layout_constraintBottom_toBottomOf="@id/tvTruckNo"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/tvTruckNo"
                    app:layout_constraintTop_toTopOf="@id/tvTruckNo"
                    tools:text="Sample" />


                <TextView
                    android:id="@+id/tvDriverName"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:background="@drawable/shape_rect_grey_border"
                    android:fontFamily="@font/gilroy_regular"
                    android:gravity="center"
                    android:text="@string/driver_name"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/tvDriverNameValue"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTruckNo" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/tvDriverNameValue"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/rectangle_grey_border"
                    android:gravity="center"
                    android:padding="@dimen/margin_padding_size_medium"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    app:layout_constraintBottom_toBottomOf="@id/tvDriverName"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/tvDriverName"
                    app:layout_constraintTop_toTopOf="@id/tvDriverName"
                    tools:text="Sample" />

                <TextView
                    android:id="@+id/tvDriverNo"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:background="@drawable/shape_rect_grey_border"
                    android:fontFamily="@font/gilroy_regular"
                    android:gravity="center"
                    android:text="@string/phone_number"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/tvDriverNoValue"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvDriverName" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/tvDriverNoValue"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/rectangle_grey_border"
                    android:digits="1234567890"
                    android:gravity="center"
                    android:inputType="phone"
                    android:padding="@dimen/margin_padding_size_medium"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    android:imeOptions="actionDone"
                    app:layout_constraintBottom_toBottomOf="@id/tvDriverNo"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/tvDriverNo"
                    app:layout_constraintTop_toTopOf="@id/tvDriverNo"
                    tools:text="Sample" />

                <TextView
                    android:id="@+id/tvVendor"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/layout_border_bottom_left_corner"
                    android:fontFamily="@font/gilroy_regular"
                    android:gravity="center"
                    android:text="@string/transport_vendor"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/tvVendorValue"
                    app:layout_constraintEnd_toStartOf="@+id/tvVendorValue"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvVendorValue" />

                <TextView
                    android:id="@+id/tvVendorValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rectangle_grey_border_bottom_right_corner"
                    android:drawableEnd="@drawable/ic_add_icon_new"
                    android:gravity="center"
                    android:minHeight="60dp"
                    android:padding="@dimen/margin_padding_size_medium"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/tvVendor"
                    app:layout_constraintTop_toBottomOf="@id/tvDriverNo"
                    tools:text="Sample" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <Button
        android:id="@+id/btnProceed"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/colorPrimaryOfi"
        android:fontFamily="@font/gilroy_semibold"
        android:text="@string/proceed"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>