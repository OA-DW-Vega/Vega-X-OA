<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryHeadOfi"
        android:fontFamily="@font/gilroy_regular"
        android:padding="@dimen/margin_small"
        android:text="@string/dispatch_sales"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvLot"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:background="@color/orange"
        android:fontFamily="@font/gilroy_regular"
        android:gravity="center"
        android:padding="@dimen/margin_small"
        android:paddingStart="@dimen/margin_large"
        android:text="@string/truck_id"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/tv_lot_value"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title" />

    <TextView
        android:id="@+id/tv_lot_value"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@color/orange"
        android:fontFamily="@font/gilroy_semibold"
        android:gravity="center|start"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/tvLot"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvLot"
        app:layout_constraintTop_toTopOf="@id/tvLot"
        tools:text="109090" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/clNet"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvLot">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="@dimen/margin_medium">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clWeight"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingBottom="@dimen/margin_xlarge"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clMaterial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_medium"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvDefaultLotLbl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_medium"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:layout_marginEnd="@dimen/margin_medium"
                        android:fontFamily="@font/gilroy_semibold"
                        android:gravity="center_vertical"
                        android:text="@string/output_material"
                        android:textColor="@color/text_black"
                        android:textSize="@dimen/text_size_medium"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvMaterial"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_medium"
                        android:layout_marginTop="@dimen/margin_small"
                        android:layout_marginEnd="@dimen/margin_medium"
                        android:background="@drawable/border"
                        android:backgroundTint="@color/light_grey"
                        android:fontFamily="@font/gilroy_semibold"
                        android:gravity="center_vertical"
                        android:padding="@dimen/margin_medium"
                        android:textColor="@color/text_black"
                        android:textSize="@dimen/text_size_medium"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvDefaultLotLbl"
                        tools:text="18GD2345F4" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="@dimen/margin_xlarge"
                        android:background="@drawable/dotted"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvMaterial" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvGrossWeight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:fontFamily="@font/gilroy_semibold"
                    android:text="@string/gross_weight"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/clMaterial" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etWeight"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:background="@drawable/left_round_corner"
                    android:backgroundTint="@color/grey_lights"
                    android:gravity="center|start"
                    android:hint="@string/enter_weight"
                    android:inputType="numberDecimal"
                    android:paddingStart="@dimen/margin_small"
                    android:paddingEnd="@dimen/margin_mic_small"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_medium"
                    app:layout_constraintEnd_toStartOf="@+id/tvPullWeight"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="@id/tvGrossWeight"
                    app:layout_constraintTop_toBottomOf="@id/tvGrossWeight" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvWeightUOM"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/margin_small"
                    android:fontFamily="@font/gilroy_semibold"
                    android:gravity="center"
                    android:text="KG"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    app:layout_constraintBottom_toBottomOf="@id/etWeight"
                    app:layout_constraintEnd_toEndOf="@+id/etWeight"
                    app:layout_constraintTop_toTopOf="@id/etWeight" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivGrossWeight"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="@dimen/margin_small"
                    android:background="@drawable/do_circle_blue"
                    android:backgroundTint="@color/grey_button"
                    android:padding="@dimen/margin_mic_small"
                    android:src="@drawable/ic_close_white_24dp"
                    android:textSize="@dimen/text_size_xmedium"
                    android:tint="@color/white"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@id/etWeight"
                    app:layout_constraintEnd_toEndOf="@+id/etWeight"
                    app:layout_constraintTop_toTopOf="@id/etWeight" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvPullWeight"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_marginEnd="@dimen/margin_medium"
                    android:background="@drawable/right_round_corner"
                    android:backgroundTint="@color/dark_marun"
                    android:drawableStart="@drawable/ic_bluetooth_white"
                    android:gravity="center"
                    android:paddingStart="@dimen/margin_small"
                    android:paddingEnd="@dimen/margin_small"
                    android:text="@string/pull_weight"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_xmedium"
                    app:layout_constraintBottom_toBottomOf="@id/etWeight"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/etWeight"
                    app:layout_constraintTop_toTopOf="@id/etWeight" />

                <View
                    android:id="@+id/vi_dash"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="@dimen/margin_large"
                    android:background="@drawable/dash_line"
                    app:layout_constraintTop_toBottomOf="@id/etWeight" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvPack"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:fontFamily="@font/gilroy_semibold"
                    android:text="@string/packaging_material"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@id/tvGrossWeight"
                    app:layout_constraintTop_toBottomOf="@id/vi_dash" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvBagType"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/margin_small"
                    android:background="@color/grey_light"
                    android:fontFamily="@font/gilroy_semibold"
                    android:gravity="start|center"
                    android:paddingStart="@dimen/margin_medium"
                    android:paddingEnd="@dimen/margin_min"
                    android:text="@string/bag_type"
                    android:textColor="@color/text_black"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toStartOf="@+id/tvNoBags"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvPack" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvNoBags"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:background="@color/grey_light"
                    android:fontFamily="@font/gilroy_semibold"
                    android:gravity="start|center"
                    android:paddingStart="@dimen/margin_medium"
                    android:paddingEnd="@dimen/margin_min"
                    android:text="@string/no_of_bags"
                    android:textColor="@color/text_black"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="@id/tvBagType"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/tvBagType"
                    app:layout_constraintTop_toTopOf="@id/tvBagType" />


                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvSelectType"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:background="@drawable/rectangle_grey_border"
                    android:drawableEnd="@drawable/ic_add_icon_new"
                    android:fontFamily="@font/gilroy_semibold"
                    android:gravity="start|center"
                    android:hint="@string/select_type"
                    android:paddingStart="20dp"
                    android:paddingEnd="@dimen/margin_medium"
                    android:textColor="@color/text_black"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toStartOf="@+id/etNoBags"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvBagType" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etNoBags"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:background="@drawable/rectangle_grey_border"
                    android:fontFamily="@font/gilroy_semibold"
                    android:gravity="start|center"
                    android:hint="@string/enter_no_of_bags"
                    android:inputType="number"
                    android:maxLength="9"
                    android:paddingStart="20dp"
                    android:paddingEnd="@dimen/margin_min"
                    android:textColor="@color/text_black"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="@id/tvSelectType"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/tvSelectType"
                    app:layout_constraintTop_toTopOf="@id/tvSelectType" />


                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivCountClose"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="@dimen/margin_small"
                    android:background="@drawable/do_circle_blue"
                    android:backgroundTint="@color/grey_button"
                    android:padding="@dimen/margin_mic_small"
                    android:src="@drawable/ic_close_white_24dp"
                    android:textSize="@dimen/text_size_xmedium"
                    android:tint="@color/white"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@id/etNoBags"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/etNoBags" />


                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvNetWeight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_large"
                    android:fontFamily="@font/gilroy_semibold"
                    android:text="@string/net_weight"
                    android:textColor="@color/text_black"
                    app:layout_constraintStart_toStartOf="@id/tvGrossWeight"
                    app:layout_constraintTop_toBottomOf="@id/tvSelectType" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/etEnterWeight"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_marginTop="@dimen/margin_small"
                    android:layout_marginBottom="@dimen/margin_medium"
                    android:background="@drawable/layout_border"
                    android:gravity="start|center"
                    android:hint="@string/enter_weight"
                    android:inputType="numberDecimal"
                    android:padding="@dimen/margin_medium"
                    app:layout_constraintEnd_toEndOf="@id/tvPullWeight"
                    app:layout_constraintStart_toStartOf="@id/tvGrossWeight"
                    app:layout_constraintTop_toBottomOf="@id/tvNetWeight" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvNetWeightUOM"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/margin_medium"
                    android:layout_marginBottom="@dimen/margin_medium"
                    android:gravity="center"
                    android:paddingEnd="@dimen/margin_medium"
                    android:text="KG"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    app:layout_constraintBottom_toBottomOf="@id/etEnterWeight"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/etEnterWeight" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/clWeight">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btAddWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_medium"
                    android:background="@drawable/scanbale_corner"
                    android:backgroundTint="@color/dark_marun"
                    android:fontFamily="@font/gilroy_semibold"
                    android:gravity="center"
                    android:padding="@dimen/margin_medium"
                    android:text="@string/add_weight"
                    android:textAllCaps="true"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_xmedium"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivAdd"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="180dp"
                    android:backgroundTint="@color/white"
                    android:src="@drawable/ic_add_icon_new"
                    android:tint="@color/white"
                    app:layout_constraintBottom_toBottomOf="@id/btAddWeight"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/btAddWeight" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clBagHead"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_medium"
                    android:background="@drawable/layout_border_top_corner"
                    app:layout_constraintTop_toBottomOf="@+id/btAddWeight">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvSnoLbl"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/gilroy_semibold"
                        android:gravity="center|center_vertical"
                        android:paddingTop="@dimen/margin_small"
                        android:paddingBottom="@dimen/margin_small"
                        android:text="@string/s_no"
                        android:textColor="@color/text_black"
                        android:textSize="@dimen/text_size_xmedium"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@+id/tvBagLbl"
                        app:layout_constraintHorizontal_weight="1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvBagLbl"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/gilroy_semibold"
                        android:gravity="center"
                        android:paddingTop="@dimen/margin_small"
                        android:paddingBottom="@dimen/margin_small"
                        android:text="@string/bag"
                        android:textColor="@color/text_black"
                        android:textSize="@dimen/text_size_xmedium"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@+id/tvGrossWeightLbl"
                        app:layout_constraintHorizontal_weight="1"
                        app:layout_constraintStart_toEndOf="@+id/tvSnoLbl"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvGrossWeightLbl"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/gilroy_semibold"
                        android:gravity="center"
                        android:paddingTop="@dimen/margin_small"
                        android:paddingBottom="@dimen/margin_small"
                        android:text="@string/gross_n_weight"
                        android:textColor="@color/text_black"
                        android:textSize="@dimen/text_size_xmedium"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@+id/tvTarWeightLbl"
                        app:layout_constraintHorizontal_weight="2"
                        app:layout_constraintStart_toEndOf="@+id/tvBagLbl"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvTarWeightLbl"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/gilroy_semibold"
                        android:gravity="center"
                        android:paddingTop="@dimen/margin_small"
                        android:paddingBottom="@dimen/margin_small"
                        android:text="@string/tare_n_bag_pallet"
                        android:textColor="@color/text_black"
                        android:textSize="@dimen/text_size_xmedium"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@+id/tvNetWeightLbl"
                        app:layout_constraintHorizontal_weight="2.1"
                        app:layout_constraintStart_toEndOf="@+id/tvGrossWeightLbl"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvNetWeightLbl"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/gilroy_semibold"
                        android:gravity="center"
                        android:paddingTop="@dimen/margin_small"
                        android:paddingBottom="@dimen/margin_small"
                        android:text="@string/net_n_weight"
                        android:textColor="@color/text_black"
                        android:textSize="@dimen/text_size_xmedium"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@+id/ivEdit"
                        app:layout_constraintHorizontal_weight="2"
                        app:layout_constraintStart_toEndOf="@+id/tvTarWeightLbl"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivEdit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/ic_more_vert_black_24dp"
                        android:tint="@color/grey_lights"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_weight=".4"
                        app:layout_constraintTop_toTopOf="parent" />


                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:layout_marginEnd="@dimen/margin_medium"
                    android:layout_marginBottom="@dimen/margin_small"
                    android:paddingBottom="@dimen/margin_medium"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/clBagHead"
                    tools:listitem="@layout/item_vega_nic_mtnt_add_bag" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvNoWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:layout_marginEnd="@dimen/margin_medium"
                    android:layout_marginBottom="@dimen/margin_small"
                    android:background="@drawable/custom_edit_text"
                    android:gravity="center"
                    android:padding="@dimen/margin_large"
                    android:text="@string/no_weight_added"
                    android:textColor="@color/light_grey"
                    android:textSize="@dimen/text_size_medium"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/clBagHead" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/clNet"
        layout="@layout/layout_bottom_nicaragua_mtnt_weight_summary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@id/btProceed"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nsView" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btSave"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginEnd="2dp"
        android:background="@color/grey"
        android:fontFamily="@font/roboto_bold"
        android:gravity="center"
        android:text="@string/save"
        android:textColor="@android:color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btProceed"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btProceed"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@color/grey"
        android:fontFamily="@font/roboto_bold"
        android:gravity="center"
        android:text="@string/proceed"
        android:textColor="@android:color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/btSave" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivProceed"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="@color/white"
        android:contentDescription="@string/material"
        android:rotation="180"
        android:src="@drawable/ic_keyboard_backspace_black_24dp"
