<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryHeadOfi"
        android:fontFamily="@font/gilroy_regular"
        android:padding="@dimen/margin_small"
        android:paddingStart="@dimen/margin_large"
        android:paddingEnd="@dimen/margin_large"
        android:text="@string/mtn_t_add_lots_to_dispatch"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTruckIDNo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/orange"
        android:fontFamily="@font/gilroy_regular"
        android:paddingStart="@dimen/margin_large"
        android:paddingTop="@dimen/margin_small"
        android:paddingBottom="@dimen/margin_small"
        android:text="@string/truck_id"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        app:layout_constraintEnd_toStartOf="@id/tvTruckValue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title" />

    <TextView
        android:id="@+id/tvTruckValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/orange"
        android:fontFamily="@font/gilroy_regular"
        android:paddingStart="4dp"
        android:paddingTop="@dimen/margin_small"
        android:paddingEnd="@dimen/margin_small"
        android:paddingBottom="@dimen/margin_small"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/tvTruckIDNo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tvTruckIDNo"
        app:layout_constraintTop_toTopOf="@id/tvTruckIDNo"
        tools:text="19gdggfg" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/btnProceed"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTruckIDNo">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/margin_padding_size_small">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_regular"
                android:gravity="start|center"
                android:paddingStart="@dimen/margin_small"
                android:paddingEnd="4dp"
                android:text="@string/destination_wh"
                android:textColor="@color/text_black"
                app:layout_constraintEnd_toStartOf="@+id/tvStoNumber"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvStoNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_regular"
                android:gravity="start|center"
                android:paddingStart="@dimen/margin_small"
                android:paddingEnd="4dp"
                android:text="@string/sto_number"
                android:textColor="@color/text_black"
                app:layout_constraintBottom_toBottomOf="@id/tvDest"
                app:layout_constraintEnd_toStartOf="@+id/tvVendor"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tvDest"
                app:layout_constraintTop_toTopOf="@id/tvDest" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvVendor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_regular"
                android:gravity="start|center"
                android:paddingStart="@dimen/margin_small"
                android:paddingEnd="4dp"
                android:text="@string/vendor"
                android:textColor="@color/text_black"
                app:layout_constraintBottom_toBottomOf="@id/tvDest"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tvStoNumber"
                app:layout_constraintTop_toTopOf="@id/tvDest" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDestValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_semibold"
                android:gravity="start|center"
                android:paddingStart="@dimen/margin_small"
                android:paddingEnd="4dp"
                android:textColor="@color/text_black"
                app:layout_constraintEnd_toStartOf="@+id/tvStoNumberValue"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvDest"
                tools:text="WH4171" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvStoNumberValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_semibold"
                android:gravity="start|center"
                android:paddingStart="@dimen/margin_small"
                android:paddingEnd="4dp"
                android:textColor="@color/text_black"
                app:layout_constraintBottom_toBottomOf="@id/tvDestValue"
                app:layout_constraintEnd_toStartOf="@+id/tvVendorValue"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tvDestValue"
                app:layout_constraintTop_toTopOf="@id/tvDestValue"
                tools:text="SO00121232" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvVendorValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_semibold"
                android:gravity="start|center"
                android:paddingStart="@dimen/margin_small"
                android:paddingEnd="4dp"
                android:textColor="@color/text_black"
                app:layout_constraintBottom_toBottomOf="@id/tvDestValue"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tvStoNumberValue"
                app:layout_constraintTop_toTopOf="@id/tvDestValue"
                tools:text="vendor" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvMaterial"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_padding_size_small"
                android:fontFamily="@font/gilroy_regular"
                android:gravity="start|center"
                android:paddingStart="@dimen/margin_small"
                android:paddingEnd="4dp"
                android:text="@string/material_name"
                android:textColor="@color/text_black"
                app:layout_constraintEnd_toStartOf="@+id/tvStoWeight"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvDestValue" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvStoWeight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_regular"
                android:gravity="start|center"
                android:paddingStart="@dimen/margin_small"
                android:paddingEnd="4dp"
                android:text="@string/sto_weight"
                android:textColor="@color/text_black"
                app:layout_constraintBottom_toBottomOf="@id/tvMaterial"
                app:layout_constraintEnd_toStartOf="@+id/tvQualityGrade"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tvMaterial"
                app:layout_constraintTop_toTopOf="@id/tvMaterial" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvQualityGrade"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_regular"
                android:gravity="start|center"
                android:paddingStart="@dimen/margin_small"
                android:paddingEnd="4dp"
                android:text="@string/quality_grade1"
                android:textColor="@color/text_black"
                app:layout_constraintBottom_toBottomOf="@id/tvMaterial"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tvStoWeight"
                app:layout_constraintTop_toTopOf="@id/tvMaterial" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvMaterialValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_semibold"
                android:gravity="start|center"
                android:paddingStart="@dimen/margin_small"
                android:paddingEnd="4dp"
                android:paddingBottom="@dimen/margin_padding_size_small"
                android:textColor="@color/text_black"
                app:layout_constraintEnd_toStartOf="@+id/tvStoWeightValue"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvMaterial"
                tools:text="WH4171" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvStoWeightValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_semibold"
                android:gravity="start|center"
                android:paddingStart="@dimen/margin_small"
                android:paddingEnd="4dp"
                android:paddingBottom="@dimen/margin_padding_size_small"
                android:textColor="@color/text_black"
                app:layout_constraintBottom_toBottomOf="@id/tvMaterialValue"
                app:layout_constraintEnd_toStartOf="@+id/tvQualityGradeValue"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tvMaterialValue"
                app:layout_constraintTop_toTopOf="@id/tvMaterialValue"
                tools:text="SO00121232" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvQualityGradeValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_semibold"
                android:gravity="start|center"
                android:paddingStart="@dimen/margin_small"
                android:paddingEnd="4dp"
                android:paddingBottom="@dimen/margin_padding_size_small"
                android:textColor="@color/text_black"
                app:layout_constraintBottom_toBottomOf="@id/tvMaterialValue"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tvStoWeightValue"
                app:layout_constraintTop_toTopOf="@id/tvMaterialValue"
                tools:text="grade" />

            <!-- <androidx.recyclerview.widget.RecyclerView
                 android:id="@+id/rvMaterialList"
                 android:layout_width="0dp"
                 android:layout_height="wrap_content"
                 android:layout_margin="4dp"
                 android:visibility="gone"
                 android:layout_marginTop="@dimen/margin_small"
                 app:layout_constraintBottom_toTopOf="@id/clLotSummary"
                 app:layout_constraintEnd_toEndOf="parent"
                 app:layout_constraintStart_toStartOf="parent"
                 app:layout_constraintTop_toBottomOf="@id/tvDestValue"
                 tools:itemCount="3" />-->

            <include
                android:id="@+id/clLotSummary"
                layout="@layout/item_nic_include_add_lot_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvMaterialValue" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <Button
        android:id="@+id/btnProceed"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/colorPrimaryOfi"
        android:fontFamily="@font/gilroy_semibold"
        android:text="@string/proceed"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>