<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tvDenom"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:background="@drawable/shape_rect_grey_border"
        android:gravity="center"
        app:layout_constraintEnd_toStartOf="@+id/etDenomValue"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="1000 x" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:gravity="end"
        android:paddingEnd="@dimen/margin_large"
        android:text="X"
        app:layout_constraintBottom_toBottomOf="@+id/tvDenom"
        app:layout_constraintEnd_toStartOf="@+id/etDenomValue"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintTop_toTopOf="@+id/tvDenom" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etDenomValue"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:background="@drawable/shape_nic_rect_white_bg"
        android:gravity="center"
        android:inputType="number"
        app:layout_constraintBottom_toBottomOf="@id/tvDenom"
        app:layout_constraintEnd_toStartOf="@+id/tvTotalValue"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/tvDenom"
        app:layout_constraintTop_toTopOf="@id/tvDenom"
        tools:text="1000 x" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivClear"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="@dimen/margin_very_small"
        android:background="@drawable/do_circle_blue"
        android:backgroundTint="@color/grey"
        android:padding="@dimen/margin_mic_small"
        android:src="@drawable/ic_close_white_24dp"
        android:tint="@color/white"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/etDenomValue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tvTotalValue"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintTop_toTopOf="@id/etDenomValue" />

    <TextView
        android:id="@+id/tvTotalValue"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:background="@drawable/shape_rect_grey_border"
        android:gravity="end|center_vertical"
        android:paddingEnd="@dimen/margin_large"
        app:layout_constraintBottom_toBottomOf="@id/tvDenom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/etDenomValue"
        app:layout_constraintTop_toTopOf="@id/tvDenom"
        tools:text="1000 x" />

</androidx.constraintlayout.widget.ConstraintLayout>