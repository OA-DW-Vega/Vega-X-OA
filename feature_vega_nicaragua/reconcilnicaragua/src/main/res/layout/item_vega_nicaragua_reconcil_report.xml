<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TableLayout
        android:id="@+id/table_info1"
        android:layout_width="1400dp"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TableRow android:weightSum="7">

            <TextView
                android:id="@+id/tvSno"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight=".5"
                android:background="@drawable/rectangle_black_line_border"
                android:fontFamily="@font/roboto_bold"
                android:gravity="center"
                android:padding="@dimen/margin_padding_size_small"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_large"
                tools:text="@string/s_no" />

            <TextView
                android:id="@+id/tvDocType"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/rectangle_black_line_border"
                android:fontFamily="@font/roboto_bold"
                android:gravity="center"
                android:padding="@dimen/margin_padding_size_small"
                android:textColor="@color/transparent_black"
                android:textSize="@dimen/text_size_large"
                tools:text="@string/document_no" />

            <TextView
                android:id="@+id/tvMoveType"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/rectangle_black_line_border"
                android:fontFamily="@font/roboto_bold"
                android:gravity="center"
                android:padding="@dimen/margin_padding_size_small"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_large"
                tools:text="@string/movement_type" />

            <TextView
                android:id="@+id/tvVendor"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:background="@drawable/rectangle_black_line_border"
                android:fontFamily="@font/roboto_bold"
                android:gravity="center"
                android:padding="@dimen/margin_padding_size_small"
                android:maxLines="3"
                android:textColor="@color/transparent_black"
                android:textSize="@dimen/text_size_large"
                tools:text="@string/vendor" />

            <TextView
                android:id="@+id/tvQtyGrade"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.3"
                android:background="@drawable/rectangle_black_line_border"
                android:fontFamily="@font/roboto_bold"
                android:gravity="center"
                android:padding="@dimen/margin_padding_size_small"
                android:maxLines="3"
                android:textColor="@color/transparent_black"
                android:textSize="@dimen/text_size_large"
                tools:text="@string/quality_grade" />

            <TextView
                android:id="@+id/tvNetWeight"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/rectangle_black_line_border"
                android:fontFamily="@font/roboto_bold"
                android:gravity="end"
                android:padding="@dimen/margin_padding_size_small"
                android:textColor="@color/transparent_black"
                android:textSize="@dimen/text_size_large"
                tools:text="@string/net_weight" />

            <TextView
                android:id="@+id/NetAmt"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/rectangle_black_line_border"
                android:fontFamily="@font/roboto_bold"
                android:gravity="end"
                android:padding="@dimen/margin_padding_size_small"
                android:textColor="@color/transparent_black"
                android:textSize="@dimen/text_size_large"
                tools:text="@string/net_amount" />
        </TableRow>
    </TableLayout>

</androidx.constraintlayout.widget.ConstraintLayout>