<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/margin_medium"
        android:text="@string/sync_details"
        android:textColor="@color/text_black"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold" />
    <LinearLayout
        android:id="@+id/typeSelection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tvClose"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPlantSync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/plant"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:background="@color/colorPrimaryOfi1"
            android:padding="@dimen/margin_padding_size_small"/>

        <TextView
            android:id="@+id/tvMaterialSync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/material"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@color/grey_light"
            android:padding="@dimen/margin_padding_size_small"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/grey_lit"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPlant"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="@dimen/margin_very_small"
            android:text="@string/plantid"
            android:textColor="@color/text_black"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:gravity="center"
            android:padding="@dimen/margin_very_small"
            android:text="@string/last_sync_time"
            android:textColor="@color/text_black"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="@dimen/margin_very_small"
            android:text="@string/sync_status"
            android:textColor="@color/text_black"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSyncDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:listitem="@layout/item_vega_nic_inventory_sync_details" />

</LinearLayout>