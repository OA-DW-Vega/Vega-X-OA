<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cvLotDetail"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/margin_padding_size_small"
    android:background="@color/white"
    app:cardCornerRadius="4dp">

    <TextView
        android:id="@+id/tvQualityParms"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="@dimen/layout_width"
        android:text="@string/quality_params"
        android:textColor="@color/blue_mic_dark"
        android:visibility="gone" />

    <CheckBox
        android:id="@+id/cbLotCard"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="end"
        android:layout_marginStart="16dp"
        android:layout_marginTop="-8dp" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_toEndOf="@+id/cbSelectStocks"
        android:padding="@dimen/margin_padding_size_small">

        <TextView
            android:id="@+id/tv_lot_name_lbl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_mic_small"
            android:layout_marginTop="@dimen/margin_mic_small"
            android:fontFamily="@font/gilroy_regular"
            android:text="@string/lot_name"
            android:textColor="@color/text_black"
            android:textSize="@dimen/text_size_xmedium"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_lot_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:textColor="@color/text_black"
            android:textSize="@dimen/text_size_xmedium"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tv_material_name"
            app:layout_constraintStart_toStartOf="@id/tv_lot_name_lbl"
            app:layout_constraintTop_toBottomOf="@id/tv_lot_name_lbl"
            tools:ignore="RelativeOverlap,RtlSymmetry"
            tools:text="Inventory_01" />

        <TextView
            android:id="@+id/tv_material_lbl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_padding_size_small"
            android:layout_marginTop="@dimen/margin_mic_small"
            android:layout_marginEnd="5dp"
            android:fontFamily="@font/gilroy_regular"
            android:text="@string/material_name"
            android:textColor="@color/text_black"
            android:textSize="@dimen/text_size_xmedium"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tv_lot_name_lbl"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_lot_name_lbl" />

        <TextView
            android:id="@+id/tv_material_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_padding_size_small"
            android:textColor="@color/text_black"
            android:textSize="@dimen/text_size_xmedium"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tv_lot_name"
            app:layout_constraintEnd_toEndOf="@id/tv_material_lbl"
            app:layout_constraintTop_toTopOf="@id/tv_lot_name"
            tools:text="sample text for my material data " />

        <TextView
            android:id="@+id/tv_quality_grade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/gilroy_regular"
            android:text="@string/quality_grade"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/tv_lot_name_lbl"
            app:layout_constraintTop_toBottomOf="@id/tv_lot_name" />


        <TextView
            android:id="@+id/tv_moisure_lable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gilroy_regular"
            android:text="broken_beans"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/tv_quality_grade"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tv_certificate"
            app:layout_constraintTop_toTopOf="@id/tv_quality_grade" />


        <TextView
            android:id="@+id/tv_certificate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gilroy_regular"
            android:text="@string/certificate"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tv_quality_grade"
            app:layout_constraintEnd_toStartOf="@id/tv_moisure_lable"
            app:layout_constraintStart_toEndOf="@id/tv_quality_grade"
            app:layout_constraintTop_toTopOf="@id/tv_quality_grade" />


        <TextView
            android:id="@+id/tv_quality_grade_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gilroy_semibold"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/tv_lot_name_lbl"
            app:layout_constraintTop_toBottomOf="@id/tv_quality_grade"
            tools:text="LBA_001" />


        <TextView
            android:id="@+id/tv_moisure_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gilroy_semibold"
            android:text="8%"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/tv_quality_grade_value"
            app:layout_constraintStart_toStartOf="@id/tv_moisure_lable"
            app:layout_constraintTop_toTopOf="@id/tv_quality_grade_value" />


        <TextView
            android:id="@+id/tv_certificate_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gilroy_semibold"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tv_quality_grade_value"
            app:layout_constraintStart_toStartOf="@id/tv_certificate"
            app:layout_constraintTop_toTopOf="@id/tv_quality_grade_value"
            tools:text="Sample" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/margin_padding_size_small"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_quality_grade_value">

            <TextView
                android:id="@+id/tv_weight_lbl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_mic_small"
                android:layout_marginTop="@dimen/margin_mic_small"
                android:fontFamily="@font/gilroy_regular"
                android:text="@string/weight"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_xmedium"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/tvStoLoc"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_weight_data"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_xmedium"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@+id/tv_weight_lbl"
                app:layout_constraintTop_toBottomOf="@+id/tv_weight_lbl"
                tools:ignore="RelativeOverlap,RtlSymmetry"
                tools:text="Inventory_01" />

            <TextView
                android:id="@+id/tvStoLoc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_mic_small"
                android:fontFamily="@font/gilroy_regular"
                android:text="@string/st_location"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_xmedium"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/tvDateLbl"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@+id/tv_weight_lbl"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvStoLocValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_xmedium"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@+id/tvStoLoc"
                app:layout_constraintTop_toBottomOf="@id/tvStoLoc"
                tools:ignore="RelativeOverlap,RtlSymmetry"
                tools:text="Inventory_01" />

            <TextView
                android:id="@+id/tvDateLbl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginTop="@dimen/margin_mic_small"
                android:fontFamily="@font/gilroy_regular"
                android:text="@string/date"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_xmedium"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/tv_weight_lbl"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@+id/tvStoLoc" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_xmedium"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@+id/tvDateLbl"
                app:layout_constraintTop_toBottomOf="@id/tvDateLbl"
                tools:ignore="RelativeOverlap,RtlSymmetry"
                tools:text="Inventory_01" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>