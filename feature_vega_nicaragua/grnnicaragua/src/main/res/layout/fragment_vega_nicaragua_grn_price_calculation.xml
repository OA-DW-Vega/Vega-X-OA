                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/advanceLineItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:splitMotionEvents="false"
                android:visibility="gone"
                tools:listitem="@layout/item_vega_nicaragua_grn_advance_line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/action_bar_height"
                android:layout_margin="@dimen/margin_mic_small"
                android:layout_marginBottom="@dimen/margin_large"
                android:background="@color/grey_dark"
                android:gravity="center"
                android:paddingTop="@dimen/margin_small"
                android:paddingBottom="@dimen/margin_small"
                android:weightSum="2">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:layout_weight="1"
                    android:fontFamily="@font/gt_walsheim_pro_bold"
                    android:text="@string/final_payment"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/TvFinalPayment"
                    android:layout_width="@dimen/nav_header_height"
                    android:layout_height="match_parent"
                    android:layout_marginRight="@dimen/margin_medium"
                    android:layout_weight="1"
                    android:fontFamily="@font/gt_walsheim_pro_bold"
                    android:gravity="right"
                    android:inputType="text"
                    android:text="C$ 0.00"
                    android:textColor="@color/white" />
            </LinearLayout>
        </LinearLayout>


    </ScrollView>

    <Button
        android:id="@+id/btnProceed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_centerInParent="true"
        android:background="@color/colorPrimaryOfi"
        android:paddingTop="@dimen/margin_medium"
        android:paddingBottom="@dimen/margin_medium"
        android:text="@string/confirm"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium" />

</RelativeLayout>
