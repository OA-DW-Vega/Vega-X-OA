<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingDefaultResource"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:background="@color/warm_white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/action_bar_height"
        android:layout_gravity="center"
        android:background="@color/colorPrimaryHeadOfi"
        android:gravity="center"
        android:id="@+id/header"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:paddingTop="@dimen/margin_small"
        android:paddingBottom="@dimen/margin_small">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="@dimen/action_bar_height"
            android:background="@color/colorPrimaryOfi"
            android:gravity="start"
            android:padding="@dimen/margin_small"
            android:fontFamily="@font/gt_walsheim_pro_regular"
            android:text="@string/advancing"
            android:textColor="@color/warm_white"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold" />
    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:layout_below="@+id/header"
        android:id="@+id/advanceInfoLayout"
        android:orientation="vertical">
        <TextView
            android:id="@+id/vendorName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:layout_marginTop="@dimen/margin_medium"
            android:fontFamily="@font/roboto_bold"
            android:text="Vendor name"
            android:layout_marginLeft="@dimen/margin_medium"
            android:layout_marginRight="@dimen/margin_small"
            android:layout_marginBottom="@dimen/margin_medium"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_large"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="3"
            android:gravity="center"
            android:layout_marginLeft="@dimen/margin_medium"
            android:layout_marginRight="@dimen/margin_small"
            android:orientation="horizontal"
            >
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:layout_weight="1"
                android:fontFamily="@font/roboto_medium"
                android:text="@string/credit_limit"
                android:layout_margin="@dimen/margin_mic_small"
                android:textColor="@color/transparent_black"
                android:textSize="@dimen/text_size_small"
                />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:layout_weight="1"
                android:fontFamily="@font/roboto_medium"
                android:text="@string/exchange_rate_per"
                android:layout_margin="@dimen/margin_mic_small"
                android:textColor="@color/transparent_black"
                android:textSize="@dimen/text_size_small"
                 />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:layout_weight="1"
                android:fontFamily="@font/roboto_medium"
                android:text="@string/available_limit"
                android:layout_margin="@dimen/margin_mic_small"
                android:textColor="@color/transparent_black"
                android:textSize="@dimen/text_size_small"
               />

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="3"
            android:layout_gravity="center"
            android:layout_marginLeft="@dimen/margin_medium"
            android:layout_marginRight="@dimen/margin_small"
            android:layout_marginBottom="@dimen/margin_large"
            android:orientation="horizontal"
            >
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:layout_weight="1"
                android:fontFamily="@font/roboto_bold"
                android:text="NA"
                android:id="@+id/tvCreditLimit"
                android:layout_margin="@dimen/margin_mic_small"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_small"
                />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:layout_weight="1"
                android:fontFamily="@font/roboto_bold"
                android:text="NA"
                android:id="@+id/tvExchangeRate"
                android:layout_margin="@dimen/margin_mic_small"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_small"
                />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:layout_weight="1"
                android:fontFamily="@font/roboto_bold"
                android:text="NA"
                android:id="@+id/tvAvailableLimit"
                android:layout_margin="@dimen/margin_mic_small"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_small"
                />

        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        android:id="@+id/requestAdvanceAmountLayout"
        android:layout_below="@+id/advanceInfoLayout"
        >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_medium"
            android:fontFamily="@font/gt_walsheim_pro_bold"
            android:text="@string/request_advance_amount_cs"
            android:textColor="@color/grey_dark"
            android:layout_weight="1"
            android:id="@+id/requestAdvanceAmountHeader"
            android:layout_marginBottom="@dimen/margin_small"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/requestAdvanceAmount"
            style="@style/App_EditTextStyle"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/margin_mic_small"
            android:layout_marginRight="@dimen/margin_large"
            android:fontFamily="@font/gt_walsheim_pro_bold"
            android:inputType="numberDecimal"
            android:textColor="@color/black"
            android:text="" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        android:id="@+id/tenureDaysLayout"
        android:layout_below="@+id/requestAdvanceAmountLayout"
        >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_medium"
            android:fontFamily="@font/gt_walsheim_pro_bold"
            android:text="@string/tenure_in_days"
            android:textColor="@color/grey_dark"
            android:layout_weight="1"
            android:textSize="@dimen/text_size_medium"
            android:id="@+id/tenureInDaysHeader"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/tenureInDays"
            style="@style/App_EditTextStyle"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:layout_weight="1"
            android:maxLength="3"
            android:layout_marginRight="@dimen/margin_large"
            android:fontFamily="@font/gt_walsheim_pro_bold"
            android:inputType="number"
            android:textColor="@color/black"
            android:text="" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        android:id="@+id/promissoryNumberLayout"
        android:layout_below="@+id/tenureDaysLayout"
        >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_medium"
            android:fontFamily="@font/gt_walsheim_pro_bold"
            android:text="@string/promissory_number"
            android:textColor="@color/grey_dark"
            android:layout_weight="1"
            android:id="@+id/promissoryNumberHeader"
            android:layout_marginBottom="@dimen/margin_small"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/promissoryNumber"
            style="@style/App_EditTextStyle"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/margin_mic_small"
            android:layout_marginRight="@dimen/margin_large"
            android:fontFamily="@font/gt_walsheim_pro_bold"
            android:inputType="text"
            android:maxLength="16"
            android:textColor="@color/black"
            android:text="" />
    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_medium"
        android:id="@+id/maturityDateLayout"
        android:gravity="center_horizontal"
        android:visibility="gone"
        android:layout_below="@+id/promissoryNumberLayout"
        >

        <TextView
            android:id="@+id/maturityDaysHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="@dimen/margin_mic_small"
            android:layout_marginTop="@dimen/margin_mic_small"
            android:layout_marginEnd="@dimen/margin_mic_small"
            android:layout_weight="1"
            android:fontFamily="@font/roboto_medium"
            android:gravity="center_horizontal"
            android:text="@string/maturity_days"
            android:textColor="@color/transparent_black"
            android:textSize="@dimen/text_size_small" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:id="@+id/maturityDate"
            android:layout_below="@+id/maturityDaysHeader"
            android:fontFamily="@font/roboto_bold"
            android:text="3000"
            android:gravity="center_horizontal"
            android:layout_marginStart="@dimen/margin_mic_small"
            android:layout_marginTop="@dimen/margin_mic_small"
            android:layout_marginEnd="@dimen/margin_mic_small"
            android:textColor="@color/black"
            android:textSize="@dimen/margin_medium"
            />
    </RelativeLayout>
    <Button
        android:id="@+id/btnProceed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_centerInParent="true"
        android:background="@color/grey"
        android:paddingTop="@dimen/margin_medium"
        android:paddingBottom="@dimen/margin_medium"
        android:text="@string/confirm"
        android:enabled="false"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium" />
</RelativeLayout>