<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tvQualityGRNNameApprove"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/gt_walsheim_pro_bold"
        android:paddingStart="@dimen/margin_medium"
        android:paddingTop="@dimen/margin_very_small"
        android:paddingBottom="@dimen/margin_very_small"
        android:textColor="@color/dark_marun"
        android:textSize="@dimen/text_size_xmedium"
        app:layout_constraintEnd_toStartOf="@+id/tvQualityValue"
        app:layout_constraintHorizontal_weight="1.8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="@string/quality" />

    <TextView
        android:id="@+id/tvQualityValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/gt_walsheim_pro_bold"
        android:padding="@dimen/margin_very_small"
        android:textColor="@color/dark_marun"
        android:textSize="@dimen/text_size_xmedium"
        app:layout_constraintBottom_toBottomOf="@+id/tvQualityGRNNameApprove"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1.2"
        app:layout_constraintStart_toEndOf="@+id/tvQualityGRNNameApprove"
        app:layout_constraintTop_toTopOf="@+id/tvQualityGRNNameApprove"
        tools:text="10 %" />

</androidx.constraintlayout.widget.ConstraintLayout>