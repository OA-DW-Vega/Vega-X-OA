<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_white"
    android:clickable="true">

    <TextView
        android:id="@+id/tvHeadPoDetail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:fontFamily="@font/gilroy_regular"
        android:gravity="center_vertical"
        android:padding="@dimen/margin_small"
        android:paddingStart="@dimen/margin_large"
        android:paddingEnd="@dimen/margin_large"
        android:text="@string/fgrn_drying"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/orange"
        android:elevation="@dimen/margin_small"
        app:cardElevation="@dimen/margin_small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvHeadPoDetail">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/orange"
            android:paddingTop="@dimen/margin_very_small"
            android:paddingBottom="@dimen/margin_very_small">


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvMaterial"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/gilroy_regular"
                android:gravity="start|center"
                android:paddingStart="@dimen/margin_small"
                android:paddingEnd="@dimen/margin_mic_small"
                android:text="@string/material"
                android:textColor="@color/white"
                app:layout_constraintEnd_toStartOf="@+id/tvStage"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvStage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_regular"
                android:gravity="start|center"
                android:paddingStart="@dimen/margin_small"
                android:paddingEnd="@dimen/margin_min"
                android:text="@string/stage"
                android:textColor="@color/white"
                app:layout_constraintBottom_toBottomOf="@id/tvMaterial"
                app:layout_constraintEnd_toStartOf="@+id/tvProcees"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tvMaterial"
                app:layout_constraintTop_toTopOf="@id/tvMaterial" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvProcees"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_regular"
                android:gravity="start|center"
                android:paddingStart="@dimen/margin_min"
                android:paddingEnd="@dimen/margin_small"
                android:text="@string/weight_to_process"
                android:textColor="@color/white"
                app:layout_constraintBottom_toTopOf="@+id/tvMaterialValue"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tvStage"
                app:layout_constraintTop_toTopOf="@id/tvMaterial"
                app:layout_constraintVertical_bias="1.0" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvMaterialValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_semibold"
                android:gravity="start|center"
                android:paddingStart="@dimen/margin_small"
                android:paddingEnd="@dimen/margin_min"
                android:textColor="@color/white"
                app:layout_constraintEnd_toStartOf="@+id/tvStage"
                app:layout_constraintStart_toStartOf="@id/tvMaterial"
                app:layout_constraintTop_toBottomOf="@id/tvMaterial"
                tools:text="Description" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvStageValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_semibold"
                android:gravity="start|center"
                android:paddingStart="@dimen/margin_small"
                android:paddingEnd="@dimen/margin_min"
                android:textColor="@color/white"
                app:layout_constraintEnd_toStartOf="@+id/tvProcees"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tvMaterialValue"
                app:layout_constraintTop_toTopOf="@id/tvMaterialValue"
                tools:text="Drying"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvProceesValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_semibold"
                android:gravity="start|center"
                android:paddingStart="@dimen/margin_min"
                android:paddingEnd="@dimen/margin_small"
                android:textColor="@color/white"
                app:layout_constraintBottom_toBottomOf="@+id/tvPoNo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toEndOf="@+id/tvStageValue"
                app:layout_constraintTop_toTopOf="@id/tvPoNo"
                app:layout_constraintVertical_bias="1.0"
                tools:text="1000 Kg" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPoNo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/gilroy_regular"
                android:gravity="start|center"
                android:paddingStart="@dimen/margin_small"
                android:paddingEnd="@dimen/margin_min"
                android:text="Po Number"
                android:textColor="@color/white"
                app:layout_constraintEnd_toEndOf="@+id/tvPoNoValue"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvMaterialValue" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPoNoValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_semibold"
                android:gravity="start|center"
                android:paddingStart="@dimen/margin_small"
                android:paddingEnd="@dimen/margin_min"
                android:textColor="@color/white"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvPoNo"
                tools:text="PO 123445434634634" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tv_list"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/gilroy_semibold"
        android:text=" RMIN -  Tickets  Summary "
        android:textColor="@color/text_black"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPoList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="@dimen/margin_medium"
            android:layout_marginEnd="16dp"
            android:visibility="visible"
            app:layout_constraintBottom_toTopOf="@id/tvCreateNewFgrn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_list"
            tools:listitem="@layout/item_lot_summary" />


    <TextView
        android:id="@+id/tvNoData"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:text="@string/no_data_found"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tv_list"
        app:layout_constraintTop_toBottomOf="@id/tv_list"
        tools:visibility="gone" />

    <Button
        android:id="@+id/tvCreateNewFgrn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/grey"
        android:focusable="true"
        android:gravity="center"
        android:padding="@dimen/margin_medium"
        android:text="@string/proceed"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>