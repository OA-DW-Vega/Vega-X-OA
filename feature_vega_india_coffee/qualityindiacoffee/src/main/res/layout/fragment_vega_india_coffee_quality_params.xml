<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="92"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimaryHeadOfi"
            android:paddingTop="@dimen/margin_small"
            android:paddingBottom="@dimen/margin_small">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:fontFamily="@font/gt_walsheim_pro_regular"
                android:text="@string/qty_assesment"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/orange"
            android:paddingTop="@dimen/margin_small"
            android:paddingBottom="@dimen/margin_small">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_padding_size_small"
                android:fontFamily="@font/gt_walsheim_pro_regular"
                android:maxLines="1"
                android:text="@string/truck_no"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvParamsWeighBID"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_weight="1.2"
                android:ellipsize="end"
                android:fontFamily="@font/gt_walsheim_pro_bold"
                android:maxLines="1"
                android:text="@string/test_str"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFilter"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/margin_medium"
                android:layout_weight=".4"
                android:gravity="end"
                android:text="@string/sort_by_im"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/light_grey"
            android:paddingTop="@dimen/margin_small"
            android:paddingBottom="@dimen/margin_small">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:fontFamily="@font/gt_walsheim_pro_bold"
                android:text="@string/batch_no"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etBatchNo"
                style="@style/App_EditTextStyle"
                android:layout_width="@dimen/nav_header_height"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/text_size_medium"
                android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890"
                android:fontFamily="@font/gt_walsheim_pro_bold"
                android:gravity="center"
                android:inputType="text"
                android:maxLength="10"
                tools:ignore="Autofill,LabelFor"
                tools:text="0063464890" />

        </LinearLayout>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/ia_padding_10"
    android:layout_marginTop="@dimen/margin_mic_small"
    >
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btAssignLot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/scanbale_corner"
        android:backgroundTint="@color/dark_marun"
        android:fontFamily="@font/gt_walsheim_pro_bold"
        android:gravity="center"
        android:layout_gravity="left"
        android:padding="@dimen/margin_medium"
        android:text="Assign LOT"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        android:visibility="gone"
        />
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvNewLot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:text="@string/new_lot"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:visibility="gone"
        />

</LinearLayout>

        <FrameLayout
            android:id="@+id/flAssignLot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:visibility="gone"
            >
            <include
                android:id="@+id/icAssignLotCard"
                layout="@layout/item_vega_india_coffee_mtnr_lot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_mic_small" />
        </FrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBagDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/llItemBottomView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="8"
        android:gravity="bottom"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnParamsProceed"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/colorPrimaryOfi"
            android:text="@string/proceed"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_medium"
            android:visibility="visible" />

    </LinearLayout>

    <!--    <Button-->
    <!--        android:id="@+id/btnParamsProceed"-->
    <!--        android:layout_width="match_parent"-->
    <!--        android:layout_height="0dp"-->
    <!--        android:layout_weight="8"-->
    <!--        android:background="@color/colorPrimaryOfi"-->
    <!--        android:text="@string/proceed"-->
    <!--        android:textColor="@android:color/white"-->
    <!--        android:textSize="@dimen/text_size_medium"-->
    <!--        android:textStyle="bold" />-->

</LinearLayout>