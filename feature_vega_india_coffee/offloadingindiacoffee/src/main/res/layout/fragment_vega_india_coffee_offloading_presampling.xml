<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryHeadOfi"
        android:orientation="horizontal"
        android:padding="@dimen/text_size_medium">

        <TextView
            android:id="@+id/truck_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gilroy_regular"
            android:text="@string/offloading_presampling"
            android:textColor="@color/warm_white"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:textColor="@color/warm_white"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvTruckID"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/orange"
        android:padding="@dimen/text_size_medium"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        tools:text="Truck Id:123123875348573" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="90">


        <LinearLayout
            android:id="@+id/llItemView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margin_padding_size_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_medium"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBatchNoLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/gilroy_semibold"
                    android:gravity="start|center"
                    android:textColor="@color/text_black"
                    android:text="@string/batch_number"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etBatchNo"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/custom_edit_text"
                    android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890"
                    android:fontFamily="@font/gilroy_regular"
                    android:importantForAutofill="no"
                    android:inputType="textCapCharacters"
                    android:maxLength="10"
                    android:paddingStart="@dimen/margin_very_small"
                    android:paddingEnd="@dimen/margin_very_small"
                    tools:ignore="LabelFor" />

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingTop="@dimen/margin_padding_size_medium"
                    android:paddingBottom="@dimen/margin_padding_size_medium"
                    android:paddingEnd="@dimen/margin_padding_size_medium">

                    <TextView
                        android:id="@+id/tvSelectBagTypeLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/select_bag_type"
                        android:fontFamily="@font/gilroy_semibold"
                        android:gravity="start|center"
                        android:textColor="@color/text_black"
                        android:textSize="@dimen/text_size_medium" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSelectBagType"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:layout_weight="1"
                    android:fontFamily="@font/gilroy_regular"
                    android:background="@drawable/rectangle_grey_border_bottom_right_corner"
                    android:padding="@dimen/margin_padding_size_medium"
                    android:textSize="@dimen/text_size_medium" />
            </LinearLayout>

             <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:paddingTop="@dimen/margin_padding_size_medium"
                    android:paddingBottom="@dimen/margin_padding_size_medium"
                    android:paddingEnd="@dimen/margin_padding_size_medium">

                    <TextView
                        android:id="@+id/tvAcceptedBagsLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/accepted_bags"
                        android:fontFamily="@font/gilroy_semibold"
                        android:gravity="start|center"
                        android:textColor="@color/text_black"
                        android:textSize="@dimen/text_size_medium" />
                </LinearLayout>
                 <EditText
                     android:id="@+id/tvAcceptedBags"
                     android:layout_width="0dp"
                     android:layout_height="match_parent"
                     android:layout_gravity="start"
                     android:layout_weight="1"
                     android:gravity="center"
                     android:inputType="number"
                     android:fontFamily="@font/gilroy_regular"
                     android:background="@drawable/rectangle_grey_border_bottom_right_corner"
                     android:padding="@dimen/margin_padding_size_medium"
                     android:textSize="@dimen/text_size_medium" />
             </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:paddingTop="@dimen/margin_padding_size_medium"
                    android:paddingBottom="@dimen/margin_padding_size_medium"
                    android:paddingEnd="@dimen/margin_padding_size_medium">

                    <TextView
                        android:id="@+id/tvDamagedBagsLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/damaged_bags"
                        android:fontFamily="@font/gilroy_semibold"
                        android:gravity="start|center"
                        android:textColor="@color/text_black"
                        android:textSize="@dimen/text_size_medium" />
                </LinearLayout>
                <EditText
                    android:id="@+id/tvDamagedBags"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:inputType="number"
                    android:fontFamily="@font/gilroy_regular"
                    android:background="@drawable/rectangle_grey_border_bottom_right_corner"
                    android:padding="@dimen/margin_padding_size_medium"
                    android:textSize="@dimen/text_size_medium" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:paddingTop="@dimen/margin_padding_size_medium"
                    android:paddingBottom="@dimen/margin_padding_size_medium"
                    android:paddingEnd="@dimen/margin_padding_size_medium">

                    <TextView
                        android:id="@+id/tvTotalBagsLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/total_bags"
                        android:fontFamily="@font/gilroy_semibold"
                        android:gravity="start|center"
                        android:textColor="@color/text_black"
                        android:textSize="@dimen/text_size_medium" />
                </LinearLayout>
                <EditText
                    android:id="@+id/tvTotalBags"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:inputType="none"
                    android:enabled="false"
                    android:background="@drawable/layout_border_rectangle"
                    android:fontFamily="@font/gilroy_regular"
                    android:padding="@dimen/margin_padding_size_medium"
                    android:textSize="@dimen/text_size_medium" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/margin_small"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingTop="@dimen/margin_padding_size_medium"
                    android:paddingBottom="@dimen/margin_padding_size_medium"
                    android:paddingEnd="@dimen/margin_padding_size_medium">

                    <TextView
                        android:id="@+id/tvSelectLotToMergeLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/select_lot_to_merge"
                        android:fontFamily="@font/gilroy_semibold"
                        android:gravity="start|center"
                        android:textColor="@color/text_black"
                        android:textSize="@dimen/text_size_medium" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSelectLotToMerge"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:layout_weight="1"
                    android:fontFamily="@font/gilroy_regular"
                    android:background="@drawable/rectangle_grey_border_bottom_right_corner"
                    android:drawableEnd="@drawable/ic_add_icon_new"
                    android:padding="@dimen/margin_padding_size_medium"
                    android:textSize="@dimen/text_size_medium"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/llItemBottomView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btnReject"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:layout_weight="1"
            android:background="@color/red"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:drawableStart="@drawable/ic_cancel"
                android:drawablePadding="@dimen/margin_medium"
                android:gravity="center"
                android:padding="@dimen/margin_medium"
                android:text="@string/reject"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
                tools:ignore="ButtonStyle" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnAccept"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/colorPrimaryOfi"
            android:visibility="gone"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableEnd="@drawable/ic_arrow_forward_black_24dp"
                android:drawablePadding="@dimen/margin_medium"
                android:drawableTint="@color/white"
                android:padding="@dimen/margin_medium"
                android:text="@string/accept"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
                tools:ignore="ButtonStyle,UnusedAttribute" />
        </LinearLayout>

        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/colorPrimaryOfi"
            android:text="@string/next"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_medium"
            tools:ignore="ButtonStyle" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvNoData"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/no_data_found"
        android:textColor="@color/warmgrey"
        android:visibility="gone" />

</LinearLayout>