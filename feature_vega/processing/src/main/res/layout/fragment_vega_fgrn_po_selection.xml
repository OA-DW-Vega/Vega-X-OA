<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">


    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/layout_width"
        android:background="@color/colorPrimaryOfi"
        android:fontFamily="@font/gilroy_regular"
        android:gravity="center|start"
        android:paddingStart="@dimen/margin_medium"
        android:paddingEnd="0dp"
        android:text="@string/fgrn_drying"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/orange_light"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gilroy_regular"
            android:paddingStart="@dimen/margin_medium"
            android:paddingEnd="0dp"
            android:text="@string/po_number_label"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold" />


        <TextView
            android:id="@+id/tvPono"
            android:layout_width="match_parent"
            android:layout_height="@dimen/layout_width"
            android:fontFamily="@font/gilroy_semibold"
            android:gravity="center|start"
            android:paddingStart="@dimen/margin_medium"
            android:paddingEnd="0dp"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            tools:text="123456789" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/margin_small"
        android:layout_weight="8.5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOutputMaterialLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:fontFamily="@font/gilroy_semibold"
                android:paddingStart="@dimen/activity_horizontal_margin"
                android:paddingEnd="0dp"
                android:text="@string/output_material"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_xmedium" />

            <TextView
                android:id="@+id/tvOutputMaterial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_medium"
                android:background="@drawable/rectangle_grey_border"
                android:fontFamily="@font/gilroy_semibold"
                android:padding="@dimen/margin_medium"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_xmedium"
                android:textStyle="bold"
                tools:text="1242314234" />

            <TextView
                android:id="@+id/etWeightLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:fontFamily="@font/gilroy_semibold"
                android:paddingStart="@dimen/activity_horizontal_margin"
                android:paddingEnd="0dp"
                android:text="@string/weight"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_xmedium" />

            <EditText
                android:id="@+id/etWeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_medium"
                android:autofillHints=""
                android:background="@drawable/rectangle_grey_border"
                android:digits="0123456789."
                android:fontFamily="@font/gilroy_semibold"
                android:hint="@string/enter_weight"
                android:imeOptions="actionNext"
                android:inputType="numberDecimal"
                android:padding="@dimen/margin_medium"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_xmedium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/etNoOfBagsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:fontFamily="@font/gilroy_semibold"
                android:paddingStart="@dimen/activity_horizontal_margin"
                android:paddingEnd="0dp"
                android:text="@string/no_bags"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_medium" />

            <EditText
                android:id="@+id/etNoOfBags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_medium"
                android:background="@drawable/rectangle_grey_border"
                android:digits="0123456789"
                android:fontFamily="@font/gilroy_semibold"
                android:hint="@string/enter_no_of_bags"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:padding="@dimen/margin_medium"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_xmedium"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/tvLocationLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:fontFamily="@font/gilroy_semibold"
                android:paddingStart="@dimen/activity_horizontal_margin"
                android:paddingEnd="0dp"
                android:text="@string/select_storage_location"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_xmedium" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_medium"
                android:background="@drawable/border"
                android:padding="@dimen/margin_mic_small">

                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/spLocation"
                    style="@style/Widget.AppCompat.Spinner"
                    android:layout_width="match_parent"
                    android:layout_height="49dp"
                    android:backgroundTint="@color/black"
                    android:dropDownWidth="1000dp"
                    android:dropDownHeight="150dp"
                    android:fontFamily="@font/gilroy_semibold"
                    android:hint="@string/enter_type_of_bag"
                    android:popupBackground="@color/white"
                    android:spinnerMode="dropdown"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <Button
        android:id="@+id/btnProceed"
        android:layout_width="match_parent"
        android:layout_height="@dimen/layout_width"
        android:background="@color/colorPrimaryOfi"
        android:fontFamily="@font/roboto_bold"
        android:text="@string/proceed"
        android:textColor="@android:color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold" />

</LinearLayout>
