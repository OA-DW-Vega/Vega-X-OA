<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:background="@color/warm_white"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:orientation="vertical">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimaryOfi"
            android:fontFamily="@font/gt_walsheim_pro_regular"
            android:gravity="start"
            android:padding="@dimen/margin_small"
            android:text="@string/rmin_summary"
            android:textColor="@color/warm_white"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/orange"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBatchNolabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gt_walsheim_pro_regular"
                android:gravity="start"
                android:paddingStart="@dimen/margin_small"
                android:paddingTop="@dimen/margin_small"
                android:paddingEnd="0dp"
                android:paddingBottom="@dimen/margin_small"
                android:text="@string/batch_number_label"
                android:textColor="@color/warm_white"
                android:textSize="@dimen/text_size_xmedium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBatchNo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/gt_walsheim_pro_bold"
                android:gravity="start"
                android:paddingStart="0dp"
                android:paddingTop="@dimen/margin_small"
                android:paddingEnd="@dimen/margin_small"
                android:paddingBottom="@dimen/margin_small"
                android:textColor="@color/warm_white"
                android:textSize="@dimen/text_size_xmedium"
                android:textStyle="bold"
                tools:text="103834573247598342" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical"
                android:paddingTop="@dimen/margin_medium"
                android:paddingBottom="@dimen/margin_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:fontFamily="@font/gt_walsheim_pro_bold"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/margin_medium"
                        android:text="@string/date_label"
                        android:textColor="@color/transparent_black"
                        android:textSize="@dimen/text_size_xmedium"
                        android:textStyle="bold"
                        tools:ignore="RelativeOverlap,RtlSymmetry" />


                    <TextView
                        android:id="@+id/tvDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/gt_walsheim_pro_bold"
                        android:gravity="end"
                        android:paddingStart="@dimen/margin_medium"
                        android:paddingEnd="@dimen/margin_medium"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_size_xmedium"
                        android:textStyle="bold"
                        tools:ignore="RelativeOverlap,RtlSymmetry"
                        tools:text="12/02/2020" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:fontFamily="@font/gt_walsheim_pro_bold"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/margin_medium"
                        android:text="@string/weight_to_process"
                        android:textColor="@color/transparent_black"
                        android:textSize="@dimen/text_size_xmedium"
                        android:textStyle="bold"
                        tools:ignore="RelativeOverlap,RtlSymmetry" />

                    <TextView
                        android:id="@+id/tvWeight"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/gt_walsheim_pro_bold"
                        android:gravity="end"
                        android:paddingStart="@dimen/margin_medium"
                        android:paddingEnd="@dimen/text_size_xmedium"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_size_xmedium"
                        android:textStyle="bold"
                        tools:ignore="RelativeOverlap,RtlSymmetry"
                        tools:text="1000 Kg" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:fontFamily="@font/gt_walsheim_pro_bold"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/margin_medium"
                        android:text="@string/material_name"
                        android:textColor="@color/transparent_black"
                        android:textSize="@dimen/text_size_xmedium"
                        android:textStyle="bold"
                        tools:ignore="RelativeOverlap,RtlSymmetry" />

                    <TextView
                        android:id="@+id/tvMaterialName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/gt_walsheim_pro_bold"
                        android:gravity="end"
                        android:paddingStart="@dimen/margin_medium"
                        android:paddingEnd="@dimen/margin_medium"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_size_xmedium"
                        android:textStyle="bold"
                        tools:ignore="RelativeOverlap,RtlSymmetry"
                        tools:text="IVC CASEW" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:fontFamily="@font/gt_walsheim_pro_bold"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/margin_medium"
                        android:text="@string/bom_number"
                        android:textColor="@color/transparent_black"
                        android:textSize="@dimen/text_size_xmedium"
                        android:textStyle="bold"
                        tools:ignore="RelativeOverlap,RtlSymmetry" />

                    <TextView
                        android:id="@+id/tvBomNo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/gt_walsheim_pro_bold"
                        android:gravity="end"
                        android:paddingStart="@dimen/margin_medium"
                        android:paddingEnd="@dimen/margin_medium"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_size_xmedium"
                        android:textStyle="bold"
                        tools:ignore="RelativeOverlap,RtlSymmetry"
                        tools:text="12345" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/warm_white"
            android:orientation="vertical"
            android:padding="@dimen/margin_small"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:paddingStart="@dimen/margin_small"
                android:paddingTop="@dimen/margin_small"
                android:paddingEnd="@dimen/margin_small"
                android:paddingBottom="@dimen/margin_small"
                android:text="@string/retained_lots"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/margin_medium"
                    android:paddingBottom="@dimen/margin_medium">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/action_bar_height"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:paddingStart="@dimen/margin_medium"
                            android:text="@string/batch_number"
                            android:textColor="@color/transparent_black"
                            android:textSize="@dimen/text_size_medium"
                            android:textStyle="bold"
                            tools:ignore="RelativeOverlap,RtlSymmetry" />

                        <TextView
                            android:id="@+id/tvLotId"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:paddingStart="@dimen/margin_medium"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_size_medium"
                            android:textStyle="bold"
                            tools:ignore="RelativeOverlap,RtlSymmetry"
                            tools:text="18GRBD140" />


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:paddingStart="@dimen/margin_medium"
                            android:text="@string/origin"
                            android:textColor="@color/transparent_black"
                            android:textSize="@dimen/text_size_medium"
                            android:textStyle="bold"
                            tools:ignore="RelativeOverlap,RtlSymmetry" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:paddingStart="@dimen/margin_medium"
                            android:text="@string/kor"
                            android:textColor="@color/transparent_black"
                            android:textSize="@dimen/text_size_medium"
                            android:textStyle="bold"
                            tools:ignore="RelativeOverlap,RtlSymmetry" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:paddingStart="@dimen/margin_medium"
                            android:text="@string/weight"
                            android:textColor="@color/transparent_black"
                            android:textSize="@dimen/text_size_medium"
                            android:textStyle="bold"
                            tools:ignore="RelativeOverlap,RtlSymmetry" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_small"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:paddingStart="@dimen/margin_medium"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_size_medium"
                            android:textStyle="bold"
                            tools:ignore="RelativeOverlap,RtlSymmetry"
                            tools:text="Bouake" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:paddingStart="@dimen/margin_medium"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_size_medium"
                            android:textStyle="bold"
                            tools:ignore="RelativeOverlap,RtlSymmetry"
                            tools:text="45" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:paddingStart="@dimen/margin_medium"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_size_medium"
                            android:textStyle="bold"
                            tools:ignore="RelativeOverlap,RtlSymmetry"
                            tools:text="2400 Kg" />

                    </LinearLayout>
                </LinearLayout>

            </androidx.cardview.widget.CardView>


        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnConfim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:background="@color/colorPrimaryOfi"
        android:paddingTop="@dimen/margin_medium"
        android:paddingBottom="@dimen/margin_medium"
        android:text="@string/confirm"
        android:fontFamily="@font/roboto_bold"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium" />

</RelativeLayout>