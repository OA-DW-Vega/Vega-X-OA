<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cvLotDetail"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/margin_padding_size_small"
    android:background="@color/white"
    app:cardCornerRadius="4dp">

    <TextView
        android:id="@+id/divideView"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        tools:background="@color/green" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_toEndOf="@+id/cbSelectStocks"
        android:padding="@dimen/margin_padding_size_small">

        <TextView
            android:id="@+id/tv_lot_name_lbl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_mic_small"
            android:layout_marginTop="@dimen/margin_mic_small"
            android:fontFamily="@font/gilroy_regular"
            android:text="@string/lot_name"
            android:textColor="@color/text_black"
            android:textSize="@dimen/text_size_xmedium"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_lot_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:textColor="@color/text_black"
            android:textSize="@dimen/text_size_xmedium"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tv_material_name"
            app:layout_constraintStart_toStartOf="@id/tv_lot_name_lbl"
            app:layout_constraintTop_toBottomOf="@id/tv_lot_name_lbl"
            tools:ignore="RelativeOverlap,RtlSymmetry"
            tools:text="Inventory_01" />

        <TextView
            android:id="@+id/tv_material_lbl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_mic_small"
            android:layout_marginEnd="5dp"
            android:fontFamily="@font/gilroy_regular"
            android:text="@string/material_name"
            android:textColor="@color/text_black"
            android:textSize="@dimen/text_size_xmedium"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tv_lot_name_lbl"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_lot_name_lbl" />

        <TextView
            android:id="@+id/tv_material_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_black"
            android:textSize="@dimen/text_size_xmedium"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tv_lot_name"
            app:layout_constraintEnd_toEndOf="@id/tv_material_lbl"
            app:layout_constraintTop_toTopOf="@id/tv_lot_name"
            tools:text="sample text for my material data " />

        <TextView
            android:id="@+id/tv_kor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/gilroy_regular"
            android:text="@string/kor"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/tv_lot_name_lbl"
            app:layout_constraintTop_toBottomOf="@id/tv_lot_name" />

        <TextView
            android:id="@+id/tv_weight_lbl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gilroy_regular"
            android:text="@string/weight"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tv_kor"
            app:layout_constraintEnd_toEndOf="@id/tv_material_lbl"
            app:layout_constraintTop_toTopOf="@id/tv_kor" />

        <TextView
            android:id="@+id/tv_moisure_lable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gilroy_regular"
            android:text="@string/moisure"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tv_kor"
            app:layout_constraintEnd_toStartOf="@id/tv_weight_lbl"
            app:layout_constraintStart_toEndOf="@id/orgin_lable"
            app:layout_constraintTop_toTopOf="@id/tv_kor" />


        <TextView
            android:id="@+id/orgin_lable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gilroy_regular"
            android:text="@string/orgin"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tv_kor"
            app:layout_constraintEnd_toStartOf="@id/tv_moisure_lable"
            app:layout_constraintStart_toEndOf="@id/tv_kor"
            app:layout_constraintTop_toTopOf="@id/tv_kor" />


        <TextView
            android:id="@+id/tv_kor_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gilroy_semibold"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/tv_lot_name_lbl"
            app:layout_constraintTop_toBottomOf="@id/tv_kor"
            tools:text="LBA_001" />

        <TextView
            android:id="@+id/tv_weight_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gilroy_semibold"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tv_kor_value"
            app:layout_constraintEnd_toEndOf="@id/tv_material_lbl"
            app:layout_constraintTop_toTopOf="@id/tv_kor_value"
            tools:text="2500.00 KG" />

        <TextView
            android:id="@+id/tv_moisure_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gilroy_semibold"
            android:text="8%"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tv_kor_value"
            app:layout_constraintStart_toStartOf="@id/tv_moisure_lable"
            app:layout_constraintTop_toTopOf="@id/tv_kor_value" />


        <TextView
            android:id="@+id/orgin_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gilroy_semibold"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tv_kor_value"
            app:layout_constraintStart_toStartOf="@id/orgin_lable"
            app:layout_constraintTop_toTopOf="@id/tv_kor_value"
            tools:text="Sample" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>