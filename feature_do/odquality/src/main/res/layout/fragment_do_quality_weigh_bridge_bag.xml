<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/top_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryHeadOfi"
        android:paddingTop="@dimen/margin_small"
        android:paddingBottom="@dimen/margin_small">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_medium"
            android:text="@string/select_qr"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llQualityOffline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/marun"
        android:orientation="horizontal"
        android:layout_below="@+id/top_layout"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            android:padding="@dimen/text_size_medium"
            android:text="@string/quality_offline_list"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:contentDescription="@string/back_navigation"
            android:src="@drawable/ic_right_arrow"
            android:tint="@color/white" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvWeighbridge"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/top_layout"
        android:layout_above="@+id/btnNewBagForSample"
        tools:listitem="@layout/item_do_quality_weigh_bridge_bag" />

    <TextView
        android:id="@+id/tvNoData"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_data"
        android:layout_centerInParent="true"
        android:textSize="@dimen/text_size_large"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnNewBagForSample"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/btnSave"
        android:layout_centerHorizontal="true"
        android:paddingEnd="@dimen/ia_margin_10"
        android:paddingStart="@dimen/ia_margin_10"
        android:layout_marginBottom="@dimen/ia_margin_10"
        android:textColor="@android:color/white"
        android:textAllCaps="false"
        android:background="@color/dark_green"
        android:backgroundTint="@color/dark_marun"
        android:text="@string/new_bag" />

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:textColor="@android:color/white"
        android:background="@color/colorPrimaryOfi"
        android:text="@string/save" />

</RelativeLayout>