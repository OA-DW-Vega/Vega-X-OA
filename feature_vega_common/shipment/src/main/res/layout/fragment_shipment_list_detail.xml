<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_white"
    android:clickable="true"
    android:focusable="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/margin_medium"
        android:background="@color/grey_lit"
        app:layout_constraintTop_toBottomOf="@+id/tv_sort"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:paddingBottom="@dimen/margin_medium">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvAllocatedId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/gilroy_regular"
            android:gravity="start|center"
            android:paddingStart="@dimen/margin_small"
            android:paddingEnd="@dimen/margin_min"
            android:text="@string/allocation_id"
            android:textColor="@color/grey"
            app:layout_constraintEnd_toStartOf="@+id/tvAllocatedWt"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvAllocatedWt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gilroy_regular"
            android:gravity="start|center"
            android:paddingStart="@dimen/margin_small"
            android:paddingEnd="@dimen/margin_min"
            android:text="@string/allocation_weight"
            android:textColor="@color/grey"
            app:layout_constraintBottom_toBottomOf="@id/tvAllocatedId"
            app:layout_constraintEnd_toStartOf="@+id/tvApprove"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/tvAllocatedId"
            app:layout_constraintTop_toTopOf="@id/tvAllocatedId" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvApprove"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gilroy_regular"
            android:gravity="start|center"
            android:paddingStart="@dimen/margin_small"
            android:paddingEnd="@dimen/margin_min"
            android:text="@string/approve"
            android:textColor="@color/grey"
            app:layout_constraintBottom_toBottomOf="@id/tvAllocatedId"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/tvAllocatedWt"
            app:layout_constraintTop_toTopOf="@id/tvAllocatedId" />



        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvAllocatedWtValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gilroy_semibold"
            android:gravity="start|center"
            android:paddingStart="@dimen/margin_small"
            android:paddingEnd="@dimen/margin_min"
            android:textColor="@color/text_black"
            app:layout_constraintBottom_toBottomOf="@id/tvAllocatedIdValue"
            app:layout_constraintEnd_toEndOf="@id/tvAllocatedWt"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="@id/tvAllocatedWt"
            app:layout_constraintTop_toTopOf="@id/tvAllocatedIdValue"
            tools:text="12 MT" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvAllocatedIdValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:fontFamily="@font/gilroy_semibold"
            android:gravity="start|center"
            android:paddingStart="@dimen/margin_small"
            android:paddingEnd="@dimen/margin_min"
            android:textColor="@color/text_black"
            app:layout_constraintEnd_toEndOf="@id/tvAllocatedId"
            app:layout_constraintEnd_toStartOf="@+id/tvAllocatedWt"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintHorizontal_weight="2"
            app:layout_constraintStart_toStartOf="@id/tvAllocatedId"
            app:layout_constraintTop_toBottomOf="@id/tvAllocatedId"
            tools:text="32345" />


        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvApproveValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gilroy_semibold"
            android:gravity="start|center"
            android:paddingStart="@dimen/margin_small"
            android:paddingEnd="@dimen/margin_min"
            android:textColor="@color/text_black"
            app:layout_constraintBottom_toBottomOf="@id/tvAllocatedIdValue"
            app:layout_constraintEnd_toEndOf="@id/tvApprove"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="@id/tvApprove"
            app:layout_constraintTop_toTopOf="@id/tvAllocatedIdValue"
            tools:text="8 MT" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryHeadOfi"
        android:fontFamily="@font/gilroy_regular"
        android:gravity="start"
        android:paddingStart="@dimen/margin_large"
        android:paddingTop="@dimen/margin_small"
        android:paddingEnd="4dp"
        android:paddingBottom="@dimen/margin_small"
        android:text="@string/title"
        android:textColor="@color/warm_white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_total"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@drawable/layout_border_with_down"
        android:fontFamily="@font/gilroy_semibold"
        android:gravity="center"
        android:paddingBottom="10dp"
        android:text="@string/total_lots"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:visibility="visible"
        app:layout_constraintEnd_toStartOf="@+id/tv_sort"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <TextView
        android:id="@+id/tv_sort"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:background="#D2CECC"
        android:fontFamily="@font/gilroy_semibold"
        android:gravity="center"
        android:text="@string/sort_by"
        android:textColor="#6C5D56"
        android:textSize="16sp"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_total"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle" />


    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivFilter"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="@dimen/margin_xlarge"
        android:contentDescription="@string/tv_filter"
        android:src="@drawable/ic_sort_grey"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@id/tv_sort"
        app:layout_constraintEnd_toEndOf="@id/tv_sort"
        app:layout_constraintTop_toTopOf="@id/tv_sort" />



    <TextView
        android:id="@+id/tvSubTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/gilroy_semibold"
        android:gravity="start"
        android:paddingStart="@dimen/margin_large"
        android:paddingEnd="4dp"
        android:text="@string/tv_inventory"
        android:layout_marginTop="@dimen/margin_medium"
        android:textColor="@color/black"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_container" />

    <TextView
        android:id="@+id/tvSelectAll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/gilroy_regular"
        android:text="@string/tvSelectAll"
        android:textSize="@dimen/text_size_medium"
        android:layout_marginEnd="@dimen/margin_very_small"
        app:layout_constraintBottom_toBottomOf="@+id/cb_select"
        app:layout_constraintTop_toTopOf="@+id/cb_select"
        android:textColor="@color/grey"
        app:layout_constraintEnd_toStartOf="@+id/cb_select" />

    <CheckBox
        android:id="@+id/cb_select"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvSubTitle"
        app:layout_constraintBottom_toBottomOf="@+id/tvSubTitle" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvInventoryBalance"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="visible"
        tools:listitem="@layout/item_app_reject_list"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="@dimen/action_bar_height"
        app:layout_constraintTop_toBottomOf="@+id/cb_select" />


    <Button
        android:id="@+id/btnProceed"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/grey_light"
        android:fontFamily="@font/gilroy_semibold"
        android:text="@string/proceed"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>