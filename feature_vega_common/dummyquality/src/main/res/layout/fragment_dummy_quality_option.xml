<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/activity_vertical_margin"
        android:layout_marginTop="@dimen/margin_large"
        android:layout_marginEnd="@dimen/activity_vertical_margin"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/linearCaptureQuality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/margin_min"
            android:layout_marginTop="@dimen/activity_vertical_margin"
            android:layout_marginEnd="@dimen/margin_min"
            android:background="@drawable/custom_edit_text"
            android:orientation="horizontal"
            android:weightSum="10">

            <View
                android:layout_width="@dimen/margin_padding_size_zero"
                android:layout_height="match_parent"
                android:layout_weight=".4"
                android:background="@drawable/left_round_corner_port" />

            <TextView
                android:layout_width="@dimen/margin_padding_size_zero"
                android:layout_height="wrap_content"
                android:layout_weight="7.6"
                android:fontFamily="@font/gilroy_regular"
                android:padding="@dimen/margin_padding_size_medium"
                android:text="Capture quality"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="@dimen/margin_padding_size_zero"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_weight="2"
                android:padding="@dimen/margin_small"
                android:src="@drawable/ic_right_arrow_port" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearViewQuality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/margin_min"
            android:layout_marginTop="@dimen/margin_xlarge"
            android:layout_marginEnd="@dimen/margin_min"
            android:background="@drawable/custom_edit_text"
            android:orientation="horizontal"
            android:weightSum="10">

            <View
                android:layout_width="@dimen/margin_padding_size_zero"
                android:layout_height="match_parent"
                android:layout_weight=".4"
                android:background="@drawable/left_round_corner_port" />

            <TextView
                android:layout_width="@dimen/margin_padding_size_zero"
                android:layout_height="wrap_content"
                android:layout_weight="7.6"
                android:fontFamily="@font/gilroy_regular"
                android:padding="@dimen/margin_padding_size_medium"
                android:text="View Quality "
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="@dimen/margin_padding_size_zero"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_weight="2"
                android:padding="@dimen/margin_small"
                android:src="@drawable/ic_right_arrow_port" />

        </LinearLayout>

    </LinearLayout>
</LinearLayout>