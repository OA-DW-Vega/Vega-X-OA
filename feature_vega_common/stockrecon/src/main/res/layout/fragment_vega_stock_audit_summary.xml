<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:ignore="MissingConstraints">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryHeadOfi"
        android:fontFamily="@font/gt_walsheim_pro_regular"
        android:padding="@dimen/margin_small"
        android:text="@string/stock_audit_summary"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_large"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/tvProceed"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvLotValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorPrimaryOfi1"
                android:fontFamily="@font/gt_walsheim_pro_regular"
                android:padding="@dimen/margin_small"
                android:text=""
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clAuditDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:paddingTop="15dp"
                android:paddingBottom="15dp"
                app:layout_constraintTop_toBottomOf="@id/tvLotValue">

                <TextView
                    android:id="@+id/tvMaterialLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gt_walsheim_pro_bold"
                    android:gravity="center"
                    android:text="@string/material"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_size_medium"
                    app:layout_constraintEnd_toStartOf="@+id/tvSystemWeightLabel"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tvMaterialValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_very_small"
                    android:fontFamily="@font/gt_walsheim_pro_bold"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold"
                    android:gravity="center"
                    app:layout_constraintLeft_toLeftOf="@id/tvMaterialLabel"
                    app:layout_constraintRight_toRightOf="@id/tvMaterialLabel"
                    app:layout_constraintTop_toBottomOf="@id/tvMaterialLabel" />

                <TextView
                    android:id="@+id/tvSystemWeightLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gt_walsheim_pro_bold"
                    android:text="@string/system_weight"
                    android:gravity="center"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_size_medium"
                    app:layout_constraintEnd_toStartOf="@+id/tvBagTypeLabel"
                    app:layout_constraintStart_toEndOf="@+id/tvMaterialLabel" />

                <TextView
                    android:id="@+id/tvSystemWeightValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_very_small"
                    android:fontFamily="@font/gt_walsheim_pro_bold"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold"
                    android:gravity="center"
                    app:layout_constraintLeft_toLeftOf="@id/tvSystemWeightLabel"
                    app:layout_constraintRight_toRightOf="@id/tvSystemWeightLabel"
                    app:layout_constraintTop_toBottomOf="@id/tvSystemWeightLabel" />

                <TextView
                    android:id="@+id/tvBagTypeLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gt_walsheim_pro_bold"
                    android:text="@string/bag_type"
                    android:gravity="center"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_size_medium"
                    app:layout_constraintEnd_toStartOf="@id/tvWeightLossLabel"
                    app:layout_constraintStart_toEndOf="@+id/tvSystemWeightLabel" />

                <TextView
                    android:id="@+id/tvBagTypeValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_very_small"
                    android:fontFamily="@font/gt_walsheim_pro_bold"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold"
                    android:gravity="center"
                    app:layout_constraintLeft_toLeftOf="@id/tvBagTypeLabel"
                    app:layout_constraintRight_toRightOf="@id/tvBagTypeLabel"
                    app:layout_constraintTop_toBottomOf="@id/tvBagTypeLabel" />

                <TextView
                    android:id="@+id/tvWeightLossLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gt_walsheim_pro_bold"
                    android:text="@string/wt_gain_loss"
                    android:gravity="center"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_size_medium"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tvWeightLossValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_very_small"
                    android:fontFamily="@font/gt_walsheim_pro_bold"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold"
                    android:gravity="center"
                    app:layout_constraintLeft_toLeftOf="@id/tvWeightLossLabel"
                    app:layout_constraintRight_toRightOf="@id/tvWeightLossLabel"
                    app:layout_constraintTop_toBottomOf="@id/tvWeightLossLabel" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:id="@+id/dot_view1"
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_very_small"
                android:layout_marginTop="@dimen/margin_medium"
                android:background="@drawable/dotted"
                app:layout_constraintTop_toBottomOf="@id/clAuditDetails" />


            <TextView
                android:id="@+id/tvBagsCountLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gt_walsheim_pro_regular"
                android:padding="@dimen/margin_small"
                android:text="@string/no_of_bags"
                android:textColor="@color/grey"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/dot_view1" />

            <TextView
                android:id="@+id/tvBagsCountValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gt_walsheim_pro_regular"
                android:padding="@dimen/margin_small"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dot_view1" />

            <TextView
                android:id="@+id/tvFullBagsCountLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gt_walsheim_pro_regular"
                android:padding="@dimen/margin_small"
                android:text="@string/count_of_full_bags"
                android:textColor="@color/grey"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/tvBagsCountLabel" />

            <TextView
                android:id="@+id/tvFullBagsCountValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gt_walsheim_pro_regular"
                android:padding="@dimen/margin_small"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvBagsCountLabel" />

            <TextView
                android:id="@+id/tvHalfBagsCountLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gt_walsheim_pro_regular"
                android:padding="@dimen/margin_small"
                android:text="@string/count_of_half_bags"
                android:textColor="@color/grey"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/tvFullBagsCountLabel" />

            <TextView
                android:id="@+id/tvHalfBagsCountValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gt_walsheim_pro_regular"
                android:padding="@dimen/margin_small"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvFullBagsCountLabel" />

            <View
                android:id="@+id/dot_view2"
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_very_small"
                android:layout_marginTop="@dimen/margin_medium"
                android:background="@drawable/dotted"
                app:layout_constraintTop_toBottomOf="@id/tvHalfBagsCountLabel" />

            <TextView
                android:id="@+id/tvBagDamagedLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gt_walsheim_pro_regular"
                android:padding="@dimen/margin_small"
                android:text="@string/bag_damaged"
                android:textColor="@color/grey"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/dot_view2" />

            <TextView
                android:id="@+id/tvDamagedBagCountValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gt_walsheim_pro_regular"
                android:padding="@dimen/margin_small"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvBagDamagedLabel" />

            <TextView
                android:id="@+id/tvDamagedBagCountlabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gt_walsheim_pro_regular"
                android:padding="@dimen/margin_small"
                android:text="@string/no_of_damaged_bag"
                android:textColor="@color/grey"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/tvBagDamagedLabel" />

            <TextView
                android:id="@+id/tvDamagedBagValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gt_walsheim_pro_regular"
                android:padding="@dimen/margin_small"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dot_view2" />

            <TextView
                android:id="@+id/tvSpillageLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gt_walsheim_pro_regular"
                android:padding="@dimen/margin_small"
                android:text="@string/spillage"
                android:textColor="@color/grey"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/tvDamagedBagCountlabel" />

            <TextView
                android:id="@+id/tvSpillageValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gt_walsheim_pro_regular"
                android:padding="@dimen/margin_small"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvDamagedBagCountValue" />

            <View
                android:id="@+id/dot_view3"
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_very_small"
                android:layout_marginTop="@dimen/margin_medium"
                android:background="@drawable/dotted"
                app:layout_constraintTop_toBottomOf="@id/tvSpillageLabel" />

            <TextView
                android:id="@+id/tvRemarksLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gt_walsheim_pro_regular"
                android:padding="@dimen/margin_small"
                android:text="@string/remarks"
                android:textColor="@color/grey"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/dot_view3" />

            <TextView
                android:id="@+id/tvRemarksValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gt_walsheim_pro_regular"
                android:padding="@dimen/margin_small"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/tvRemarksLabel" />

            <View
                android:id="@+id/dot_view4"
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_very_small"
                android:layout_marginTop="@dimen/margin_medium"
                android:background="@drawable/dotted"
                app:layout_constraintTop_toBottomOf="@id/tvRemarksValue" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/photoImageView"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/margin_medium"
                android:paddingStart="@dimen/margin_xlarge"
                android:paddingEnd="@dimen/margin_medium"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/dot_view4"
                app:srcCompat="@android:color/darker_gray" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clFinalWeightValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/dark_marun"
                android:paddingTop="@dimen/margin_small"
                android:paddingBottom="@dimen/margin_small"
                app:layout_constraintTop_toBottomOf="@+id/photoImageView"
                tools:layout_editor_absoluteX="2dp"
                tools:layout_editor_absoluteY="509dp">

                <TextView
                    android:id="@+id/tvSystemWtLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gt_walsheim_pro_bold"
                    android:gravity="center"
                    android:text="@string/system_weight"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_medium"
                    app:layout_constraintEnd_toStartOf="@+id/ivMinus"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:layout_editor_absoluteY="16dp" />

                <TextView
                    android:id="@+id/tvSystemWtValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_very_small"
                    android:fontFamily="@font/gt_walsheim_pro_bold"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="@+id/tvSystemWtLabel"
                    app:layout_constraintStart_toStartOf="@+id/tvSystemWtLabel"
                    app:layout_constraintTop_toBottomOf="@id/tvSystemWtLabel" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivMinus"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:src="@drawable/ic_remove_black_24dp"
                    android:tint="@color/white"
                    app:layout_constraintBottom_toBottomOf="@id/tvStockAuditWtValue"
                    app:layout_constraintEnd_toStartOf="@+id/tvStockSuditWtLabel"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/tvSystemWtLabel"
                    app:layout_constraintTop_toTopOf="@+id/tvStockSuditWtLabel"
                    tools:ignore="ContentDescription"
                    tools:layout_editor_absoluteY="16dp" />

                <TextView
                    android:id="@+id/tvStockSuditWtLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gt_walsheim_pro_bold"
                    android:gravity="center"
                    android:text="@string/stock_audit_weight"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_medium"
                    app:layout_constraintEnd_toStartOf="@+id/ivEquals"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/ivMinus"
                    tools:layout_editor_absoluteY="16dp" />

                <TextView
                    android:id="@+id/tvStockAuditWtValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_very_small"
                    android:fontFamily="@font/gt_walsheim_pro_bold"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="@+id/tvStockSuditWtLabel"
                    app:layout_constraintStart_toStartOf="@+id/tvStockSuditWtLabel"
                    app:layout_constraintTop_toBottomOf="@id/tvStockSuditWtLabel" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivEquals"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_equal"
                    android:tint="@color/white"
                    app:layout_constraintBottom_toBottomOf="@id/tvStockAuditWtValue"
                    app:layout_constraintEnd_toStartOf="@+id/tvWeightLossFinalLabel"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/tvStockSuditWtLabel"
                    app:layout_constraintTop_toTopOf="@+id/tvStockSuditWtLabel"
                    tools:layout_editor_absoluteY="16dp" />

                <TextView
                    android:id="@+id/tvWeightLossFinalLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gt_walsheim_pro_bold"
                    android:gravity="center"
                    android:text="@string/weight_gain_loss"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_medium"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/ivEquals"
                    tools:layout_editor_absoluteY="16dp" />

                <TextView
                    android:id="@+id/tvWeightLossFinalValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_very_small"
                    android:fontFamily="@font/gt_walsheim_pro_bold"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="@+id/tvWeightLossFinalLabel"
                    app:layout_constraintStart_toStartOf="@+id/tvWeightLossFinalLabel"
                    app:layout_constraintTop_toBottomOf="@id/tvWeightLossFinalLabel" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvProceed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_pink_bg"
        android:fontFamily="@font/gt_walsheim_pro_bold"
        android:gravity="center_horizontal"
        android:padding="@dimen/margin_medium"
        android:text="@string/proceed"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>