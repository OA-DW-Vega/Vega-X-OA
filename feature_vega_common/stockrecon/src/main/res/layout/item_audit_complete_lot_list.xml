<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/border_light_grey_with_white_background"
    tools:ignore="MissingConstraints">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clRow1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/margin_medium">

        <TextView
            android:id="@+id/tvLotNoLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gt_walsheim_pro_bold"
            android:gravity="center"
            android:text="@string/lot_no"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_medium"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvLotNoValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_very_small"
            android:fontFamily="@font/gt_walsheim_pro_bold"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            app:layout_constraintLeft_toLeftOf="@id/tvLotNoLabel"
            app:layout_constraintTop_toBottomOf="@id/tvLotNoLabel" />

        <TextView
            android:id="@+id/tvMaterialLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gt_walsheim_pro_bold"
            android:gravity="center"
            android:text="@string/material"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvMaterialValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_very_small"
            android:fontFamily="@font/gt_walsheim_pro_bold"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            app:layout_constraintLeft_toLeftOf="@id/tvMaterialLabel"
            app:layout_constraintTop_toBottomOf="@id/tvMaterialLabel" />


        <TextView
            android:id="@+id/tvSystemWTLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gt_walsheim_pro_bold"
            android:text="@string/system_weight"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_medium"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvSystemWeightValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_very_small"
            android:fontFamily="@font/gt_walsheim_pro_bold"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            app:layout_constraintLeft_toLeftOf="@id/tvSystemWTLabel"
            app:layout_constraintTop_toBottomOf="@id/tvSystemWTLabel" />


        <TextView
            android:id="@+id/tvWtLossLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:fontFamily="@font/gt_walsheim_pro_bold"
            android:gravity="center"
            android:text="@string/weight_loss"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_medium"
            app:layout_constraintTop_toBottomOf="@id/tvLotNoValue" />

        <TextView
            android:id="@+id/tvWtLossValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_very_small"
            android:fontFamily="@font/gt_walsheim_pro_bold"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            app:layout_constraintLeft_toLeftOf="@id/tvWtLossLabel"
            app:layout_constraintTop_toBottomOf="@id/tvWtLossLabel" />

        <TextView
            android:id="@+id/tvNoOfBagsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:fontFamily="@font/gt_walsheim_pro_bold"
            android:gravity="center"
            android:text="@string/no_of_bags"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_medium"
            app:layout_constraintStart_toStartOf="@id/tvMaterialValue"
            app:layout_constraintTop_toBottomOf="@id/tvMaterialValue" />

        <TextView
            android:id="@+id/tvNoOfBagsValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_very_small"
            android:fontFamily="@font/gt_walsheim_pro_bold"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            app:layout_constraintLeft_toLeftOf="@id/tvNoOfBagsLabel"
            app:layout_constraintTop_toBottomOf="@id/tvNoOfBagsLabel" />


        <TextView
            android:id="@+id/tvTypeBagLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:fontFamily="@font/gt_walsheim_pro_bold"
            android:gravity="center"
            android:text="@string/type_of_bag"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_medium"
            app:layout_constraintStart_toStartOf="@id/tvSystemWeightValue"
            app:layout_constraintTop_toBottomOf="@id/tvSystemWeightValue" />

        <TextView
            android:id="@+id/tvTypeBagValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_very_small"
            android:fontFamily="@font/gt_walsheim_pro_bold"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            app:layout_constraintLeft_toLeftOf="@id/tvTypeBagLabel"
            app:layout_constraintTop_toBottomOf="@id/tvTypeBagLabel" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>