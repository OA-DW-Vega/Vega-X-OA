<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/margin_medium"
    android:layout_margin="4dp"
    android:background="@drawable/custom_edit_text">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvMaterialLbl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:fontFamily="@font/gilroy_regular"
            android:text="@string/material"
            android:textColor="#80050505"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvMaterialValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:layout_marginBottom="@dimen/margin_small"
            android:fontFamily="@font/gilroy_regular"
            android:textColor="@color/text_black"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="1032049i0923" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="30dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvStage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:fontFamily="@font/gilroy_regular"
            android:text="@string/weight_to_process"
            android:textColor="#80050505"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvStageValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:layout_marginBottom="@dimen/margin_small"
            android:fontFamily="@font/gilroy_regular"
            android:textColor="@color/text_black"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="@string/stage" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:visibility="gone"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTotalLoss"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:fontFamily="@font/gilroy_regular"
            android:text="@string/total_weight_loss"
            android:textColor="#80050505"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvTotalLossValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:layout_marginBottom="@dimen/margin_small"
            android:fontFamily="@font/gilroy_regular"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            android:textSize="14sp"
            tools:text="@string/stage" />

    </LinearLayout>

</LinearLayout>