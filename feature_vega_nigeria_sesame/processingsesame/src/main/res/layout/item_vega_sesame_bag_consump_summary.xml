<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/margin_medium"
    android:layout_marginTop="@dimen/margin_padding_size_small"
    android:layout_marginEnd="@dimen/margin_medium"
    android:layout_marginBottom="@dimen/margin_padding_size_small">


    <LinearLayout
        android:id="@+id/llLotItem"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_toEndOf="@+id/cbSelectStocks"
        android:orientation="vertical"
        android:padding="@dimen/margin_small">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBagType"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.4"
                android:fontFamily="@font/gilroy_regular"
                android:text="@string/bag_type"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_small" />

            <TextView
                android:id="@+id/tvBatch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.3"
                android:fontFamily="@font/gilroy_regular"
                android:text="Net Weight"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_small" />


            <TextView
                android:id="@+id/tvBagCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.4"
                android:fontFamily="@font/gilroy_regular"
                android:text="Bag Consumption Quantity"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_small" />


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="@dimen/margin_mic_small"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBagTypeValue"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.4"
                android:fontFamily="@font/gilroy_regular"
                android:gravity="start|center"
                android:textColor="@color/text_black"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="sacs" />

            <TextView
                android:id="@+id/tvBatchValue"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.3"
                android:fontFamily="@font/gilroy_regular"
                android:gravity="center|start"
                android:textColor="@color/text_black"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Batch1" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.4"
                android:background="@drawable/shape_sesame_processing_rect_white_bg">

                <EditText
                    android:id="@+id/tvBagCountValue"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/gilroy_regular"
                    android:paddingStart="5dp"
                    android:gravity="center|start"
                    android:textColor="@color/text_black"
                    android:inputType="number"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@android:color/transparent"
                    tools:text="10" />

            </LinearLayout>




        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
