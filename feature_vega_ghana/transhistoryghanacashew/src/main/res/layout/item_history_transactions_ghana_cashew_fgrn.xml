<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_padding_size_small"
        android:layout_marginBottom="@dimen/margin_medium"
        app:cardCornerRadius="4dp">

    <LinearLayout
            android:id="@+id/llItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/cbSelectStocks"
            android:orientation="vertical"
            android:padding="@dimen/margin_small">


        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

            <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:fontFamily="@font/gilroy_medium"
                    android:text="@string/processing_type"
                    android:visibility="gone"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    tools:ignore="RelativeOverlap,RtlSymmetry" />

            <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:fontFamily="@font/gilroy_medium"
                    android:text="@string/quantity"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    tools:ignore="RelativeOverlap,RtlSymmetry" />

            <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:fontFamily="@font/gilroy_medium"
                    android:text="@string/drying_loss"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    tools:ignore="RelativeOverlap,RtlSymmetry" />

        </LinearLayout>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

            <TextView
                    android:id="@+id/tvprocesstype"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:visibility="gone"
                    android:fontFamily="@font/gilroy_semibold"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    android:textStyle="bold"
                    tools:text="9892310090" />

            <TextView
                    android:id="@+id/tvquantity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:fontFamily="@font/gilroy_semibold"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    android:textStyle="bold"
                    tools:text="LBA" />

            <TextView
                    android:id="@+id/tvdryloss"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:fontFamily="@font/gilroy_semibold"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    android:textStyle="bold"
                    tools:text="LBA" />

        </LinearLayout>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_mic_small"
                android:orientation="horizontal">

            <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:fontFamily="@font/gilroy_medium"
                    android:text="@string/date"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    tools:ignore="RelativeOverlap,RtlSymmetry" />

            <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:fontFamily="@font/gilroy_medium"
                    android:text="@string/ponumber"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    tools:ignore="RelativeOverlap,RtlSymmetry" />

        </LinearLayout>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_mic_small"
                android:orientation="horizontal">

            <TextView
                    android:id="@+id/tvdate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:fontFamily="@font/gilroy_semibold"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    android:textStyle="bold"
                    tools:text="129180328" />

            <TextView
                    android:id="@+id/tvponumber"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:fontFamily="@font/gilroy_semibold"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    android:textStyle="bold"
                    tools:text="LBA" />


        </LinearLayout>


        <LinearLayout
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:id="@+id/layMaterial"
                android:layout_marginTop="@dimen/margin_mic_small"
                android:layout_height="wrap_content">


            <TextView
                    android:id="@+id/tvItemNameMain"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:fontFamily="@font/gilroy_semibold"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    android:text="@string/material_name_of_fgrn"
                    android:textStyle="bold"
                     />


        </LinearLayout>



        <LinearLayout
                android:visibility="visible"
                android:id="@+id/layoutMaterialDesc"
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/margin_mic_small"
                android:layout_height="wrap_content">


            <TextView
                    android:id="@+id/tvItemName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:fontFamily="@font/gilroy_semibold"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    android:textStyle="bold"
                    tools:text="Ghana Chachew" />


        </LinearLayout>



    </LinearLayout>

</androidx.cardview.widget.CardView>