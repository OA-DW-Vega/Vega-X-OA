<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivScaleClose"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="end"
            android:layout_margin="@dimen/margin_padding_size_small"
            android:background="@drawable/ic_edit"
            android:backgroundTint="@color/grey_button"
            android:contentDescription="@string/sync"
            android:elevation="5dp"
            android:gravity="center"
            android:padding="@dimen/margin_medium" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_medium">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="153dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_add_weight"
                    android:layout_width="80dp"
                    android:layout_height="0dp"
                    android:layout_marginEnd="2dp"
                    android:background="@color/grey_light"
                    android:fontFamily="@font/gilroy_semibold"
                    android:gravity="center"
                    android:paddingStart="@dimen/margin_small"
                    android:paddingEnd="@dimen/margin_small"
                    android:text="@string/add_weight"
                    android:textColor="@color/text_black"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:id="@+id/ll_card"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tv_add_weight"
                    app:layout_constraintStart_toStartOf="parent"
                    >

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvLotLbl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_medium"
                        android:layout_marginTop="@dimen/margin_small"
                        android:layout_marginEnd="@dimen/margin_small"
                        android:fontFamily="@font/gilroy_regular"
                        android:text="@string/lot_no"
                        android:textColor="@color/text_black" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvScaleLotValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_medium"
                        android:layout_marginEnd="@dimen/margin_small"
                        android:fontFamily="@font/gilroy_regular"
                        android:gravity="start"
                        android:textColor="@color/text_black"
                        android:textStyle="bold"
                        tools:text="18GBRD140" />


                </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvWeight"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_small"
                            android:fontFamily="@font/gilroy_regular"
                            android:text="@string/weight"
                            android:textColor="@color/text_black" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvScaleWeightValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/margin_small"
                            android:fontFamily="@font/gilroy_semibold"
                            android:textColor="@color/text_black"
                            android:textStyle="bold"
                            tools:text="2400 MT" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvStLocation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_small"
                            android:layout_marginEnd="@dimen/margin_small"
                            android:fontFamily="@font/gilroy_regular"
                            android:text="@string/st_location"
                            android:textColor="@color/text_black" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvStLocationValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/margin_small"
                            android:layout_marginBottom="@dimen/margin_medium"
                            android:fontFamily="@font/gilroy_semibold"
                            android:textColor="@color/text_black"
                            android:textStyle="bold"
                            tools:text="Sample Location" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toStartOf="@id/tv_add_weight"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ll_card">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvGrade"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_medium"
                            android:text="@string/material"
                            android:textColor="@color/text_black" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvScaleGradeValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_medium"
                            android:layout_marginEnd="@dimen/margin_small"
                            android:layout_marginBottom="@dimen/margin_small"
                            android:fontFamily="@font/gilroy_semibold"
                            android:textColor="@color/text_black"
                            android:textStyle="bold"
                            tools:text="MANBO/S_1 gfdgf hgcghcchgc" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvWeightDispatch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/margin_small"
                            android:text="@string/wt_to_dispatch"
                            android:textColor="@color/text_black" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvScaleDispatchValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/margin_small"
                            android:layout_marginBottom="@dimen/margin_small"
                            android:fontFamily="@font/gilroy_semibold"
                            android:textColor="@color/text_black"
                            android:textStyle="bold"
                            tools:text="1000 MT" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:visibility="gone"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvTotalWeightLoss"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/margin_small"
                            android:text="@string/weight_loss"
                            android:textColor="@color/text_black" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvTotalWeightLossValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/margin_small"
                            android:layout_marginBottom="@dimen/margin_small"
                            android:fontFamily="@font/gilroy_semibold"
                            android:textColor="@color/text_black"
                            android:textStyle="bold"
                            tools:text="1000 MT" />

                    </LinearLayout>

                </LinearLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
