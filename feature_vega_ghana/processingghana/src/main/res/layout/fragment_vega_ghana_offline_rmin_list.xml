<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/white"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryHeadOfi"
        android:fontFamily="@font/gilroy_regular"
        android:padding="@dimen/margin_small"
        android:text="Offline RMIN List"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvLotNoLbl"
            android:layout_width="0dp"
            android:layout_height="@dimen/action_bar_height"
            android:layout_gravity="center"
            android:layout_weight="0.5"
            android:background="@color/orange_light"
            android:gravity="center|start"
            android:paddingStart="@dimen/margin_medium"
            android:text="@string/pono"
            android:textColor="@color/warm_white"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLotNo"
            android:layout_width="0dp"
            android:layout_height="@dimen/action_bar_height"
            android:layout_gravity="center"
            android:layout_weight="2"
            android:background="@color/orange_light"
            android:gravity="center|start"
            android:paddingStart="@dimen/margin_medium"
            android:textColor="@color/warm_white"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            tools:text="lots12345" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPoList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:listitem="@layout/item_ghana_rmin" />

    <TextView
        android:id="@+id/tvNoData"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/no_data_found"
        android:visibility="gone" />

</LinearLayout>