<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_white"
    android:clickable="true">

    <TextView
        android:id="@+id/tvHeadPoDetail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryHeadOfi"
        android:fontFamily="@font/gt_walsheim_pro_regular"
        android:gravity="center_vertical"
        android:padding="@dimen/margin_small"
        android:paddingStart="@dimen/margin_large"
        android:paddingEnd="@dimen/margin_large"
        android:text="@string/fgrn_summary"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvLotNoLbl"
        android:layout_width="0dp"
        android:layout_height="@dimen/action_bar_height"
        android:layout_gravity="center"
        android:background="@color/orange_light"
        android:gravity="center|start"
        android:paddingStart="@dimen/margin_medium"
        android:text="@string/pono"
        android:textColor="@color/warm_white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvHeadPoDetail" />

    <TextView
        android:id="@+id/tvLotNo"
        android:layout_width="0dp"
        android:layout_height="@dimen/action_bar_height"
        android:layout_gravity="center"
        android:background="@color/orange_light"
        android:gravity="center|start"
        android:paddingStart="@dimen/margin_medium"
        android:textColor="@color/warm_white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvLotNoLbl"
        app:layout_constraintTop_toBottomOf="@+id/tvHeadPoDetail"
        tools:text="lots12345" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvSummaryLbl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_medium"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/gt_walsheim_pro_bold"
        android:text="@string/processing_summary"
        android:textColor="@color/dark_marun"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvLotNoLbl" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/tvConfirm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSummaryLbl">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/margin_xlarge">

            <androidx.cardview.widget.CardView
                android:id="@+id/clMain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_medium"
                app:layout_constraintBottom_toTopOf="@+id/tvShift"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/margin_small">

                    <TextView
                        android:id="@+id/tv_material_lbl"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_padding_size_small"
                        android:fontFamily="@font/gt_walsheim_pro_regular"
                        android:text="@string/material"
                        android:textColor="@color/grey_border"
                        android:textSize="@dimen/text_size_small"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@+id/tv_weight_lbl"
                        app:layout_constraintHorizontal_weight="2"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_weight_lbl"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_padding_size_small"
                        android:fontFamily="@font/gt_walsheim_pro_regular"
                        android:text="@string/weight"
                        android:textColor="@color/grey_border"
                        android:textSize="@dimen/text_size_small"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_material_lbl"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_weight="1"
                        app:layout_constraintStart_toEndOf="@+id/tv_material_lbl"
                        app:layout_constraintTop_toTopOf="@+id/tv_material_lbl" />


                    <TextView
                        android:id="@+id/tv_material_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_size_xmedium"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@+id/tv_weight_data"
                        app:layout_constraintHorizontal_weight="2"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_material_lbl"
                        tools:text="sample text for my material data " />


                    <TextView
                        android:id="@+id/tv_weight_data"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/gt_walsheim_pro_bold"
                        android:textColor="@color/black"
                        android:textSize="@dimen/text_size_xmedium"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_material_name"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_weight="1"
                        app:layout_constraintStart_toEndOf="@+id/tv_material_name"
                        app:layout_constraintTop_toBottomOf="@+id/tv_weight_lbl"
                        app:layout_constraintTop_toTopOf="@+id/tv_material_name"
                        tools:text="2500.00 KG" />


                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cvQtyDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_material_name">

                        <TextView
                            android:id="@+id/tvLotIdLbl"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_very_small"
                            android:fontFamily="@font/gt_walsheim_pro_regular"
                            android:text="@string/lot_id"
                            android:textColor="@color/grey_border"
                            android:textSize="@dimen/text_size_small"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@+id/tvNoOfBagLbl"
                            app:layout_constraintHorizontal_weight="1"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvNoOfBagLbl"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_very_small"
                            android:fontFamily="@font/gt_walsheim_pro_regular"
                            android:text="KOR Value"
                            android:visibility="gone"
                            android:textColor="@color/grey_border"
                            android:textSize="@dimen/text_size_small"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@+id/tvStLocationLbl"
                            app:layout_constraintHorizontal_weight="1"
                            app:layout_constraintStart_toEndOf="@+id/tvLotIdLbl"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvStLocationLbl"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_very_small"
                            android:fontFamily="@font/gt_walsheim_pro_regular"
                            android:text="@string/st_location"
                            android:textColor="@color/grey_border"
                            android:textSize="@dimen/text_size_small"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_weight="1.2"
                            app:layout_constraintStart_toEndOf="@+id/tvNoOfBagLbl"
                            app:layout_constraintTop_toTopOf="parent" />


                        <TextView
                            android:id="@+id/tvLotId"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/gt_walsheim_pro_bold"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_size_xmedium"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@+id/tvNoOfBag"
                            app:layout_constraintHorizontal_weight="1"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tvLotIdLbl"
                            tools:text="1000" />

                        <TextView
                            android:id="@+id/tvNoOfBag"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/gt_walsheim_pro_bold"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_size_xmedium"
                            android:textStyle="bold"
                            android:visibility="gone"
                            app:layout_constraintEnd_toStartOf="@+id/tvStLocation"
                            app:layout_constraintHorizontal_weight="1"
                            app:layout_constraintStart_toEndOf="@+id/tvLotId"
                            app:layout_constraintTop_toBottomOf="@+id/tvNoOfBagLbl"
                            tools:text="1000" />

                        <TextView
                            android:id="@+id/tvStLocation"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/gt_walsheim_pro_bold"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_size_xmedium"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_weight="1.2"
                            app:layout_constraintStart_toEndOf="@+id/tvNoOfBag"
                            app:layout_constraintTop_toBottomOf="@+id/tvStLocationLbl"
                            tools:text="1000" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cvDryDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/cvQtyDetails">

                        <TextView
                            android:id="@+id/tvDrylossLbl"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_very_small"
                            android:fontFamily="@font/gt_walsheim_pro_regular"
                            android:text="@string/dryingloss"
                            android:textColor="@color/grey_border"
                            android:textSize="@dimen/text_size_small"
                            android:textStyle="bold"
                            app:layout_constraintHorizontal_weight="1"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />


                        <TextView
                            android:id="@+id/tvDryloss"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/gt_walsheim_pro_bold"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_size_xmedium"
                            android:textStyle="bold"
                            app:layout_constraintHorizontal_weight="1"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tvDrylossLbl"
                            tools:text="1000" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <LinearLayout
                        android:id="@+id/llrminQty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/cvDryDetails">

                        <TextView
                            android:id="@+id/rmin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_very_small"
                            android:fontFamily="@font/gt_walsheim_pro_regular"
                            android:text="RMIN Quantity"
                            android:textColor="@color/grey_border"
                            android:textSize="@dimen/text_size_small"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/rminQty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/gt_walsheim_pro_bold"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_size_xmedium"
                            android:textStyle="bold"
                            tools:text="1000" />

                    </LinearLayout>


                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

<!--            <androidx.recyclerview.widget.RecyclerView-->
<!--                android:id="@+id/rvFgrnSummary"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="0dp"-->
<!--                android:visibility="visible"-->
<!--                app:layout_constraintBottom_toTopOf="@+id/tvShift"-->
<!--                app:layout_constraintEnd_toEndOf="parent"-->
<!--                app:layout_constraintHorizontal_bias="0.0"-->
<!--                app:layout_constraintStart_toStartOf="parent"-->
<!--                tools:listitem="@layout/item_vega_ghana_fgrn_summary" />-->

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvShift"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginTop="@dimen/margin_xlarge"
                android:layout_marginBottom="@dimen/margin_xlarge"
                android:background="@color/light_grey"
                android:paddingStart="@dimen/margin_xlarge"
                android:paddingTop="@dimen/margin_medium"
                android:paddingEnd="@dimen/margin_xlarge"
                android:paddingBottom="@dimen/margin_medium"
                android:textColor="@color/black"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/clMain"
                tools:text="Shift A" />

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_gravity="end"
                android:visibility="gone"
                android:layout_marginEnd="@dimen/margin_large"
                android:background="@drawable/ic_edit"
                android:backgroundTint="@color/grey_button"
                android:contentDescription="@string/sync"
                android:elevation="5dp"
                android:gravity="end"
                android:padding="@dimen/margin_medium"
                android:paddingEnd="@dimen/margin_medium"
                app:layout_constraintBottom_toBottomOf="@+id/tvShift"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvShift" />

            <TextView
                android:id="@+id/tvOperator"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginTop="@dimen/margin_large"
                android:gravity="start"
                android:visibility="gone"
                android:text="@string/remarks"
                android:textColor="@color/grey_border"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@+id/tvShift"
                app:layout_constraintTop_toBottomOf="@+id/tvShift" />

            <TextView
                android:id="@+id/tvOperatorName"
                android:layout_width="0dp"
                android:visibility="gone"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_large"
                android:layout_marginEnd="@dimen/margin_medium"
                android:gravity="end"
                android:textColor="@color/black"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/tvShift"
                app:layout_constraintTop_toBottomOf="@+id/tvShift"
                tools:text="@string/operator_name" />

            <TextView
                android:id="@+id/tvBagConsumption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:layout_marginStart="@dimen/margin_medium"
                android:gravity="start"
                android:fontFamily="@font/gt_walsheim_pro_bold"
                android:text="@string/bag_consumption"
                android:textColor="@color/dark_marun"
                android:textStyle="bold"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/clMain" />

            <TextView
                android:id="@+id/tvBagConsumptionValue"
                android:layout_width="0dp"
                android:visibility="gone"
                android:layout_height="wrap_content"
                android:layout_marginStart="50dp"
                android:layout_marginTop="@dimen/margin_xlarge"
                android:gravity="start"
                android:textColor="@color/black"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@+id/tvOperatorName"
                app:layout_constraintStart_toEndOf="@+id/tvBagConsumption"
                app:layout_constraintTop_toBottomOf="@+id/tvOperator" />

<!--            <androidx.recyclerview.widget.RecyclerView-->
<!--                android:id="@+id/rvBagConsumption"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:layout_marginTop="@dimen/margin_medium"-->
<!--                app:layout_constraintStart_toStartOf="@+id/tvBagConsumption"-->
<!--                app:layout_constraintTop_toBottomOf="@+id/tvBagConsumption"-->
<!--                tools:listitem="@layout/item_vega_ghana_bag_consump_summary" />-->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_medium"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvBagConsumption">

                <LinearLayout
                    android:id="@+id/llLotItem"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:orientation="vertical"
                    android:padding="@dimen/margin_small">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvBagType"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/roboto_medium"
                            android:text="@string/bag_type"
                            android:textColor="@color/grey"
                            android:textSize="@dimen/text_size_small" />


                        <TextView
                            android:id="@+id/tvBagCount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/roboto_medium"
                            android:text="Bag Consumption Quantity"
                            android:textColor="@color/grey"
                            android:textSize="@dimen/text_size_small" />


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="@dimen/margin_mic_small"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvBagTypeValue"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:fontFamily="@font/roboto_bold"
                            android:gravity="start|center"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="sacs" />

                        <TextView
                            android:id="@+id/tvBagCountValue"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:fontFamily="@font/roboto_bold"
                            android:gravity="center|start"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="Batch1" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvConfirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryOfi"
        android:gravity="center"
        android:padding="@dimen/margin_medium"
        android:text="@string/confirm"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>