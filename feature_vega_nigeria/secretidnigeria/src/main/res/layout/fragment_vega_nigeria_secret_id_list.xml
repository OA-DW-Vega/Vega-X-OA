<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:background="@color/warm_white"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/llContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:ignore="UselessParent">

        <LinearLayout
            android:id="@+id/llSortBy"
            android:layout_width="match_parent"
            android:layout_height="@dimen/action_bar_height"
            android:layout_gravity="center"
            android:background="@color/colorPrimaryHeadOfi"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="@dimen/margin_small"
            android:paddingBottom="@dimen/margin_small">


            <TextView
                android:id="@+id/tvType"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_weight="1"
                android:fontFamily="@font/gilroy_regular"
                android:gravity="start"
                android:text="@string/secret_id"
                android:textColor="@color/warm_white"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold" />


            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivSortDownUp"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_medium"
                android:contentDescription="@string/confirm"
                android:padding="3dp"
                android:src="@drawable/ic_sort_white" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/llQualityOffline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/marun"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="4"
                android:fontFamily="@font/gilroy_regular"
                android:padding="@dimen/text_size_medium"
                android:text="@string/ppq_offline_summary"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:contentDescription="@string/ppq_offline_summary"
                android:src="@drawable/ic_right_arrow"
                android:tint="@color/white" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/flSavedBatchId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:weightSum="3.5">

            <FrameLayout
                android:id="@+id/flPlant"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_gravity="top"
                android:layout_margin="@dimen/margin_medium"
                android:layout_weight="2.5"
                android:background="@drawable/border_light_grey">

                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/spPlantSelection"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:layout_margin="1dp"
                    android:background="@drawable/border_light_grey"
                    android:dropDownWidth="match_parent"
                    android:dropDownHeight="150dp"
                    android:gravity="center_vertical"
                    android:minHeight="60dp"
                    android:overlapAnchor="false"
                    android:padding="@dimen/margin_mic_small"
                    android:popupBackground="@color/white"
                    android:spinnerMode="dropdown" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btAdd"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="20dp"
                    android:contentDescription="@null"
                    android:padding="5dp"
                    android:src="@drawable/ic_down_arrow" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/textSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:weightSum="3.5">

            <FrameLayout
                android:id="@+id/fltext"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_gravity="top"
                android:layout_margin="@dimen/margin_medium"
                android:layout_weight="2.5"
                android:background="@drawable/border_light_grey">

                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/spTextSelection"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:layout_margin="1dp"
                    android:background="@drawable/border_light_grey"
                    android:dropDownWidth="match_parent"
                    android:dropDownHeight="150dp"
                    android:gravity="center_vertical"
                    android:minHeight="60dp"
                    android:overlapAnchor="false"
                    android:padding="@dimen/margin_mic_small"
                    android:popupBackground="@color/white"
                    android:spinnerMode="dropdown" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btTextAdd"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="20dp"
                    android:contentDescription="@null"
                    android:padding="5dp"
                    android:src="@drawable/ic_down_arrow" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_very_small"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_very_small"
                android:layout_marginTop="@dimen/margin_small"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:weightSum="2.5">

                <TextView
                    android:id="@+id/tvFromDateLabel"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:fontFamily="@font/gilroy_semibold"
                    android:gravity="center_vertical"
                    android:padding="@dimen/margin_padding_size_small"
                    android:text="@string/from_date"
                    android:textColor="@color/transparent_black"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvFromDate"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_gravity="start"
                    android:layout_marginTop="@dimen/margin_very_small"
                    android:layout_weight="1.5"
                    android:background="@drawable/custom_edit_text"
                    android:fontFamily="@font/gilroy_regular"
                    android:padding="@dimen/margin_padding_size_medium"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_very_small"
                android:layout_marginTop="@dimen/margin_small"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:weightSum="2.5">

                <TextView
                    android:id="@+id/tvToDateLabel"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:fontFamily="@font/gilroy_semibold"
                    android:gravity="center_vertical"
                    android:padding="@dimen/margin_padding_size_small"
                    android:text="@string/to_date"
                    android:textColor="@color/transparent_black"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvToDate"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_gravity="start"
                    android:layout_marginTop="@dimen/margin_very_small"
                    android:layout_weight="1.5"
                    android:background="@drawable/custom_edit_text"
                    android:fontFamily="@font/gilroy_regular"
                    android:padding="@dimen/margin_padding_size_medium"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/btnGo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="GO" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvInspectiontLots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            tools:listitem="@layout/item_vega_nigeria_secretid_details" />

        <TextView
            android:id="@+id/tvNoData"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/gilroy_semibold"
            android:gravity="center"
            android:text="@string/no_data_found"
            android:textSize="@dimen/text_size_large"
            android:visibility="gone" />


    </LinearLayout>

</LinearLayout>