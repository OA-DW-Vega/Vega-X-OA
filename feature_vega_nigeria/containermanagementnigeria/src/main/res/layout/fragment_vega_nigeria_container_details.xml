<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="@color/warm_white"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryHeadOfi"
        android:fontFamily="@font/gilroy_regular"
        android:padding="@dimen/margin_small"
        android:text="@string/container_details"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/tv_edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:background="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title">
        <TextView
            android:id="@+id/btn_edit"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:fontFamily="@font/gilroy_semibold"
            android:gravity="center"
            android:padding="@dimen/margin_small"
            android:textColor="@color/text_black"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            android:text="@string/edit"
            />
        <TextView
            android:id="@+id/btn_delete"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:fontFamily="@font/gilroy_semibold"
            android:gravity="center"
            android:padding="@dimen/margin_small"
            android:textColor="@color/text_black"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            android:text="@string/delete"
            />
    </LinearLayout>



    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/white"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/btProceed"
        app:layout_constraintTop_toBottomOf="@+id/tv_edit">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white">

            <androidx.cardview.widget.CardView
                android:id="@+id/card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:elevation="@dimen/margin_small"
                app:cardElevation="@dimen/margin_small"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:visibility="gone">

            </androidx.cardview.widget.CardView>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLotSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_semibold"
                android:textColor="@color/text_black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card"
                />
<!--            android:layout_marginStart="@dimen/margin_medium"-->
<!--            android:layout_marginTop="@dimen/margin_large"-->

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvContainerNoLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/margin_medium"
                android:layout_marginStart="@dimen/margin_medium"
                android:fontFamily="@font/gilroy_regular"
                android:text="Container No"
                android:textColor="@color/dark_marun"
                android:textSize="@dimen/text_size_medium"
                app:layout_constraintStart_toStartOf="@id/tvLotSummary"
                app:layout_constraintTop_toBottomOf="@id/tvLotSummary" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvContainerNoValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:layout_marginTop="@dimen/margin_medium"
                android:fontFamily="@font/gilroy_semibold"
                android:textColor="@color/dark_marun"
                android:textSize="@dimen/text_size_medium"
                android:layout_marginEnd="@dimen/margin_medium"
                tools:text="100800799"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvLotSummary"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvCOntainerSize"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/gilroy_regular"
                android:text="Container Size"
                android:textColor="@color/dark_marun"
                android:textSize="@dimen/text_size_medium"
                app:layout_constraintStart_toStartOf="@id/tvContainerNoLabel"
                app:layout_constraintTop_toBottomOf="@id/tvContainerNoLabel" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvContainerSizeValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/gilroy_semibold"
                android:textColor="@color/dark_marun"
                android:textSize="@dimen/text_size_medium"
                app:layout_constraintBottom_toBottomOf="@id/tvCOntainerSize"
                app:layout_constraintEnd_toEndOf="@id/tvContainerNoValue"
                app:layout_constraintTop_toTopOf="@id/tvCOntainerSize"
                tools:text="100800799" />

            <View
                android:id="@+id/vi_procureType"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/dash_line"
                app:layout_constraintEnd_toEndOf="@id/tvContainerNoValue"
                app:layout_constraintStart_toStartOf="@id/tvContainerNoLabel"
                app:layout_constraintTop_toBottomOf="@id/tvContainerSizeValue" />

            <LinearLayout
                android:id="@+id/ll_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="@id/vi_procureType"
                app:layout_constraintTop_toBottomOf="@id/vi_procureType"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvProduct"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/gilroy_regular"
                        android:text="Container Weight"
                        android:textColor="@color/dark_marun"
                        android:textSize="@dimen/text_size_medium"
                        />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvContainerWeightValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/gilroy_semibold"
                        android:textColor="@color/dark_marun"
                        android:textSize="@dimen/text_size_medium"
                        tools:text="100800799" />

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    >

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvSupplier"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/gilroy_regular"
                        android:text="Sales Order No"
                        android:textColor="@color/dark_marun"
                        android:textSize="@dimen/text_size_medium"
                        />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvSalesOrderValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/gilroy_semibold"
                        android:textColor="@color/dark_marun"
                        android:textSize="@dimen/text_size_medium"
                        tools:text="100800799" />

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvReceivingWH"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/gilroy_regular"
                        android:text="Shipping Line"
                        android:textColor="@color/dark_marun"
                        android:textSize="@dimen/text_size_medium"
                        />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvShippingLineValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/gilroy_semibold"
                        android:textColor="@color/dark_marun"
                        android:textSize="@dimen/text_size_medium"
                        tools:text="100800799" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvWRNo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/gilroy_regular"
                        android:text="Date of Entry"
                        android:textColor="@color/dark_marun"
                        android:textSize="@dimen/text_size_medium"
                        android:visibility="gone"
                        />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvWRNoValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/gilroy_semibold"
                        android:textColor="@color/dark_marun"
                        android:textSize="@dimen/text_size_medium"
                        android:visibility="gone"
                        tools:text="100800799" />

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvBatchNo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/gilroy_regular"
                        android:text="Date of Entry"
                        android:textColor="@color/dark_marun"
                        android:textSize="@dimen/text_size_medium"
                        />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvDaysStandingValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/gilroy_semibold"
                        android:textColor="@color/dark_marun"
                        android:textSize="@dimen/text_size_medium"
                        tools:text="100800799" />

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/gilroy_regular"
                        android:text="No of Days Standing"
                        android:textColor="@color/dark_marun"
                        android:textSize="@dimen/text_size_medium"
                        />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvDaysValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/gilroy_semibold"
                        android:textColor="@color/dark_marun"
                        android:textSize="@dimen/text_size_medium"
                        tools:text="100800799" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:id="@+id/vi_procure"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/dash_line"
                app:layout_constraintEnd_toEndOf="@id/ll_summary"
                app:layout_constraintStart_toStartOf="@id/ll_summary"
                app:layout_constraintTop_toBottomOf="@id/ll_summary" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvGross"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:layout_marginStart="@dimen/margin_medium"
                android:fontFamily="@font/gilroy_regular"
                android:text="Status"
                android:textColor="@color/dark_marun"
                android:textSize="@dimen/text_size_medium"
                app:layout_constraintStart_toStartOf="@id/tvLotSummary"
                app:layout_constraintTop_toBottomOf="@id/vi_procure" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvStatusValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_large"
                android:fontFamily="@font/gilroy_semibold"
                android:textColor="@color/dark_marun"
                android:textSize="@dimen/text_size_medium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/vi_procure"
                tools:text="1200 MT" />

            <View
                android:id="@+id/vi_gross"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/dash_line"
                app:layout_constraintEnd_toEndOf="@id/tvStatusValue"
                app:layout_constraintStart_toStartOf="@id/tvGross"
                app:layout_constraintTop_toBottomOf="@id/tvGross"
                android:visibility="gone"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_no_bags"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:fontFamily="@font/gilroy_regular"
                android:text="@string/no_of_bags"
                android:textColor="@color/dark_marun"
                android:textSize="@dimen/text_size_medium"
                app:layout_constraintStart_toStartOf="@id/tvLotSummary"
                app:layout_constraintTop_toBottomOf="@id/vi_gross"
                android:visibility="gone"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvNoBagsValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_semibold"
                android:textColor="@color/dark_marun"
                android:textSize="@dimen/text_size_medium"
                app:layout_constraintBottom_toBottomOf="@id/tv_no_bags"
                app:layout_constraintEnd_toEndOf="@id/tvStatusValue"
                app:layout_constraintTop_toTopOf="@id/tv_no_bags"
                tools:text="100"
                android:visibility="gone"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_bags_tare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/gilroy_regular"
                android:textColor="@color/dark_marun"
                android:textSize="@dimen/text_size_medium"
                app:layout_constraintStart_toStartOf="@id/tvLotSummary"
                app:layout_constraintTop_toBottomOf="@id/tv_no_bags"
                android:visibility="gone"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvBagsTareValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_semibold"
                android:textColor="@color/dark_marun"
                android:textSize="@dimen/text_size_medium"
                app:layout_constraintBottom_toBottomOf="@id/tv_bags_tare"
                app:layout_constraintEnd_toEndOf="@id/tvStatusValue"
                app:layout_constraintTop_toTopOf="@id/tv_bags_tare"
                tools:text="10 MT"
                android:visibility="gone"/>

            <View
                android:id="@+id/vi_bags"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/dash_line"
                app:layout_constraintEnd_toEndOf="@id/tvStatusValue"
                app:layout_constraintStart_toStartOf="@id/tvGross"
                app:layout_constraintTop_toBottomOf="@id/tv_bags_tare"
                android:visibility="gone"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_net_weight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:layout_marginBottom="@dimen/margin_medium"
                android:fontFamily="@font/gilroy_regular"
                android:text="@string/net_weight"
                android:textColor="@color/dark_marun"
                android:textSize="@dimen/text_size_medium"
                app:layout_constraintStart_toStartOf="@id/tvLotSummary"
                app:layout_constraintTop_toBottomOf="@id/vi_bags"
                android:visibility="gone"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvNetWeightValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:layout_marginBottom="@dimen/margin_medium"
                android:fontFamily="@font/gilroy_semibold"
                android:textColor="@color/dark_marun"
                android:textSize="@dimen/text_size_medium"
                app:layout_constraintBottom_toBottomOf="@id/tv_net_weight"
                app:layout_constraintEnd_toEndOf="@id/tvStatusValue"
                app:layout_constraintTop_toTopOf="@id/tv_net_weight"
                tools:text="100 MT"
                android:visibility="gone"/>

            <View
                android:id="@+id/vi_net"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/dash_line"
                app:layout_constraintEnd_toEndOf="@id/tvStatusValue"
                app:layout_constraintStart_toStartOf="@id/tvGross"
                app:layout_constraintTop_toBottomOf="@id/tv_net_weight"
                android:visibility="gone"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btStuffingDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/black"
                android:fontFamily="@font/roboto_bold"
                android:gravity="center"
                android:padding="@dimen/margin_large"
                android:text="Stuffing Details"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_smedium"
                android:textStyle="bold"
                android:layout_marginTop="@dimen/margin_very_small"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="@id/tvStatusValue"
                app:layout_constraintStart_toStartOf="@id/tvGross"
                app:layout_constraintTop_toBottomOf="@id/tv_net_weight"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btProceed"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryOfi"
        android:fontFamily="@font/roboto_bold"
        android:gravity="center"
        android:padding="@dimen/margin_large"
        android:text="OK"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_smedium"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>