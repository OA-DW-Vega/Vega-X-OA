<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:background="@color/warm_white"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="10"
        android:background="@color/colorPrimaryHeadOfi"
        android:fontFamily="@font/gilroy_regular"
        android:padding="@dimen/margin_small"
        android:text="@string/stuffing_details"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        />

<!--    <androidx.core.widget.NestedScrollView-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="match_parent"-->
<!--        android:background="@color/white"-->
<!--        android:fillViewport="true"-->
<!--        app:layout_constraintTop_toBottomOf="@+id/tv_lot_value">-->
<!--        &lt;!&ndash;        app:layout_constraintBottom_toTopOf="@id/clNet"&ndash;&gt;-->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:layout_weight="100">

            <LinearLayout
                android:id="@+id/ll_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/white"
                android:layout_marginStart="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvContainerNoLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:fontFamily="@font/gilroy_regular"
                        android:text="Sales Order"
                        android:textColor="@color/dark_marun"
                        android:textSize="@dimen/text_size_medium"
                        />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvSalesNoValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:fontFamily="@font/gilroy_semibold"
                        android:textColor="@color/dark_marun"
                        android:textSize="@dimen/text_size_medium"
                        tools:text="100800799" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvCOntainerSize"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/gilroy_regular"
                        android:text="Total Lots"
                        android:textColor="@color/dark_marun"
                        android:textSize="@dimen/text_size_medium"
                        />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvTotalLotsValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/gilroy_semibold"
                        android:textColor="@color/dark_marun"
                        android:textSize="@dimen/text_size_medium"
                        tools:text="100800799" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvProduct"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/gilroy_regular"
                        android:text="Total Weight"
                        android:textColor="@color/dark_marun"
                        android:textSize="@dimen/text_size_medium"
                        />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvTotalWeightValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/gilroy_semibold"
                        android:textColor="@color/dark_marun"
                        android:textSize="@dimen/text_size_medium"
                        tools:text="100800799" />

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    >

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvSupplier"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/gilroy_regular"
                        android:text="Sales Order No"
                        android:textColor="@color/dark_marun"
                        android:textSize="@dimen/text_size_medium"
                        />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvDestValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/gilroy_semibold"
                        android:textColor="@color/dark_marun"
                        android:textSize="@dimen/text_size_medium"
                        tools:text="100800799" />

                </LinearLayout>

            </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvLotList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    tools:listitem="@layout/item_vega_nigeria_container_inventory_lot_details" />

                <TextView
                    android:id="@+id/tvNoData"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:fontFamily="@font/gilroy_semibold"
                    android:text="@string/no_data"
                    android:textSize="@dimen/text_size_large"
                    android:visibility="gone" />


        </LinearLayout>
<!--    </androidx.core.widget.NestedScrollView>-->


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btOk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryOfi"
        android:fontFamily="@font/roboto_bold"
        android:gravity="center"
        android:padding="@dimen/margin_large"
        android:text="@string/ok"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_smedium"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</LinearLayout>

