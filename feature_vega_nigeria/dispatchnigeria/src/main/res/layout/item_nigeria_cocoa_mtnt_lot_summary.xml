<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/margin_small">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@+id/cbSelectStocks"
        android:orientation="vertical"
        android:padding="@dimen/margin_small">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.3"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lot_no_new"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_small" />

                <TextView
                    android:id="@+id/tvLotId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_bold"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    android:textStyle="bold"
                    tools:text="19393024892" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.3"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/st_location"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_small" />

                <TextView
                    android:id="@+id/tvStLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_black"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="@string/st_location" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:id="@+id/linearWeightLoss"
                android:layout_height="wrap_content"
                android:layout_weight="0.3"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/weight_loss"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_small" />

                <TextView
                    android:id="@+id/tvTotalWeightLoss"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_bold"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_xmedium"
                    android:textStyle="bold"
                    tools:text="19393" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivClose"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_close_black" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvGrade"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:fontFamily="@font/roboto_medium"
                android:text="@string/material"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_small" />


            <TextView
                android:id="@+id/tvEditWeight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:text="@string/weight"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_small" />


            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:text="@string/weight_to_dispatch"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_small" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_mic_small"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvGradeValue"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.5"
                android:gravity="start|center"
                android:textColor="@color/text_black"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="LBA fsd svsdv sdvfsdfsds svsfsd" />


            <TextView
                android:id="@+id/tvWeightValue"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.5"
                android:fontFamily="@font/roboto_bold"
                android:gravity="center|start"
                android:textColor="@color/text_black"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="10/10/2020" />

            <EditText
                android:id="@+id/etWeight"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="0.5"
                android:background="@drawable/custom_edit_text"
                android:fontFamily="@font/roboto_bold"
                android:inputType="numberDecimal"
                android:paddingStart="@dimen/margin_small"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_small"
                android:textStyle="bold"
                tools:text="10/10/2020"
                tools:visibility="gone" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvEditedWeight"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="0.5"
                android:fontFamily="@font/roboto_bold"
                android:gravity="start|center"
                android:inputType="numberDecimal"
                android:paddingStart="@dimen/margin_small"
                android:paddingEnd="4dp"
                android:textColor="@color/text_black"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="visible"
                tools:text="10/10/2020" />

            <TextView
                android:id="@+id/tvUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/roboto_bold"
                android:text="@string/unit_of_measure"
                android:textColor="@color/text_black" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center"
                android:layout_marginTop="@dimen/margin_medium"
                android:layout_marginBottom="@dimen/margin_mic_small"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cbSelectAll"
                    android:layout_width="28dp"
                    android:layout_height="28dp" />

                <TextView
                    android:id="@+id/tvSelectAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/roboto_bold"
                    android:text="@string/select_entire_lot"
                    android:textColor="@color/text_black" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center"
                android:layout_marginTop="@dimen/margin_medium"
                android:layout_marginBottom="@dimen/margin_mic_small"
                android:gravity="end"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cbEndLot"
                    android:layout_width="28dp"
                    android:layout_height="28dp" />

                <TextView
                    android:id="@+id/tvEndLot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/roboto_bold"
                    android:text="@string/end_pile_lot"
                    android:textColor="@color/text_black" />

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
