<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/white">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryHeadOfi"
        android:fontFamily="@font/gilroy_regular"
        android:paddingStart="@dimen/margin_large"
        android:paddingTop="@dimen/margin_small"
        android:paddingEnd="@dimen/margin_large"
        android:paddingBottom="@dimen/margin_small"
        android:text="@string/mtnt_weighscale"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:fitsSystemWindows="true"
        app:layout_constraintBottom_toTopOf="@id/btnProceed"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/btnProceed"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title">

            <TextView
                android:id="@+id/tvTruckIDNo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:fontFamily="@font/gilroy_regular"
                android:paddingStart="@dimen/margin_large"
                android:paddingEnd="@dimen/margin_small"
                android:text="@string/consignment_details"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_smedium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clConsign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_medium"
                app:layout_constraintTop_toBottomOf="@id/tvTruckIDNo">

                <LinearLayout
                    android:id="@+id/ll_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        >

                        <TextView
                            android:id="@+id/tvDest"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/shape_nigeriacoco_rect_grey_border"
                            android:fontFamily="@font/gilroy_semibold"
                            android:gravity="center"
                            android:minHeight="60dp"
                            android:text="@string/destination_wh_man"
                            android:textColor="@color/text_black"
                            android:textSize="@dimen/text_size_medium"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvWhValue"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/shape_nigeriacoco_rect_white_bg"
                            android:drawableEnd="@drawable/ic_add_icon_new"
                            android:gravity="center"
                            android:padding="@dimen/margin_padding_size_medium"
                            android:textColor="@color/text_black"
                            android:textSize="16sp"
                            tools:text="Sample" />


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        >

                        <TextView
                            android:id="@+id/tvSendingWH"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/shape_nigeriacoco_rect_grey_border"
                            android:fontFamily="@font/gilroy_semibold"
                            android:gravity="center"
                            android:minHeight="60dp"
                            android:text="@string/sending_wh_man"
                            android:textColor="@color/text_black"
                            android:textSize="@dimen/text_size_medium"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSendingWHValue"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/shape_nigeriacoco_rect_white_bg"
                            android:gravity="center"
                            android:padding="@dimen/margin_padding_size_medium"
                            android:textColor="@color/text_black"
                            android:textSize="16sp"
                            tools:text="Sample" />


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        >

                        <TextView
                            android:id="@+id/tvsto"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/shape_nigeriacoco_rect_grey_border"
                            android:fontFamily="@font/gilroy_semibold"
                            android:gravity="center"
                            android:minHeight="60dp"
                            android:text="@string/sto_number_man"
                            android:textColor="@color/text_black"
                            android:textSize="@dimen/text_size_medium"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvstoValue"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/shape_nigeriacoco_rect_white_bg"
                            android:drawableEnd="@drawable/ic_add_icon_new"
                            android:gravity="center"
                            android:padding="@dimen/margin_padding_size_medium"
                            android:textColor="@color/text_black"
                            android:textSize="16sp"
                            tools:text="Sample" />


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        >

                        <TextView
                            android:id="@+id/tvmaterial"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/shape_nigeriacoco_rect_grey_border"
                            android:fontFamily="@font/gilroy_semibold"
                            android:gravity="center"
                            android:minHeight="60dp"
                            android:text="@string/material_man"
                            android:textColor="@color/text_black"
                            android:textSize="@dimen/text_size_medium"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvmaterialValue"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/shape_nigeriacoco_rect_white_bg"
                            android:drawableEnd="@drawable/ic_add_icon_new"
                            android:gravity="center"
                            android:padding="@dimen/margin_padding_size_medium"
                            android:textColor="@color/text_black"
                            android:textSize="16sp"
                            tools:text="Sample" />


                    </LinearLayout>

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvMaterialList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    app:layout_constraintTop_toBottomOf="@id/ll_details"
                    tools:layout_height="180dp"
                    tools:listitem="@layout/item_nigeria_cocoa_material_layout" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tvTruckDetails"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_large"
                android:fontFamily="@font/gilroy_regular"
                android:paddingStart="@dimen/margin_large"
                android:paddingEnd="@dimen/margin_small"
                android:text="@string/truck_details"
                android:textColor="@color/text_black"
                android:textSize="@dimen/text_size_smedium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/clConsign" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clTruck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_medium"
                app:layout_constraintTop_toBottomOf="@id/tvTruckDetails">

                <TextView
                    android:id="@+id/tvTruckNo"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:background="@drawable/shape_nigeriacoco_rect_grey_border"
                    android:fontFamily="@font/gilroy_semibold"
                    android:gravity="center"
                    android:text="@string/truck_number"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/tvTruckNoValue"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/tvTruckNoValue"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/shape_nigeriacoco_rect_white_bg"
                    android:gravity="center"
                    android:imeOptions="actionNext"
                    android:padding="@dimen/margin_padding_size_medium"
                    android:textColor="@color/text_black"
                    android:textSize="16sp"
                    android:digits="aAbBcCdDeEfFgGhHiIjJkKlLmMnNoOpPqQrRsStTuUvVwWxXyY zZ0123456789"
                    android:inputType="textPersonName"
                    android:singleLine="true"
                    app:layout_constraintBottom_toBottomOf="@id/tvTruckNo"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/tvTruckNo"
                    app:layout_constraintTop_toTopOf="@id/tvTruckNo"
                    tools:text="Sample" />


                <TextView
                    android:id="@+id/tvDriverName"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:background="@drawable/shape_nigeriacoco_rect_grey_border"
                    android:fontFamily="@font/gilroy_semibold"
                    android:gravity="center"
                    android:text="@string/driver_name"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/tvDriverNameValue"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTruckNo" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/tvDriverNameValue"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/shape_nigeriacoco_rect_white_bg"
                    android:gravity="center"
                    android:padding="@dimen/margin_padding_size_medium"
                    android:textColor="@color/text_black"
                    android:textSize="16sp"
                    android:imeOptions="actionNext"
                    android:digits="aAbBcCdDeEfFgGhHiIjJkKlLmMnNoOpPqQrRsStTuUvVwWxXyY zZ0123456789"
                    android:inputType="textPersonName"
                    android:singleLine="true"
                    app:layout_constraintBottom_toBottomOf="@id/tvDriverName"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/tvDriverName"
                    app:layout_constraintTop_toTopOf="@id/tvDriverName"
                    tools:text="Sample" />

                <TextView
                    android:id="@+id/tvDriverNo"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:background="@drawable/shape_nigeriacoco_rect_grey_border"
                    android:fontFamily="@font/gilroy_semibold"
                    android:gravity="center"
                    android:text="@string/phone_number"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/tvDriverNoValue"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvDriverName" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/tvDriverNoValue"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/shape_nigeriacoco_rect_white_bg"
                    android:digits="1234567890"
                    android:gravity="center"
                    android:inputType="phone"
                    android:padding="@dimen/margin_padding_size_medium"
                    android:textColor="@color/text_black"
                    android:textSize="16sp"
                    android:maxLength="10"
                    android:imeOptions="actionDone"
                    app:layout_constraintBottom_toBottomOf="@id/tvDriverNo"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/tvDriverNo"
                    app:layout_constraintTop_toTopOf="@id/tvDriverNo"
                    tools:text="Sample" />

                <TextView
                    android:id="@+id/tvVendor"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/shape_nigeriacoco_rect_grey_border"
                    android:fontFamily="@font/gilroy_semibold"
                    android:gravity="center"
                    android:text="@string/transport_vendor"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/tvVendorValue"
                    app:layout_constraintEnd_toStartOf="@+id/tvVendorValue"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvVendorValue"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tvVendorValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_nigeriacoco_rect_white_bg"
                    android:drawableEnd="@drawable/ic_add_icon_new"
                    android:gravity="center"
                    android:minHeight="60dp"
                    android:padding="@dimen/margin_padding_size_medium"
                    android:textColor="@color/text_black"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/tvVendor"
                    app:layout_constraintTop_toBottomOf="@id/tvDriverNo"
                    android:visibility="gone"
                    tools:text="Sample dsmfbsdjfbjdsbjvh sd" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/llCamera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_medium"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/clTruck">

                <TextView
                    android:id="@+id/tvAddImages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:fontFamily="@font/gilroy_regular"
                    android:text="@string/add_images"
                    android:textColor="@color/text_black"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ivCamera"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_padding_size_small"
                    android:background="@color/blue"
                    android:src="@drawable/ic_photo_camera_black_24dp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/photoImageView"
                        android:layout_width="match_parent"
                        android:layout_height="300dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="@dimen/margin_medium"
                        android:paddingStart="@dimen/margin_xlarge"
                        android:paddingEnd="@dimen/margin_medium"
                        android:visibility="gone"
                        app:layout_constraintHorizontal_bias="0.513"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@android:color/darker_gray" />

                    <ImageView
                        android:id="@+id/closeDialog"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentRight="true"
                        android:layout_gravity="top|right"
                        android:adjustViewBounds="true"
                        android:background="@drawable/ic_coffee_cicle_close"
                        android:description="@null"
                        android:scaleType="fitStart"
                        android:visibility="gone" />
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/photoImageView1"
                        android:layout_width="match_parent"
                        android:layout_height="300dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="@dimen/margin_medium"
                        android:paddingStart="@dimen/margin_xlarge"
                        android:paddingEnd="@dimen/margin_medium"
                        android:visibility="gone"
                        app:layout_constraintHorizontal_bias="0.513"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@android:color/darker_gray" />

                    <ImageView
                        android:id="@+id/closeDialog1"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentRight="true"
                        android:layout_gravity="top|right"
                        android:adjustViewBounds="true"
                        android:background="@drawable/ic_coffee_cicle_close"
                        android:description="@null"
                        android:scaleType="fitStart"
                        android:visibility="gone" />
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/photoImageView2"
                        android:layout_width="match_parent"
                        android:layout_height="300dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="@dimen/margin_medium"
                        android:paddingStart="@dimen/margin_xlarge"
                        android:paddingEnd="@dimen/margin_medium"
                        android:visibility="gone"
                        app:layout_constraintHorizontal_bias="0.513"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@android:color/darker_gray" />

                    <ImageView
                        android:id="@+id/closeDialog2"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentRight="true"
                        android:layout_gravity="top|right"
                        android:adjustViewBounds="true"
                        android:background="@drawable/ic_coffee_cicle_close"
                        android:description="@null"
                        android:scaleType="fitStart"
                        android:visibility="gone" />
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/photoImageView3"
                        android:layout_width="match_parent"
                        android:layout_height="300dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="@dimen/margin_medium"
                        android:paddingStart="@dimen/margin_xlarge"
                        android:paddingEnd="@dimen/margin_medium"
                        android:visibility="gone"
                        app:layout_constraintHorizontal_bias="0.513"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@android:color/darker_gray" />

                    <ImageView
                        android:id="@+id/closeDialog3"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentRight="true"
                        android:layout_gravity="top|right"
                        android:adjustViewBounds="true"
                        android:background="@drawable/ic_coffee_cicle_close"
                        android:description="@null"
                        android:scaleType="fitStart"
                        android:visibility="gone" />
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/photoImageView4"
                        android:layout_width="match_parent"
                        android:layout_height="300dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="@dimen/margin_medium"
                        android:paddingStart="@dimen/margin_xlarge"
                        android:paddingEnd="@dimen/margin_medium"
                        android:visibility="gone"
                        app:layout_constraintHorizontal_bias="0.513"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@android:color/darker_gray" />

                    <ImageView
                        android:id="@+id/closeDialog4"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentRight="true"
                        android:layout_gravity="top|right"
                        android:adjustViewBounds="true"
                        android:background="@drawable/ic_coffee_cicle_close"
                        android:description="@null"
                        android:scaleType="fitStart"
                        android:visibility="gone" />
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/photoImageView5"
                        android:layout_width="match_parent"
                        android:layout_height="300dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="@dimen/margin_medium"
                        android:paddingStart="@dimen/margin_xlarge"
                        android:paddingEnd="@dimen/margin_medium"
                        android:visibility="gone"
                        app:layout_constraintHorizontal_bias="0.513"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@android:color/darker_gray" />

                    <ImageView
                        android:id="@+id/closeDialog5"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentRight="true"
                        android:layout_gravity="top|right"
                        android:adjustViewBounds="true"
                        android:background="@drawable/ic_coffee_cicle_close"
                        android:description="@null"
                        android:scaleType="fitStart"
                        android:visibility="gone" />
                </RelativeLayout>

            </LinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <Button
        android:id="@+id/btnProceed"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/colorPrimaryOfi"
        android:fontFamily="@font/gilroy_semibold"
        android:text="Start weighing"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_medium"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>